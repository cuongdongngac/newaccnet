<Window x:Class="NewaccNet.KeyGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEWACCNET - Công Cụ Sinh &amp; Luận Mã Bản Quyền (Theo Bản Ghi)" 
        Height="680" Width="640" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanMinimize" Background="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="20,16">
            <StackPanel>
                <TextBlock Text="NEWACCNET RECORD LICENSE GENERATOR" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Công cụ tạo &amp; luận giải mã đăng ký theo số lượng chứng từ JournalVoucher • 100% Khớp Google Sheet" FontSize="12" Foreground="#93C5FD" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16">

                <!-- 1. Nhập Mã máy -->
                <TextBlock Text="1. Mã máy tính của khách hàng (Machine Code):" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtTargetId" FontSize="14" FontWeight="Bold" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                             Foreground="#0F172A" Text="BFEBFBFF000906EA"/>
                    <Button Grid.Column="1" Content="Dán Clipboard" Height="34" Margin="10,0,0,0" Padding="14,0"
                            Background="#E2E8F0" FontWeight="SemiBold" Click="BtnPaste_Click"/>
                </Grid>

                <!-- 2. Chọn Gói số lượng bản ghi JournalVoucher -->
                <TextBlock Text="2. Gói hạn mức số bản ghi JournalVoucher:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,10">
                    <RadioButton x:Name="rad500" Content="500 bản ghi" Margin="0,0,14,8" VerticalAlignment="Center" Checked="RadLimit_Checked"/>
                    <RadioButton x:Name="rad1000" Content="1.000 bản ghi" IsChecked="True" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,14,8" VerticalAlignment="Center" Checked="RadLimit_Checked"/>
                    <RadioButton x:Name="rad2000" Content="2.000 bản ghi" Margin="0,0,14,8" VerticalAlignment="Center" Checked="RadLimit_Checked"/>
                    <RadioButton x:Name="rad5000" Content="5.000 bản ghi" Margin="0,0,14,8" VerticalAlignment="Center" Checked="RadLimit_Checked"/>
                    <RadioButton x:Name="rad10000" Content="10.000 bản ghi" Margin="0,0,14,8" VerticalAlignment="Center" Checked="RadLimit_Checked"/>
                    <RadioButton x:Name="radUnlimited" Content="Vô hạn (999.999)" FontWeight="Bold" Foreground="#047857" Margin="0,0,14,8" VerticalAlignment="Center" Checked="RadLimit_Checked"/>
                </WrapPanel>

                <!-- Ô nhập tùy biến số lượng -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Hoặc số lượng tùy chỉnh:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569"/>
                    <TextBox Grid.Column="1" x:Name="txtCustomLimit" Height="30" VerticalContentAlignment="Center" Padding="6,0" 
                             FontWeight="Bold" Text="1000" TextChanged="TxtCustomLimit_TextChanged"/>
                    <TextBlock Grid.Column="2" Text="chứng từ" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#64748B"/>
                </Grid>

                <!-- Nút Sinh mã -->
                <Button Content="⚡ BẤM ĐỂ TẠO MÃ ĐĂNG KÝ (16 KÝ TỰ)" Height="42" Background="#2563EB" Foreground="White" 
                        FontSize="14" FontWeight="Bold" Margin="0,0,0,14" Click="BtnGenerate_Click"/>

                <!-- 3. Kết quả Mã đăng ký -->
                <TextBlock Text="3. Mã đăng ký tạo ra (Gửi cho khách hàng kích hoạt):" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtResultCode" IsReadOnly="True" FontSize="18" FontWeight="Bold" Height="42" 
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="8,0" Background="#ECFDF5" Foreground="#065F46"/>
                    <Button Grid.Column="1" Content="📋 Sao Chép Mã" Height="42" Margin="10,0,0,0" Padding="16,0" 
                            Background="#059669" Foreground="White" FontWeight="Bold" Click="BtnCopy_Click"/>
                </Grid>

                <TextBlock x:Name="txtSummary" Text="Nhấn nút trên để sinh mã đăng ký." FontSize="11.5" Foreground="#64748B" FontStyle="Italic" Margin="0,0,0,20"/>

                <!-- 4. KHUNG ĐỐI CHIẾU & LUẬN NGƯỢC (KIỂM TRA CHÉO) -->
                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🔍 KIỂM TRA ĐỐI CHIẾU NGƯỢC (SO SÁNH VỚI GOOGLE SHEET):" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                        <TextBlock Text="Dán mã đăng ký bất kỳ vào đây để kiểm tra số bản ghi mà phần mềm sẽ luận ra:" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtVerifyCode" Height="34" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="Luận Số Bản Ghi" Height="34" Margin="10,0,0,0" Padding="12,0" 
                                    Background="#475569" Foreground="White" FontWeight="SemiBold" Click="BtnVerify_Click"/>
                        </Grid>
                        <TextBlock x:Name="txtVerifyResult" Text="Chưa kiểm tra." FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <TextBlock Text="Bản quyền Tác giả Phạm Việt Cường • Thuật toán Tokenization &amp; MD5 Salt đồng bộ Google Sheet" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
