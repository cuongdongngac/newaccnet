<dx:ThemedWindow
    x:Class="NewaccNet.Plugin.DbMigrator.Views.DbMigratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:vm="clr-namespace:NewaccNet.Plugin.DbMigrator.ViewModels"
    Title="Chuyển đổi &amp; Nhân bản Cơ sở dữ liệu (MSSQL Migrator)"
    Height="720" Width="960"
    WindowStartupLocation="CenterOwner"
    ShowIcon="True">

    <dx:ThemedWindow.DataContext>
        <vm:DbMigratorViewModel />
    </dx:ThemedWindow.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. CSDL Nguồn Hiện Tại -->
        <GroupBox Grid.Row="0" Header="1. Cơ sở dữ liệu Nguồn (Đang kết nối)" Margin="0,0,0,8">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CSDL hiện hành:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                <dxe:TextEdit Grid.Column="1" Text="{Binding SourceDatabaseInfo, Mode=OneWay}" IsReadOnly="True" FontWeight="Bold" />
            </Grid>
        </GroupBox>

        <!-- 2. Cấu hình CSDL Đích (SQL Server) -->
        <GroupBox Grid.Row="1" Header="2. Cấu hình CSDL Đích (MS SQL Server)" Margin="0,0,0,8">
            <dxlc:LayoutControl Orientation="Vertical" Padding="8,4">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutItem Label="Máy chủ (Server):" Width="380">
                        <dxe:TextEdit Text="{Binding TargetServer, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Tên CSDL Đích:" Width="380">
                        <dxe:TextEdit Text="{Binding TargetDatabase, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FontWeight="Bold" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,4,0,0">
                    <dxlc:LayoutItem Label="Xác thực:">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Windows Authentication" IsChecked="{Binding IsWindowsAuth}" VerticalAlignment="Center" Margin="0,0,16,0" IsEnabled="{Binding IsNotBusy}" />
                            <RadioButton Content="SQL Server Authentication" IsChecked="{Binding IsSqlAuth}" VerticalAlignment="Center" IsEnabled="{Binding IsNotBusy}" />
                        </StackPanel>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Width="150" HorizontalAlignment="Right">
                        <dx:SimpleButton Content="Kiểm tra kết nối" Command="{Binding TestConnectionCommand}" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_check.svg'}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <dxlc:LayoutGroup Orientation="Horizontal" IsEnabled="{Binding IsSqlAuth}" Margin="0,4,0,0">
                    <dxlc:LayoutItem Label="Tài khoản (User):" Width="380">
                        <dxe:TextEdit Text="{Binding TargetUser, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Mật khẩu (Password):" Width="380">
                        <dxe:PasswordBoxEdit EditValue="{Binding TargetPassword, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,4,0,0">
                    <dxlc:LayoutItem Label="Tệp DDL Schema (.sql):">
                        <dxe:ButtonEdit Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" AllowDefaultButton="False">
                            <dxe:ButtonInfo GlyphKind="Regular" Command="{Binding BrowseScriptCommand}" ToolTip="Chọn tệp script SQL cấu trúc" />
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Width="220" HorizontalAlignment="Right">
                        <dx:SimpleButton Content="1. Tạo Database từ SQL" Command="{Binding CreateDatabaseCommand}" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_database.svg'}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutControl>
        </GroupBox>

        <!-- 3. Cấu hình Sao chép Dữ liệu -->
        <GroupBox Grid.Row="2" Header="3. Tùy chọn Sao chép Dữ liệu (Replication)" Margin="0,0,0,8">
            <dxlc:LayoutControl Orientation="Vertical" Padding="8,4">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutItem Label="Tệp thứ tự (CSV):">
                        <dxe:ButtonEdit Text="{Binding ReplicationCsvPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" AllowDefaultButton="False">
                            <dxe:ButtonInfo GlyphKind="Regular" Command="{Binding BrowseCsvCommand}" ToolTip="Chọn tệp thứ tự replication_order.csv" />
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Margin="16,0,0,0">
                        <dxe:CheckEdit Content="Bao gồm Chứng từ &amp; Dòng chi tiết (Vouchers &amp; Lines)" IsChecked="{Binding IncludeVouchers}" IsEnabled="{Binding IsNotBusy}" VerticalAlignment="Center" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,8,0,0">
                    <dx:SimpleButton Content="2. Chỉ sao chép dữ liệu" Command="{Binding ReplicateDataCommand}" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_arrow4right.svg'}" Height="32" Width="200" Margin="0,0,8,0" />
                    <dx:SimpleButton Content="🚀 Tạo CSDL &amp; Chuyển dữ liệu trọn gói (1 + 2)" Command="{Binding CreateAndReplicateAllCommand}" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/dashboards/grid.svg'}" Height="32" Width="320" FontWeight="Bold" Margin="0,0,8,0" />
                    <dx:SimpleButton Content="Dừng lại" Command="{Binding CancelCommand}" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_close.svg'}" Height="32" Width="100" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutControl>
        </GroupBox>

        <!-- 4. Khung Nhật Ký Thực Hiện (Log) -->
        <GroupBox Grid.Row="3" Header="Nhật ký tiến trình" Margin="0,0,0,8">
            <dxe:TextEdit Text="{Binding LogText, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" />
        </GroupBox>

        <!-- 5. Trạng thái & Tiến trình -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
            <dxe:ProgressBarEdit Grid.Column="1" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" DisplayFormatString="{}{0:N0}%" ContentDisplayMode="Value" Height="20" />
        </Grid>
    </Grid>
</dx:ThemedWindow>
