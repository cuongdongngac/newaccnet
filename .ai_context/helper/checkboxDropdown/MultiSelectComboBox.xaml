<UserControl x:Class="MyApp.Controls.MultiSelectComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" MinWidth="150" Height="28">
    <Grid>
        <!-- Ô hiển thị -->
        <ToggleButton x:Name="PART_Toggle"
                      HorizontalContentAlignment="Stretch"
                      Background="White" BorderBrush="#ABADB3"
                      IsChecked="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PART_Text" Margin="4,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Path Grid.Column="1" Margin="6,0" VerticalAlignment="Center"
                      Data="M0,0 L4,4 L8,0 Z" Fill="#555"/>
            </Grid>
        </ToggleButton>

        <!-- Dropdown -->
        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding ElementName=PART_Toggle}" Placement="Bottom"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Opened="Popup_Opened" Closed="Popup_Closed">
            <Border Background="White" BorderBrush="#ABADB3" BorderThickness="1" Padding="4"
                    MinWidth="{Binding ActualWidth, ElementName=Root}">
                <DockPanel>
                    <!-- Ô tìm kiếm + placeholder -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBox x:Name="PART_Search" Padding="2,3"
                                 TextChanged="Search_TextChanged"
                                 PreviewKeyDown="Search_PreviewKeyDown"/>
                        <TextBlock Text="Tìm theo mã hoặc tên..." Foreground="#999"
                                   Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PART_Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Chọn tất cả (áp dụng cho các mục đang hiển thị sau khi lọc) -->
                    <CheckBox x:Name="PART_SelectAll" DockPanel.Dock="Top" Margin="4,0,0,4"
                              Content="Chọn tất cả" Click="SelectAll_Click"/>

                    <ListBox x:Name="PART_List" BorderThickness="0"
                             MaxHeight="{Binding MaxDropDownHeight, ElementName=Root}"
                             VirtualizingPanel.IsVirtualizing="True"
                             PreviewKeyDown="List_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Content="{Binding Display}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
