<dx:ThemedWindow x:Class="NewaccNet.Plugin.ErpWarehouse.Views.PurchaseReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="Phiếu nhập kho mua hàng (NM)" Height="700" Width="1150" MinWidth="1000" MinHeight="550" 
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Detail Grid -->
            <RowDefinition Height="Auto"/> <!-- Footer Định khoản & Tổng tiền -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- TOOLBAR DEVEXPRESS CHUẨN: NAVIGATION & LƯU & THÊM MỚI -->
        <dxb:BarContainerControl Grid.Row="0">
            <dxb:ToolBarControl ShowDragWidget="False" AllowCustomizationMenu="False" AllowHide="False" AllowQuickCustomization="False" GlyphSize="Small">
                <!-- Điều hướng phiếu -->
                <dxb:BarButtonItem Name="btnFirst" ToolTip="Phiếu đầu tiên (Home)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/doublefirst.svg'}" ItemClick="BtnFirst_Click"/>
                <dxb:BarButtonItem Name="btnPrev" ToolTip="Phiếu trước (PageUp)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/prev.svg'}" ItemClick="BtnPrev_Click"/>
                <dxb:BarStaticItem Name="lblNavPosition" Content="Phiếu mới (chưa lưu)" ShowBorder="True"/>
                <dxb:BarButtonItem Name="btnNext" ToolTip="Phiếu tiếp theo (PageDown)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/next.svg'}" ItemClick="BtnNext_Click"/>
                <dxb:BarButtonItem Name="btnLast" ToolTip="Phiếu cuối cùng (End)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/doublelast.svg'}" ItemClick="BtnLast_Click"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Name="btnNew" Content="Thêm mới (Ctrl+N)" ToolTip="Tạo phiếu mới trống" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_new.svg'}" ItemClick="BtnNew_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarButtonItem Name="btnAccept" Content="Lưu (Ctrl+S)" ToolTip="Lưu phiếu hiện tại" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save.svg'}" ItemClick="BtnAccept_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarButtonItem Name="btnSaveAndNew" Content="Lưu &amp; Thêm mới (Ctrl+Shift+S)" ToolTip="Lưu phiếu hiện tại và tạo phiếu mới ngay" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save_new.svg'}" ItemClick="BtnSaveAndNew_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Name="btnAddRow" Content="Thêm dòng (Insert)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_add.svg'}" ItemClick="BtnAddRow_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarButtonItem Name="btnDeleteRow" Content="Xóa dòng (Delete)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_delete.svg'}" ItemClick="BtnDeleteRow_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Name="btnPrint" Content="In phiếu (Ctrl+P)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/print/print.svg'}" ItemClick="BtnPrint_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Name="btnCancel" Content="Đóng (Esc)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_close.svg'}" ItemClick="BtnCancel_Click" BarItemDisplayMode="ContentAndGlyph"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <!-- HEADER NHẬP MUA (FIX CỨNG) -->
        <dxlc:LayoutControl Grid.Row="1" Orientation="Horizontal" Padding="10">
            <!-- Cột 1: Thông tin phiếu & Kho -->
            <dxlc:LayoutGroup Orientation="Vertical" Width="300">
                <dxlc:LayoutItem Label="Số chứng từ:">
                    <dxe:TextEdit x:Name="txtVoucherNo" FontWeight="SemiBold"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Ngày chứng từ:">
                    <dxe:DateEdit x:Name="dpVoucherDate"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Kho nhập:">
                    <dxg:LookUpEdit x:Name="lueWarehouse" 
                                    DisplayMember="WarehouseName" ValueMember="WarehouseId" 
                                    AutoPopulateColumns="False" AutoComplete="True" ImmediatePopup="True" IsTextEditable="True"
                                    PopupWidth="360">
                        <dxg:LookUpEdit.Buttons>
                            <dxe:ButtonInfo GlyphKind="Plus" ToolTip="Tạo mới kho hàng" Click="BtnAddWarehouse_Click"/>
                        </dxg:LookUpEdit.Buttons>
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <dxg:GridControl Name="PART_GridControl">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="WarehouseId" Header="Mã Kho" Width="100"/>
                                        <dxg:GridColumn FieldName="WarehouseName" Header="Tên Kho" Width="220"/>
                                    </dxg:GridControl.Columns>
                                </dxg:GridControl>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Người giao hàng:">
                    <dxe:TextEdit x:Name="txtCarrier"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Diễn giải:">
                    <dxe:TextEdit x:Name="txtDescription"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <!-- Cột 2 & 3: Thông tin Hóa đơn & Nhà Cung Cấp -->
            <dxlc:LayoutGroup Orientation="Horizontal" Margin="20,0,0,0">
                <!-- Cột Hóa đơn -->
                <dxlc:LayoutGroup Orientation="Vertical" Width="230">
                    <dxlc:LayoutItem Label="Số hóa đơn:">
                        <dxe:TextEdit x:Name="txtVatBillNo"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Ký hiệu (Seri):">
                        <dxe:TextEdit x:Name="txtSerialNo"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Ngày hóa đơn:">
                        <dxe:DateEdit x:Name="dpVatBillDate"/>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <!-- Cột Nhà cung cấp -->
                <dxlc:LayoutGroup Orientation="Vertical" Margin="15,0,0,0">
                    <dxlc:LayoutItem Label="Nhà cung cấp:">
                        <dxg:LookUpEdit x:Name="luePartner" 
                                        DisplayMember="CustomerName" ValueMember="Id" 
                                        AutoPopulateColumns="False" AutoComplete="True" ImmediatePopup="True" IsTextEditable="True"
                                        PopupWidth="450" EditValueChanged="LuePartner_EditValueChanged">
                            <dxg:LookUpEdit.Buttons>
                                <dxe:ButtonInfo GlyphKind="Plus" ToolTip="Tạo mới đối tác" Click="BtnAddPartner_Click"/>
                            </dxg:LookUpEdit.Buttons>
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <dxg:GridControl Name="PART_GridControl">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="Id" Header="Mã NCC" Width="110"/>
                                            <dxg:GridColumn FieldName="CustomerName" Header="Tên Nhà Cung Cấp" Width="250"/>
                                            <dxg:GridColumn FieldName="Taxno" Header="MST" Width="100"/>
                                        </dxg:GridControl.Columns>
                                    </dxg:GridControl>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Tên NCC:">
                        <dxe:TextEdit x:Name="txtPartnerName"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxlc:LayoutItem Label="Địa chỉ:">
                            <dxe:TextEdit x:Name="txtAddress"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Mã số thuế:" Width="180" Margin="10,0,0,0">
                            <dxe:TextEdit x:Name="txtTaxCode"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

        <!-- DETAILS GRID NHẬP MUA -->
        <dxg:GridControl x:Name="gridDetails" Grid.Row="2" Margin="10,0" AutoGenerateColumns="None">
            <dxg:GridControl.View>
                <dxg:TableView x:Name="viewDetails" ShowGroupPanel="False" NewItemRowPosition="Bottom" 
                               EditorButtonShowMode="ShowForFocusedRow"
                               CellValueChanged="ViewDetails_CellValueChanged"/>
            </dxg:GridControl.View>
            <dxg:GridControl.Bands>
                <dxg:GridControlBand Header="Thông tin chung" HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn FieldName="MaterialId" Header="Vật tư, hàng hóa" Width="*" MinWidth="220">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxg:LookUpEdit Name="PART_Editor"
                                                ItemsSource="{Binding Path=Materials, RelativeSource={RelativeSource AncestorType=Window}}"
                                                DisplayMember="MaterialName" ValueMember="MaterialId"
                                                AutoPopulateColumns="False" PopupWidth="480"
                                                AutoComplete="True" ImmediatePopup="True" IsTextEditable="True">
                                    <dxg:LookUpEdit.Buttons>
                                        <dxe:ButtonInfo GlyphKind="Plus" ToolTip="Tạo mới vật tư" Click="BtnAddMaterial_Click"/>
                                    </dxg:LookUpEdit.Buttons>
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="MaterialName" Header="Tên vật tư" Width="260"/>
                                                    <dxg:GridColumn FieldName="MaterialId" Header="Mã VT" Width="100"/>
                                                    <dxg:GridColumn FieldName="Unit" Header="ĐVT" Width="60"/>
                                                </dxg:GridControl.Columns>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Unit" Header="ĐVT" Width="65" ReadOnly="True" AllowEditing="False" HorizontalHeaderContentAlignment="Center"/>
                    <dxg:GridColumn FieldName="Quantity" Header="Số lượng" Width="85" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControlBand>
                <dxg:GridControlBand Header="Đơn giá mua &amp; Thuế GTGT" HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn FieldName="Price" Header="Đơn giá mua" Width="100" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Amount" Header="Tiền hàng" Width="120" ReadOnly="True" AllowEditing="False" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Taxrateid" Header="% Thuế" Width="80" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings x:Name="cboTaxRates" DisplayMember="Display" ValueMember="Taxrateid" IsTextEditable="False" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="TaxAmount" Header="Tiền thuế GTGT" Width="110" ReadOnly="True" AllowEditing="False" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Note" Header="Ghi chú" Width="150"/>
                </dxg:GridControlBand>
            </dxg:GridControl.Bands>
        </dxg:GridControl>

        <!-- FOOTER ĐỊNH KHOẢN & TỔNG TIỀN (FIX CỨNG 3 CỘT: TIỀN HÀNG -> THUẾ GTGT -> TỔNG THANH TOÁN) -->
        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15,8,15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                </Grid.ColumnDefinitions>

                <!-- Cột 1: Tiền hàng (Nợ TK Kho) -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Tiền hàng (Nợ TK Kho)" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                    <dxg:LookUpEdit x:Name="lueInventoryAccount" DisplayMember="Display" ValueMember="AccountId" 
                                    AutoComplete="True" ImmediatePopup="True" IsTextEditable="True"/>
                    <dxe:TextEdit x:Name="txtTotalCost" EditValue="0" IsReadOnly="True" ShowBorder="False" Focusable="False"
                                  MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                                  FontWeight="Bold" FontSize="15" Foreground="#2E7D32" HorizontalContentAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Cột 2: Thuế GTGT (Nợ TK Thuế) -->
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <TextBlock Text="Thuế GTGT (Nợ TK Thuế)" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                    <dxg:LookUpEdit x:Name="lueTaxAccount" DisplayMember="Display" ValueMember="AccountId" 
                                    AutoComplete="True" ImmediatePopup="True" IsTextEditable="True"/>
                    <dxe:TextEdit x:Name="txtTotalTax" EditValue="0" IsReadOnly="True" ShowBorder="False" Focusable="False"
                                  MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                                  FontWeight="Bold" FontSize="15" Foreground="#E65100" HorizontalContentAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Cột 3: Tổng thanh toán (Có TK Phải trả/Tiền) -->
                <StackPanel Grid.Column="4" Orientation="Vertical">
                    <TextBlock Text="Tổng thanh toán (Có TK Phải trả/Tiền)" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                    <dxg:LookUpEdit x:Name="lueTotalAccount" DisplayMember="Display" ValueMember="AccountId" 
                                    AutoComplete="True" ImmediatePopup="True" IsTextEditable="True"/>
                    <dxe:TextEdit x:Name="txtTotalAll" EditValue="0" IsReadOnly="True" ShowBorder="False" Focusable="False"
                                  MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                                  FontWeight="Bold" FontSize="16" Foreground="#C2185B" HorizontalContentAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Lưu &amp; Thêm mới" Width="130" Height="30" Margin="0,0,10,0" Click="BtnSaveAndNew_Click"/>
            <Button Content="Lưu phiếu" Width="100" Height="30" Margin="0,0,10,0" Click="BtnAccept_Click"/>
            <Button Content="Đóng" Width="90" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</dx:ThemedWindow>
