<dx:ThemedWindow 
    x:Class="NewaccNet.Plugin.ErpWarehouse.Views.MigrationProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="Chuyển Đổi Đồ Thị Kho (EntryGraph)" 
    Height="260" Width="520" 
    WindowStartupLocation="CenterOwner" 
    ResizeMode="NoResize" 
    ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <dx:DXImage Source="pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/business_diagram.svg" 
                        Width="36" Height="36" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="lblTitle" Text="Đang chuyển đổi cấu trúc đồ thị kho..." FontWeight="Bold" FontSize="15" Foreground="#FF1E293B"/>
                <TextBlock x:Name="lblSubTitle" Text="Quét và liên kết tự động các dòng hạch toán phiếu kho cũ" FontSize="12" Foreground="#FF64748B"/>
            </StackPanel>
        </StackPanel>

        <!-- Message -->
        <TextBlock x:Name="lblMessage" Grid.Row="1" Text="Đang chuẩn bị dữ liệu và quét CSDL..." 
                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" Foreground="#FF334155"/>

        <!-- Progress Bar -->
        <ProgressBar x:Name="progressBar" Grid.Row="2" Height="18" Minimum="0" Maximum="100" Value="0" 
                     Foreground="#FF0284C7" Background="#FFE2E8F0" Margin="0,0,0,8"/>

        <!-- Detail Stats -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <TextBlock x:Name="lblStats" Text="Tiến độ: 0% (0 / 0 phiếu)" FontSize="12" FontWeight="SemiBold" Foreground="#FF0284C7" HorizontalAlignment="Left"/>
            <TextBlock x:Name="lblResultStats" Text="Thành công: 0 | Lỗi: 0" FontSize="12" Foreground="#FF64748B" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Hủy bỏ" Width="95" Height="30" Click="BtnCancel_Click"/>
            <Button x:Name="btnClose" Content="Đóng" Width="95" Height="30" Visibility="Collapsed" IsDefault="True" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</dx:ThemedWindow>
