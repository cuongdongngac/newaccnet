<dx:ThemedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                  xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                  xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                  x:Class="NewaccNet.Plugin.ErpWarehouse.Views.ErpAccountConfigWindow"
                  Title="Cấu hình tài khoản &amp; Định khoản chứng từ kho - NEWACCNET"
                  Height="750" Width="1200"
                  WindowStartupLocation="CenterOwner"
                  ShowInTaskbar="False">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF1565C0" Padding="20,12">
            <StackPanel>
                <TextBlock Text="CẤU HÌNH DANH MỤC TÀI KHOẢN THEO TỪNG MỤC ĐỊNH KHOẢN (SLOT-BASED)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Giới hạn danh sách tài khoản được phép chọn cho từng vị trí định khoản, định nghĩa lại tên gọi hiển thị và đặt tài khoản ngầm định" FontSize="12" Foreground="#E3F2FD" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Tabs -->
        <dx:DXTabControl Grid.Row="1" x:Name="tabControl" Margin="12,10" SelectionChanged="TabControl_SelectionChanged">
            <!-- Tab 1: Nhập mua (NM) -->
            <dx:DXTabItem Header="1. Phiếu Nhập Mua (NM)">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Danh sách các mục định khoản -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#F1F5F9" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <TextBlock Text="CÁC MỤC ĐỊNH KHOẢN" FontWeight="Bold" Foreground="#334155" FontSize="11"/>
                            </Border>
                            <dxe:ListBoxEdit x:Name="lstSlotsNm" ShowBorder="False" DisplayMember="Name" ValueMember="Key" EditValueChanged="LstSlotsNm_EditValueChanged"/>
                        </DockPanel>
                    </Border>

                    <!-- Lưới tài khoản của mục đang chọn -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar của mục -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock x:Name="lblSlotTitleNm" Text="Danh sách tài khoản được phép" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <dx:SimpleButton Content="+ Thêm tài khoản" Height="26" Padding="10,0" Margin="0,0,6,0" Click="BtnAddSlotAccount_Click"/>
                                        <dx:SimpleButton Content="- Xóa dòng" Height="26" Padding="10,0" Click="BtnDeleteSlotAccount_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Lưới tài khoản -->
                            <dxg:GridControl Grid.Row="1" x:Name="gridNmAccounts" AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="viewNmAccounts" ShowGroupPanel="False" AllowEditing="True" NavigationStyle="Cell"
                                                   AutoWidth="True" ShowSearchPanelMode="Always" RowMinHeight="28"
                                                   CellValueChanged="ViewAccounts_CellValueChanged"/>
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="AccountId" Header="Số tài khoản" Width="120" MinWidth="100"/>
                                    <dxg:GridColumn FieldName="AccountName" Header="Tên tài khoản ERP (Chỉnh sửa tùy ý)" Width="*" MinWidth="350"/>
                                    <dxg:GridColumn FieldName="CategoryId" Header="Loại TK" Width="75" FixedWidth="True" ReadOnly="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="AllowDetail" Header="Bật chi tiết" Width="85" FixedWidth="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="IsDefault" Header="Mặc định" Width="80" FixedWidth="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                        </Grid>
                    </Border>
                </Grid>
            </dx:DXTabItem>

            <!-- Tab 2: Xuất bán (XB) -->
            <dx:DXTabItem Header="2. Phiếu Xuất Bán (XB)">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#F1F5F9" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <TextBlock Text="CÁC MỤC ĐỊNH KHOẢN" FontWeight="Bold" Foreground="#334155" FontSize="11"/>
                            </Border>
                            <dxe:ListBoxEdit x:Name="lstSlotsXb" ShowBorder="False" DisplayMember="Name" ValueMember="Key" EditValueChanged="LstSlotsXb_EditValueChanged"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock x:Name="lblSlotTitleXb" Text="Danh sách tài khoản được phép" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <dx:SimpleButton Content="+ Thêm tài khoản" Height="26" Padding="10,0" Margin="0,0,6,0" Click="BtnAddSlotAccount_Click"/>
                                        <dx:SimpleButton Content="- Xóa dòng" Height="26" Padding="10,0" Click="BtnDeleteSlotAccount_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <dxg:GridControl Grid.Row="1" x:Name="gridXbAccounts" AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="viewXbAccounts" ShowGroupPanel="False" AllowEditing="True" NavigationStyle="Cell"
                                                   AutoWidth="True" ShowSearchPanelMode="Always" RowMinHeight="28"
                                                   CellValueChanged="ViewAccounts_CellValueChanged"/>
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="AccountId" Header="Số tài khoản" Width="120" MinWidth="100"/>
                                    <dxg:GridColumn FieldName="AccountName" Header="Tên tài khoản ERP (Chỉnh sửa tùy ý)" Width="*" MinWidth="350"/>
                                    <dxg:GridColumn FieldName="CategoryId" Header="Loại TK" Width="75" FixedWidth="True" ReadOnly="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="AllowDetail" Header="Bật chi tiết" Width="85" FixedWidth="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="IsDefault" Header="Mặc định" Width="80" FixedWidth="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                        </Grid>
                    </Border>
                </Grid>
            </dx:DXTabItem>

            <!-- Tab 3: Nhập nội bộ (NNB) -->
            <dx:DXTabItem Header="3. Phiếu Nhập Nội Bộ (NNB)">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#F1F5F9" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <TextBlock Text="CÁC MỤC ĐỊNH KHOẢN" FontWeight="Bold" Foreground="#334155" FontSize="11"/>
                            </Border>
                            <dxe:ListBoxEdit x:Name="lstSlotsNnb" ShowBorder="False" DisplayMember="Name" ValueMember="Key" EditValueChanged="LstSlotsNnb_EditValueChanged"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock x:Name="lblSlotTitleNnb" Text="Danh sách tài khoản được phép" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <dx:SimpleButton Content="+ Thêm tài khoản" Height="26" Padding="10,0" Margin="0,0,6,0" Click="BtnAddSlotAccount_Click"/>
                                        <dx:SimpleButton Content="- Xóa dòng" Height="26" Padding="10,0" Click="BtnDeleteSlotAccount_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <dxg:GridControl Grid.Row="1" x:Name="gridNnbAccounts" AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="viewNnbAccounts" ShowGroupPanel="False" AllowEditing="True" NavigationStyle="Cell"
                                                   AutoWidth="True" ShowSearchPanelMode="Always" RowMinHeight="28"
                                                   CellValueChanged="ViewAccounts_CellValueChanged"/>
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="AccountId" Header="Số tài khoản" Width="120" MinWidth="100"/>
                                    <dxg:GridColumn FieldName="AccountName" Header="Tên tài khoản ERP (Chỉnh sửa tùy ý)" Width="*" MinWidth="350"/>
                                    <dxg:GridColumn FieldName="CategoryId" Header="Loại TK" Width="75" FixedWidth="True" ReadOnly="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="AllowDetail" Header="Bật chi tiết" Width="85" FixedWidth="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="IsDefault" Header="Mặc định" Width="80" FixedWidth="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                        </Grid>
                    </Border>
                </Grid>
            </dx:DXTabItem>

            <!-- Tab 4: Xuất nội bộ (XNB) -->
            <dx:DXTabItem Header="4. Phiếu Xuất Nội Bộ (XNB)">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#F1F5F9" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <TextBlock Text="CÁC MỤC ĐỊNH KHOẢN" FontWeight="Bold" Foreground="#334155" FontSize="11"/>
                            </Border>
                            <dxe:ListBoxEdit x:Name="lstSlotsXnb" ShowBorder="False" DisplayMember="Name" ValueMember="Key" EditValueChanged="LstSlotsXnb_EditValueChanged"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock x:Name="lblSlotTitleXnb" Text="Danh sách tài khoản được phép" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <dx:SimpleButton Content="+ Thêm tài khoản" Height="26" Padding="10,0" Margin="0,0,6,0" Click="BtnAddSlotAccount_Click"/>
                                        <dx:SimpleButton Content="- Xóa dòng" Height="26" Padding="10,0" Click="BtnDeleteSlotAccount_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <dxg:GridControl Grid.Row="1" x:Name="gridXnbAccounts" AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="viewXnbAccounts" ShowGroupPanel="False" AllowEditing="True" NavigationStyle="Cell"
                                                   AutoWidth="True" ShowSearchPanelMode="Always" RowMinHeight="28"
                                                   CellValueChanged="ViewAccounts_CellValueChanged"/>
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="AccountId" Header="Số tài khoản" Width="120" MinWidth="100"/>
                                    <dxg:GridColumn FieldName="AccountName" Header="Tên tài khoản ERP (Chỉnh sửa tùy ý)" Width="*" MinWidth="350"/>
                                    <dxg:GridColumn FieldName="CategoryId" Header="Loại TK" Width="75" FixedWidth="True" ReadOnly="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="AllowDetail" Header="Bật chi tiết" Width="85" FixedWidth="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="IsDefault" Header="Mặc định" Width="80" FixedWidth="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings HorizontalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                        </Grid>
                    </Border>
                </Grid>
            </dx:DXTabItem>
        </dx:DXTabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock VerticalAlignment="Center" Foreground="#475569" FontSize="12">
                        <Run Text="💡 " FontSize="14"/>
                        <Run Text="Các tài khoản trong danh sách sẽ hiển thị trong ComboBox tương ứng trên form phiếu. Cột 'Mặc định' sẽ tự động chọn sẵn."/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <dx:SimpleButton Content="Xuất JSON..." Height="30" Margin="0,0,8,0" Padding="12,0" ToolTip="Xuất toàn bộ cấu hình định khoản ERP ra file JSON để lưu trữ hoặc dùng cho CSDL khác" Click="BtnExportJson_Click"/>
                    <dx:SimpleButton Content="Nạp JSON..." Height="30" Margin="0,0,14,0" Padding="12,0" ToolTip="Nạp cấu hình từ file JSON và cập nhật lên các lưới định khoản" Click="BtnImportJson_Click"/>
                    <dx:SimpleButton Content="Khôi phục mặc định" Height="30" Margin="0,0,10,0" Padding="12,0" Click="BtnResetAllDefault_Click"/>
                    <dx:SimpleButton Content="Lưu cấu hình" Height="30" Width="120" Margin="0,0,8,0" Background="#FF1976D2" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
                    <dx:SimpleButton Content="Đóng" Height="30" Width="85" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>
