<base:BaseWindow 
    x:Class="NewaccNet.Wpf.AppSystem.AI.OfficeStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxsps="http://schemas.devexpress.com/winfx/2008/xaml/spreadsheet"
    xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Bàn Làm Việc Văn Phòng Kế Toán &amp; AI (Office Studio &amp; Copilot)"
    Width="1400" Height="880"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Office Studio Action Bar -->
        <Border Grid.Row="0" Background="#FFF3F4F6" BorderBrush="#FFD1D5DB" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🏢 OFFICE STUDIO &amp; AI" FontWeight="Bold" FontSize="14" Foreground="#FF1E3A8A" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <dx:SimpleButton x:Name="btnNewExcel" Content="Tạo mới" Height="28" Margin="0,0,6,0"
                                     Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/actions/new.svg'}"
                                     Click="BtnNewExcel_Click"/>
                    <dx:SimpleButton x:Name="btnOpenOfficeFile" Content="Mở tệp..." Height="28" Margin="0,0,6,0"
                                     Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/actions/open.svg'}"
                                     Click="BtnOpenOfficeFile_Click"/>
                    <dx:SimpleButton x:Name="btnSaveOfficeFile" Content="Lưu tệp..." Height="28" Margin="0,0,15,0"
                                     Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/diagramicons/save.svg'}"
                                     Click="BtnSaveOfficeFile_Click"/>

                    <Separator Margin="0,0,15,0"/>

                    <dx:SimpleButton x:Name="btnPushToInventoryItem" Content="📦 Bắn vào Danh mục Vật tư" Height="28" Margin="0,0,6,0"
                                     FontWeight="SemiBold"
                                     Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_product.svg'}"
                                     ToolTip="Đọc các cột (Mã, Tên, ĐVT, Nhóm) từ bảng tính hiện tại và lưu vào CSDL Danh mục Vật tư"
                                     Click="BtnPushToInventoryItem_Click"/>

                    <dx:SimpleButton x:Name="btnPushToPartner" Content="👥 Bắn vào Danh mục Đối tác" Height="28" Margin="0,0,6,0"
                                     FontWeight="SemiBold"
                                     Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_customer.svg'}"
                                     ToolTip="Đọc các cột (Mã đối tác, Tên đối tác, MST, Địa chỉ) từ bảng tính hiện tại và lưu vào CSDL Danh mục Đối tác"
                                     Click="BtnPushToPartner_Click"/>

                    <dx:SimpleButton x:Name="btnPushToDbInvoice" Content="💾 Lưu vào CSDL Hóa đơn" Height="28" Margin="0,0,6,0"
                                     FontWeight="Bold" Foreground="#FF15803D"
                                     Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/diagramicons/save.svg'}"
                                     Click="BtnPushToDbInvoice_Click"/>

                    <dx:SimpleButton x:Name="btnPushToVoucher" Content="📥 Nhập vào Phiếu Kế toán" Height="28" Margin="0,0,6,0"
                                     Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_invoice.svg'}"
                                     Click="BtnPushToVoucher_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <dx:SimpleButton x:Name="btnToggleChat" Content="Ẩn / Hiện Chatbot AI" Height="28" Margin="0,0,6,0"
                                     Click="BtnToggleChat_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dual-Pane Workspace (Left: AI Chatbot, Right: Office Studio) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colChatPane" Width="380" MinWidth="260" MaxWidth="600"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: AI CHATBOT COPILOT -->
            <Border Grid.Column="0" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="0,0,1,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Header -->
                    <Border Grid.Row="0" Background="#FFF8FAFC" Padding="8,6" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="🤖 Trợ lý Kế toán &amp; Báo cáo AI" FontWeight="Bold" FontSize="12.5" Foreground="#FF0F172A"/>
                                <TextBlock Text="Tự động sinh Excel / Word tùy câu hỏi" FontSize="10.5" Foreground="#FF64748B"/>
                            </StackPanel>
                            <dx:SimpleButton Grid.Column="1" Content="Xóa đoạn chat" Height="24" FontSize="11" Click="BtnClearChat_Click"/>
                        </Grid>
                    </Border>

                    <!-- Chat Message List -->
                    <ListBox Grid.Row="1" x:Name="lstChatMessages" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0,3"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="4,2"
                                        HorizontalAlignment="{Binding Alignment}" MaxWidth="320" BorderBrush="#FFE2E8F0" BorderThickness="1">
                                    <StackPanel Orientation="Vertical">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding SenderName}" FontWeight="Bold" FontSize="11" Foreground="#FF334155"/>
                                            <TextBlock Text="{Binding TimeText}" FontSize="9.5" Foreground="#FF94A3B8" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#FF0F172A" LineHeight="17"/>

                                        <!-- Badge tag if document generated -->
                                        <Border Visibility="{Binding BadgeVisibility}" Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Quick Prompt Chips -->
                    <Border Grid.Row="2" Background="#FFF8FAFC" Padding="6" CornerRadius="6" Margin="0,4,0,6" BorderBrush="#FFE2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Gợi ý câu lệnh nhanh (Click để chọn):" FontSize="10.5" Foreground="#FF64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <WrapPanel Orientation="Horizontal">
                                <dx:SimpleButton Content="🧾 Quét Hóa đơn ➔ Excel" Height="22" Margin="2" Click="BtnChipOcrExcel_Click"/>
                                <dx:SimpleButton Content="📝 Biên bản Giao nhận ➔ Word" Height="22" Margin="2" Click="BtnChipOcrWord_Click"/>
                                <dx:SimpleButton Content="📊 Bảng nhập kho (Nợ 152/Có 331)" Height="22" Margin="2" Click="BtnChipExpense_Click"/>
                                <dx:SimpleButton Content="📋 Bảng đối chiếu công nợ (Word)" Height="22" Margin="2" Click="BtnChipReconcile_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Chat Input Area with Attachment -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Attached File Banner Card -->
                        <Border Grid.Row="0" x:Name="pnlAttachedFile" Visibility="Collapsed" Background="#EFF6FF" CornerRadius="6" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,5" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📎" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtAttachedFileName" FontWeight="Bold" FontSize="11" Foreground="#1E3A8A" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="txtAttachedFileSize" FontSize="9.5" Foreground="#6B7280"/>
                                </StackPanel>
                                <dx:SimpleButton Grid.Column="2" Content="✕" Width="22" Height="22" Padding="0"
                                                 ToolTip="Gỡ tệp đính kèm" Click="BtnRemoveAttached_Click"/>
                            </Grid>
                        </Border>

                        <dxe:TextEdit Grid.Row="1" x:Name="txtChatInput" Height="65" VerticalContentAlignment="Top"
                                      AcceptsReturn="True" TextWrapping="Wrap"
                                      NullText="Nhập yêu cầu (ví dụ: bóc tách hóa đơn thành bảng Excel, hoặc biên bản Word, Ctrl+Enter để gửi)..."
                                      PreviewKeyDown="TxtChatInput_PreviewKeyDown"
                                      AllowDrop="True" Drop="TxtChatInput_Drop"/>

                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <dx:SimpleButton x:Name="btnAttachFile" Content="📎 Đính kèm Tệp / Hóa đơn" Height="28"
                                                 ToolTip="Đính kèm ảnh hóa đơn (.jpg, .png) hoặc tài liệu scan để AI bóc tách theo yêu cầu"
                                                 Click="BtnAttachFile_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="lblTyping" Text="⏳ AI đang phân tích và sinh tài liệu..." Visibility="Collapsed" VerticalAlignment="Center" Foreground="#FF2563EB" FontSize="11" Margin="0,0,10,0"/>
                                <dx:SimpleButton x:Name="btnSendChat" Content="Gửi yêu cầu ⚡" Height="28" Width="115" FontWeight="Bold"
                                                 Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_check.svg'}"
                                                 Click="BtnSendChat_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FFE5E7EB"/>

            <!-- RIGHT PANE: OFFICE STUDIO (EXCEL & WORD) -->
            <TabControl x:Name="officeTabControl" Grid.Column="2" Margin="0">
                <!-- TAB 1: EXCEL SPREADSHEET -->
                <TabItem Header="📊 Bảng tính Kế toán (Excel Spreadsheet)">
                    <Grid>
                        <dxsps:SpreadsheetControl x:Name="spreadsheetControl"
                                                 ShowFormulaBar="True"
                                                 CommandBarStyle="Ribbon"/>
                    </Grid>
                </TabItem>

                <!-- TAB 2: WORD DOCUMENT -->
                <TabItem Header="📄 Soạn thảo Văn bản (Word Document)">
                    <Grid>
                        <dxre:RichEditControl x:Name="richEditControl"
                                              CommandBarStyle="Ribbon"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#FFF8F9FA">
            <StatusBarItem>
                <TextBlock x:Name="lblOfficeStatus" Text="Sẵn sàng làm việc với Excel và Word tích hợp AI." Foreground="#FF4B5563" FontSize="11.5"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</base:BaseWindow>
