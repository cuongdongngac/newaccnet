<base:BaseWindow 
    x:Class="NewaccNet.Wpf.AppSystem.AI.AiAssistantWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Trung Tâm Trí Tuệ Nhân Tạo (AI Copilot &amp; CFO Brain)"
    Width="1280" Height="820"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Level Tab Control -->
        <TabControl x:Name="mainTabControl" Grid.Row="0">

            <!-- ============================================================== -->
            <!-- TAB 1: TRỢ LÝ NHẬP LIỆU BẰNG LỆNH TỰ NHIÊN (CÁNH TAY KÉO DÀI)    -->
            <!-- ============================================================== -->
            <TabItem Header="⚡ 1. Trợ lý Nhập liệu Tự nhiên (Cánh tay kéo dài)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Prompt Input Area -->
                    <Border Grid.Row="0" Background="#FFF8F9FA" Padding="12" CornerRadius="6" BorderBrush="#FFDEE2E6" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Nhập yêu cầu nghiệp vụ kế toán bằng tiếng Việt tự nhiên:" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>

                            <dxe:TextEdit Grid.Row="1" x:Name="txtNaturalPrompt" Height="65" VerticalContentAlignment="Top"
                                          AcceptsReturn="True" TextWrapping="Wrap"
                                          NullText="Ví dụ: Mua 5 máy in HP LaserJet giá 3.500.000đ/cái chưa VAT 10% thanh toán bằng chuyển khoản Vietcombank cho Công ty Minh Quân MST 0101234567 ngày hôm nay..."/>

                            <!-- Quick Sample Prompts -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Mẫu gợi ý nhanh:" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,8,0"/>
                                <dx:SimpleButton Content="Chi tiền mặt mua VPP" Height="24" Margin="0,0,6,0" Click="BtnSampleVpp_Click"/>
                                <dx:SimpleButton Content="Mua hàng chưa trả tiền NCC" Height="24" Margin="0,0,6,0" Click="BtnSampleBuyGoods_Click"/>
                                <dx:SimpleButton Content="Thu tiền khách hàng bằng CK" Height="24" Margin="0,0,6,0" Click="BtnSampleCollectCustomer_Click"/>
                                <dx:SimpleButton Content="Tạm ứng công tác phí" Height="24" Margin="0,0,6,0" Click="BtnSampleAdvance_Click"/>

                                <dx:SimpleButton x:Name="btnExecuteAgent" Content="⚡ Hạch toán Bút toán (AI)" Height="28" Width="190" Margin="20,0,0,0"
                                                 FontWeight="Bold"
                                                 Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_check.svg'}"
                                                 Click="BtnExecuteAgent_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Header Preview Info -->
                    <Border Grid.Row="1" Background="#FFF0F7FF" Padding="10" CornerRadius="6" BorderBrush="#FFB8DAFF" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nội dung / Diễn giải chứng từ:" FontSize="11" Foreground="Gray"/>
                                <dxe:TextEdit x:Name="txtAgentContents" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Ngày chứng từ:" FontSize="11" Foreground="Gray"/>
                                <dxe:DateEdit x:Name="dtAgentVoucherDate"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Đối tượng / Người nộp-nhận:" FontSize="11" Foreground="Gray"/>
                                <dxe:TextEdit x:Name="txtAgentPartnerName"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Nguồn CT gợi ý:" FontSize="11" Foreground="Gray"/>
                                <dxe:TextEdit x:Name="txtAgentSourceCode" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Journal Entries Grid -->
                    <GroupBox Grid.Row="2" Header="Bảng Định khoản Bút toán Đề xuất (Hạch toán trên RAM)">
                        <dxg:GridControl x:Name="gridAgentEntries" AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView ShowGroupPanel="False" ShowTotalSummary="True" AutoWidth="True"
                                               AllowEditing="True" NavigationStyle="Cell"/>
                            </dxg:GridControl.View>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="DbcrText" Header="Nợ / Có" Width="80" HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DbcrOptions}"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="AccountId" Header="Mã Tài khoản" Width="100"/>
                                <dxg:GridColumn FieldName="AccountName" Header="Tên Tài khoản" Width="200" ReadOnly="True"/>
                                <dxg:GridColumn FieldName="Amount" Header="Số tiền (VNĐ)" Width="140">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Description" Header="Diễn giải chi tiết" Width="260"/>
                                <dxg:GridColumn FieldName="PartnerCode" Header="Mã Đối tác" Width="100"/>
                                <dxg:GridColumn FieldName="WarehouseCode" Header="Mã Kho" Width="90"/>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.TotalSummary>
                                <dxg:GridSummaryItem SummaryType="Count" Alignment="Left" DisplayFormat="Số dòng: {0}"/>
                                <dxg:GridSummaryItem FieldName="Amount" SummaryType="Sum" DisplayFormat="Tổng tiền: {0:N0}"/>
                            </dxg:GridControl.TotalSummary>
                        </dxg:GridControl>
                    </GroupBox>

                    <!-- Bottom Action Bar -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <dx:SimpleButton x:Name="btnOpenVoucher" Content="📝 Đẩy vào Phiếu Kế toán (Voucher)" Height="34" Width="240"
                                         FontWeight="Bold" Margin="0,0,10,0"
                                         Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_invoice.svg'}"
                                         Click="BtnOpenVoucher_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================== -->
            <!-- TAB 2: OCR HÓA ĐƠN & QUÉT CHỨNG TỪ (OCR VISION)               -->
            <!-- ============================================================== -->
            <TabItem Header="📄 2. OCR Hóa đơn &amp; Quét chứng từ (OCR Vision)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Source File Bar -->
                    <Border Grid.Row="0" Background="#FFF8F9FA" Padding="10" CornerRadius="6" BorderBrush="#FFDEE2E6" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tệp Hóa đơn/Ảnh/PDF:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <dxe:TextEdit x:Name="txtOcrFilePath" Grid.Column="1" Height="30" Margin="0,0,8,0" NullText="Chọn file JPG, PNG hoặc PDF để AI trích xuất tự động..."/>
                            <dx:SimpleButton x:Name="btnBrowseOcr" Grid.Column="2" Content="📁 Chọn tệp..." Height="30" Width="110" Margin="0,0,8,0" Click="BtnBrowseOcr_Click"/>
                            <dxe:ComboBoxEdit x:Name="cboOcrMode" Grid.Column="3" Width="180" Height="30" Margin="0,0,8,0" IsTextEditable="False">
                                <dxe:ComboBoxEditItem Content="Trích xuất Hóa đơn (Bảng &amp; Tiền)" IsSelected="True"/>
                                <dxe:ComboBoxEditItem Content="Nhận dạng Toàn văn (Markdown)"/>
                            </dxe:ComboBoxEdit>
                            <dx:SimpleButton x:Name="btnRunOcr" Grid.Column="4" Content="⚡ Quét &amp; Trích xuất (AI OCR)" Height="30" Width="190" FontWeight="Bold"
                                             Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/pdf%20viewer/openfromweb.svg'}"
                                             Click="BtnRunOcr_Click"/>
                        </Grid>
                    </Border>

                    <!-- Main Content Area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Invoice Header Info & Image Thumbnail -->
                        <Border Grid.Column="0" Background="#FFF5F5F5" Padding="10" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1" Margin="0,0,10,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="THÔNG TIN HÓA ĐƠN TRÍCH XUẤT" FontWeight="Bold" Foreground="#FF1976D2" Margin="0,0,0,8"/>

                                    <TextBlock Text="Số hóa đơn:" FontSize="11" Foreground="Gray"/>
                                    <dxe:TextEdit x:Name="txtOcrInvoiceNumber" Margin="0,0,0,6"/>

                                    <TextBlock Text="Ngày hóa đơn:" FontSize="11" Foreground="Gray"/>
                                    <dxe:DateEdit x:Name="dtOcrInvoiceDate" Margin="0,0,0,6"/>

                                    <TextBlock Text="Ký hiệu / Mẫu số:" FontSize="11" Foreground="Gray"/>
                                    <dxe:TextEdit x:Name="txtOcrSerial" Margin="0,0,0,6"/>

                                    <TextBlock Text="Tên người bán (Nhà cung cấp):" FontSize="11" Foreground="Gray"/>
                                    <dxe:TextEdit x:Name="txtOcrSellerName" Margin="0,0,0,6"/>

                                    <TextBlock Text="Mã số thuế bán:" FontSize="11" Foreground="Gray"/>
                                    <dxe:TextEdit x:Name="txtOcrSellerTaxCode" Margin="0,0,0,6"/>

                                    <TextBlock Text="Địa chỉ bán:" FontSize="11" Foreground="Gray"/>
                                    <dxe:TextEdit x:Name="txtOcrSellerAddress" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <TextBlock Text="Tên người mua:" FontSize="11" Foreground="Gray"/>
                                    <dxe:TextEdit x:Name="txtOcrBuyerName" Margin="0,0,0,6"/>

                                    <TextBlock Text="Mã số thuế mua:" FontSize="11" Foreground="Gray"/>
                                    <dxe:TextEdit x:Name="txtOcrBuyerTaxCode" Margin="0,0,0,6"/>

                                    <TextBlock Text="Tổng tiền thanh toán (VNĐ):" FontSize="11" Foreground="Gray"/>
                                    <dxe:TextEdit x:Name="txtOcrTotalAmount" FontWeight="Bold" Foreground="DarkRed" Margin="0,0,0,6"
                                                  MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>

                                    <!-- Image Thumbnail preview -->
                                    <TextBlock Text="Ảnh xem trước:" FontSize="11" Foreground="Gray" Margin="0,8,0,4"/>
                                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Height="150" Background="White">
                                        <Image x:Name="imgOcrPreview" Stretch="Uniform"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Line Items Grid OR Full Text Markdown -->
                        <Grid Grid.Column="1">
                            <!-- Table View for Invoices -->
                            <GroupBox x:Name="grpOcrItems" Header="Danh sách Mặt hàng / Dịch vụ (Trích xuất từ OCR)">
                                <dxg:GridControl x:Name="gridOcrItems" AutoGenerateColumns="None">
                                    <dxg:GridControl.View>
                                        <dxg:TableView ShowGroupPanel="False" ShowTotalSummary="True" AutoWidth="True"
                                                       AllowEditing="True" NavigationStyle="Cell"/>
                                    </dxg:GridControl.View>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="LineNo" Header="STT" Width="45" ReadOnly="True"/>
                                        <dxg:GridColumn FieldName="ItemName" Header="Tên Mặt hàng / Dịch vụ" Width="220"/>
                                        <dxg:GridColumn FieldName="Unit" Header="ĐVT" Width="60"/>
                                        <dxg:GridColumn FieldName="Quantity" Header="Số lượng" Width="80">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="UnitPrice" Header="Đơn giá" Width="100">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Amount" Header="Thành tiền" Width="110">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="TaxRate" Header="Thuế %" Width="65"/>
                                        <dxg:GridColumn FieldName="TaxAmount" Header="Tiền thuế" Width="100">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="SuggestedAccount" Header="TK gợi ý" Width="75"/>
                                        <dxg:GridColumn FieldName="SuggestedWarehouse" Header="Kho gợi ý" Width="75"/>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.TotalSummary>
                                        <dxg:GridSummaryItem SummaryType="Count" Alignment="Left" DisplayFormat="Số dòng: {0}"/>
                                        <dxg:GridSummaryItem FieldName="Amount" SummaryType="Sum" DisplayFormat="Tổng tiền hàng: {0:N0}"/>
                                        <dxg:GridSummaryItem FieldName="TaxAmount" SummaryType="Sum" DisplayFormat="Tổng thuế: {0:N0}"/>
                                    </dxg:GridControl.TotalSummary>
                                </dxg:GridControl>
                            </GroupBox>

                            <!-- Document Markdown View -->
                            <GroupBox x:Name="grpOcrDocument" Header="Nội dung Văn bản Nhận dạng (Full Text / Markdown)" Visibility="Collapsed">
                                <dxe:TextEdit x:Name="txtOcrFullDocument" VerticalContentAlignment="Top"
                                              AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                                              FontFamily="Consolas" FontSize="12"/>
                            </GroupBox>
                        </Grid>
                    </Grid>

                    <!-- Bottom OCR Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <dx:SimpleButton x:Name="btnOcrToVoucher" Content="📝 Tạo Phiếu Kế toán" Height="34" Width="170" Margin="0,0,8,0"
                                         FontWeight="Bold"
                                         Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_invoice.svg'}"
                                         Click="BtnOcrToVoucher_Click"/>
                        <dx:SimpleButton x:Name="btnOcrExtractItems" Content="📦 Trích xuất Danh mục Vật tư" Height="34" Width="200" Margin="0,0,8,0"
                                         Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_product.svg'}"
                                         Click="BtnOcrExtractItems_Click"/>
                        <dx:SimpleButton x:Name="btnOcrExtractPartner" Content="👥 Trích xuất Đối tượng NCC" Height="34" Width="190" Margin="0,0,8,0"
                                         Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_contact.svg'}"
                                         Click="BtnOcrExtractPartner_Click"/>
                        <dx:SimpleButton x:Name="btnOcrOpenInOffice" Content="🖥 Mở trong Office Studio" Height="34" Width="190" Margin="0,0,8,0"
                                         FontWeight="SemiBold"
                                         Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/export/exporttoxls.svg'}"
                                         Click="BtnOcrOpenInOffice_Click"/>
                        <dx:SimpleButton x:Name="btnOcrExportExcel" Content="📊 Xuất Bảng tính Excel (OpenXML)" Height="34" Width="220"
                                         Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_export_toxlsx.svg'}"
                                         Click="BtnOcrExportExcel_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================== -->
            <!-- TAB 3: GIÁM ĐỐC TÀI CHÍNH ẢO (BỘ NÃO THỨ HAI - CFO BRAIN)       -->
            <!-- ============================================================== -->
            <TabItem Header="🧠 3. Giám đốc Tài chính Ảo (Bộ não thứ hai - CFO Brain)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Query Bar -->
                    <Border Grid.Row="0" Background="#FFF8F9FA" Padding="12" CornerRadius="6" BorderBrush="#FFDEE2E6" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Kỳ phân tích:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <dxe:ComboBoxEdit x:Name="cboCfoPeriod" Grid.Column="1" Height="30" Margin="0,0,15,0" IsTextEditable="False">
                                    <dxe:ComboBoxEditItem Content="Năm hiện tại (2026)" IsSelected="True"/>
                                    <dxe:ComboBoxEditItem Content="Quý gần nhất"/>
                                    <dxe:ComboBoxEditItem Content="Tháng gần nhất"/>
                                </dxe:ComboBoxEdit>

                                <TextBlock Grid.Column="2" Text="Câu hỏi chiến lược / Yêu cầu CFO:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <dxe:TextEdit x:Name="txtCfoQuestion" Grid.Column="3" Height="30" Margin="0,0,8,0"
                                              NullText="Nhập câu hỏi tài chính cho AI (để trống nếu muốn phân tích tổng quan toàn diện)..."/>

                                <dx:SimpleButton x:Name="btnRunCfo" Grid.Column="4" Content="🧠 Phân tích &amp; Tư vấn (CFO)" Height="30" Width="200" FontWeight="Bold"
                                                 Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_pivotchart.svg'}"
                                                 Click="BtnRunCfo_Click"/>
                            </Grid>

                            <!-- Quick CFO Question Chips -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Chủ đề quan tâm:" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,8,0"/>
                                <dx:SimpleButton Content="Dòng tiền &amp; Khả năng thanh toán" Height="24" Margin="0,0,6,0" Click="BtnCfoCashFlow_Click"/>
                                <dx:SimpleButton Content="Phân tích Doanh thu &amp; Biên lợi nhuận" Height="24" Margin="0,0,6,0" Click="BtnCfoProfit_Click"/>
                                <dx:SimpleButton Content="Cảnh báo Rủi ro Công nợ" Height="24" Margin="0,0,6,0" Click="BtnCfoDebt_Click"/>
                                <dx:SimpleButton Content="Chiến lược Tối ưu Hàng tồn kho" Height="24" Margin="0,0,6,0" Click="BtnCfoInventory_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CFO Analysis Results -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Executive Summary & Sections -->
                        <Border Grid.Column="0" Background="#FFFFFFFF" Padding="12" CornerRadius="6" BorderBrush="#FFDEE2E6" BorderThickness="1" Margin="0,0,10,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="ĐÁNH GIÁ SỨC KHỎE TÀI CHÍNH:" FontWeight="Bold" FontSize="13" Foreground="#FF1976D2" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblCfoHealth" Text="Chờ phân tích..." FontWeight="Bold" FontSize="14" Foreground="DarkOrange" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <GroupBox Header="1. Tổng quan Tình hình Tài chính &amp; Điều hành" Margin="0,0,0,10">
                                        <TextBlock x:Name="txtCfoSummary" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"/>
                                    </GroupBox>

                                    <GroupBox Header="2. Phân tích Dòng tiền (Cash Flow)" Margin="0,0,0,10">
                                        <TextBlock x:Name="txtCfoCashFlow" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"/>
                                    </GroupBox>

                                    <GroupBox Header="3. Doanh thu &amp; Biên Lợi nhuận" Margin="0,0,0,10">
                                        <TextBlock x:Name="txtCfoRevenue" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"/>
                                    </GroupBox>

                                    <GroupBox Header="4. Rủi ro Công nợ &amp; Thu hồi Vốn" Margin="0,0,0,10">
                                        <TextBlock x:Name="txtCfoDebt" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"/>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: KPIs, Alerts & Actionable Recommendations -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Key Metrics Grid -->
                            <GroupBox Grid.Row="0" Header="Chỉ số Tài chính Trọng yếu" Margin="0,0,0,8">
                                <dxg:GridControl x:Name="gridCfoMetrics" AutoGenerateColumns="None">
                                    <dxg:GridControl.View>
                                        <dxg:TableView ShowGroupPanel="False" AutoWidth="True" NavigationStyle="Row"/>
                                    </dxg:GridControl.View>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="MetricName" Header="Chỉ số" Width="130"/>
                                        <dxg:GridColumn FieldName="MetricValue" Header="Giá trị" Width="70"/>
                                        <dxg:GridColumn FieldName="Benchmark" Header="Tham chiếu" Width="70"/>
                                        <dxg:GridColumn FieldName="Evaluation" Header="Đánh giá" Width="80"/>
                                    </dxg:GridControl.Columns>
                                </dxg:GridControl>
                            </GroupBox>

                            <!-- Key Alerts -->
                            <GroupBox Grid.Row="1" Header="⚠️ Điểm nóng &amp; Cảnh báo Nguy cơ" Margin="0,0,0,8">
                                <ListBox x:Name="lstCfoAlerts" BorderThickness="0" Background="Transparent"/>
                            </GroupBox>

                            <!-- Actionable Recommendations -->
                            <GroupBox Grid.Row="2" Header="🎯 Khuyến nghị Hành động cho Ban Giám Đốc">
                                <ListBox x:Name="lstCfoRecommendations" BorderThickness="0" Background="Transparent"/>
                            </GroupBox>
                        </Grid>
                    </Grid>

                    <!-- Bottom CFO Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <dx:SimpleButton x:Name="btnCfoOpenInOffice" Content="🖥 Xem trong Office Studio" Height="34" Width="200" Margin="0,0,10,0"
                                         FontWeight="SemiBold"
                                         Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/export/exporttodoc.svg'}"
                                         Click="BtnCfoOpenInOffice_Click"/>
                        <dx:SimpleButton x:Name="btnExportWord" Content="📄 Xuất Báo cáo Quản trị (Word OpenXML)" Height="34" Width="260" Margin="0,0,10,0"
                                         FontWeight="Bold"
                                         Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_export_todocx.svg'}"
                                         Click="BtnExportWord_Click"/>
                        <dx:SimpleButton x:Name="btnExportCfoExcel" Content="📊 Xuất Báo cáo Chỉ số (Excel OpenXML)" Height="34" Width="250"
                                         Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_export_toxlsx.svg'}"
                                         Click="BtnExportCfoExcel_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="1" Background="#FFF5F5F5" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblAiStatus" Text="Sẵn sàng." Foreground="#FF2E7D32" FontWeight="SemiBold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</base:BaseWindow>
