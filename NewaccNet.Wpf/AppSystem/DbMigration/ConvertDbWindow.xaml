<base:BaseWindow xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base" 
        x:Class="NewaccNet.Wpf.AppSystem.DbMigration.ConvertDbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Chuyển đổi CSDL Access (MDB sang ACCDB)" 
        Height="700" Width="860" WindowStartupLocation="CenterOwner">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <dxlc:LayoutControl Orientation="Vertical" Padding="15">

                <!-- KHỐI 1: CSDL NGUỒN (.MDB) -->
                <dxlc:LayoutGroup Header="1. Cơ sở dữ liệu Access Nguồn (.mdb / .accdb cũ)" View="GroupBox" Orientation="Vertical">
                    <dxlc:LayoutItem Label="Tệp CSDL nguồn:">
                        <dxe:ButtonEdit x:Name="txtSourcePath" AllowDefaultButton="False" 
                                        NullText="Chọn tệp Access cũ (.mdb / .accdb) cần chuyển đổi..."
                                        EditValueChanged="TxtSourcePath_EditValueChanged">
                            <dxe:ButtonInfo GlyphKind="Custom" Content="..." ToolTip="Duyệt tìm tệp CSDL nguồn" Click="BtnBrowseSource_Click"/>
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Margin="0,4,0,0">
                        <TextBlock x:Name="lblSourceFileInfo" Text="Chưa chọn tệp CSDL nguồn." 
                                   FontStyle="Italic" Foreground="#FF555555"/>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <!-- KHỐI 2: TỆP MẪU & CSDL ĐÍCH (.ACCDB) -->
                <dxlc:LayoutGroup Header="2. Tệp Mẫu (Template) &amp; CSDL Đích Mới (.accdb)" View="GroupBox" Orientation="Vertical" Margin="0,10,0,0">
                    <dxlc:LayoutItem Label="Tệp mẫu (template.accdb):">
                        <dxe:ButtonEdit x:Name="txtTemplatePath" AllowDefaultButton="False" 
                                        NullText="Chọn đường dẫn tệp mẫu template.accdb...">
                            <dxe:ButtonInfo GlyphKind="Custom" Content="..." ToolTip="Chọn tệp mẫu template.accdb" Click="BtnBrowseTemplate_Click"/>
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>

                    <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,4,0,0">
                        <dxlc:LayoutItem Label="Tệp CSDL đích mới (.accdb):" HorizontalAlignment="Stretch">
                            <dxe:ButtonEdit x:Name="txtDestPath" AllowDefaultButton="False" 
                                            NullText="Chọn hoặc đặt tên tệp CSDL đích mới...">
                                <dxe:ButtonInfo GlyphKind="Custom" Content="..." ToolTip="Chọn nơi lưu tệp CSDL đích" Click="BtnBrowseDest_Click"/>
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dx:SimpleButton x:Name="btnCopyFromTemplate" Content="Tạo file đích từ Template" Width="175" Height="26" Margin="8,0,0,0"
                                         ToolTip="Sao chép tệp mẫu template.accdb thành tệp CSDL đích mới"
                                         Click="BtnCopyFromTemplate_Click"/>
                    </dxlc:LayoutGroup>

                    <TextBlock Text="* Lưu ý: File đích sẽ được cấu trúc lại chuẩn theo hệ thống mới. Dữ liệu từ file cũ sẽ được ánh xạ và nạp vào file này."
                               Foreground="#FF1565C0" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </dxlc:LayoutGroup>

                <!-- KHỐI 3: THÔNG TIN ENGINE VÀ MAPPING CSV -->
                <dxlc:LayoutGroup Header="3. Cấu hình Công cụ Chuyển đổi (Go Engine &amp; Mapping CSV)" View="GroupBox" Orientation="Vertical" Margin="0,10,0,0">
                    <dxlc:LayoutItem Label="Thư mục Migration:">
                        <dxe:TextEdit x:Name="txtMigrationDir" IsReadOnly="True" Background="#FFF5F5F5" Foreground="#FF333333"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Margin="0,4,0,0">
                        <TextBlock x:Name="lblEngineStatus" Text="Đang kiểm tra engine..." 
                                   FontWeight="SemiBold" Foreground="#FF2E7D32"/>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <!-- KHỐI 4: TIẾN ĐỘ THỰC THI & NHẬT KÝ THỜI GIAN THỰC -->
                <dxlc:LayoutGroup Header="4. Tiến độ thực thi &amp; Nhật ký chuyển đổi" View="GroupBox" Orientation="Vertical" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="lblCurrentStep" Text="Sẵn sàng thực hiện chuyển đổi..." 
                                   FontWeight="SemiBold" Foreground="#FF1565C0" VerticalAlignment="Center"/>
                        <dx:SimpleButton x:Name="btnClearLog" Content="Xóa nhật ký" Width="90" Height="22" 
                                         HorizontalAlignment="Right" Click="BtnClearLog_Click"/>
                    </Grid>

                    <dxe:ProgressBarEdit x:Name="pbProgress" Height="22" Minimum="0" Maximum="100" Value="0" 
                                         ContentDisplayMode="Value"/>

                    <TextBox x:Name="txtLogs" Margin="0,8,0,0" Height="200" IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" 
                             FontFamily="Consolas" FontSize="11" Background="#FFFDFDFD" Foreground="#FF333333"/>
                </dxlc:LayoutGroup>

                <!-- KHỐI 5: NÚT HÀNH ĐỘNG -->
                <dxlc:LayoutGroup Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <dx:SimpleButton x:Name="btnStart" Content="Bắt đầu chuyển đổi" Width="170" Height="36" 
                                     FontWeight="Bold" Background="#FF1565C0" Foreground="White" Click="BtnStart_Click"/>
                    <dx:SimpleButton x:Name="btnStop" Content="Dừng" Width="100" Height="36" Margin="10,0,0,0" 
                                     IsEnabled="False" Click="BtnStop_Click"/>
                    <dx:SimpleButton x:Name="btnClose" Content="Đóng" Width="100" Height="36" Margin="10,0,0,0" 
                                     Click="BtnClose_Click"/>
                </dxlc:LayoutGroup>

            </dxlc:LayoutControl>
        </ScrollViewer>
    </Grid>
</base:BaseWindow>