<dx:ThemedWindow x:Class="NewaccNet.Wpf.AppSystem.Voucher.Details.MaterialDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
        xmlns:dxs="clr-namespace:NewaccNet.Wpf.Controls.Search"
        xmlns:local="clr-namespace:NewaccNet.Wpf.AppSystem.Voucher"
        xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
        Title="Chi tiết vật tư, hàng hóa" Height="700" Width="1150" MinWidth="1000" MinHeight="550" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR CHUẨN DEVEXPRESS: LƯU, THÊM DÒNG, XÓA DÒNG, IN PHIẾU, ĐÓNG -->
        <dxb:BarContainerControl Grid.Row="0">
            <dxb:ToolBarControl ShowDragWidget="False" AllowCustomizationMenu="False" AllowHide="False" AllowQuickCustomization="False" GlyphSize="Small">
                <dxb:BarButtonItem Name="btnAccept" Content="Chấp nhận (Ctrl+S)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save.svg'}" ItemClick="BtnAccept_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarButtonItem Name="btnAddRow" Content="Thêm dòng (Insert)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_new.svg'}" ItemClick="BtnAddRow_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarButtonItem Name="btnDeleteRow" Content="Xóa dòng (Delete)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_delete.svg'}" ItemClick="BtnDeleteRow_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Name="btnPrint" Content="In phiếu (Ctrl+P)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/print/print.svg'}" ItemClick="BtnPrint_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Name="btnCancel" Content="Bỏ qua (Esc)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_close.svg'}" ItemClick="BtnCancel_Click" BarItemDisplayMode="ContentAndGlyph"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <!-- HEADER -->
        <dxlc:LayoutControl Grid.Row="1" Orientation="Horizontal" Padding="10">
            <!-- Left Side: Basic Info -->
            <dxlc:LayoutGroup Orientation="Vertical" Width="280">
                <dxlc:LayoutItem Label="Loại phiếu">
                    <dxe:ComboBoxEdit x:Name="cboVoucherType" 
                                      DisplayMember="Description" 
                                      ValueMember="Taxflag" 
                                      EditValue="{Binding Taxflag, Mode=TwoWay}" 
                                      IsTextEditable="False"
                                      EditValueChanged="cboVoucherType_EditValueChanged"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Kho">
                    <dxg:LookUpEdit x:Name="lueWarehouse" 
                                    EditValue="{Binding WarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    DisplayMember="WarehouseName" 
                                    ValueMember="WarehouseId" 
                                    AutoPopulateColumns="False"
                                    AutoComplete="True"
                                    ImmediatePopup="True"
                                    IsTextEditable="True"
                                    PopupWidth="350">
                        <dxmvvm:Interaction.Behaviors>
                            <dxs:SearchLookUpBehavior/>
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:LookUpEdit.Buttons>
                            <dxe:ButtonInfo GlyphKind="Plus" ToolTip="Tạo mới kho hàng" Click="BtnAddWarehouse_Click"/>
                        </dxg:LookUpEdit.Buttons>
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <dxg:GridControl Name="PART_GridControl">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="WarehouseId" Header="Mã Kho" Width="100"/>
                                        <dxg:GridColumn FieldName="WarehouseName" Header="Tên Kho" Width="220"/>
                                    </dxg:GridControl.Columns>
                                </dxg:GridControl>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Người giao nhận">
                    <dxe:TextEdit Text="{Binding InventoryVoucher.Carrier, Mode=TwoWay}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem>
                    <dxe:CheckEdit x:Name="chkPrintFlag" Content="In hóa đơn (kèm thông tin HĐ)" IsChecked="{Binding Printflag, Mode=TwoWay}"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <!-- Right Side: Tax Info (2 Cột ngang gọn gàng, tiết kiệm chiều cao) -->
            <dxlc:LayoutGroup x:Name="pnlTaxInfo" Orientation="Horizontal" Visibility="{Binding TaxInfoVisibility}" Margin="20,0,0,0">
                <!-- Cột 1: Thông tin Hóa đơn -->
                <dxlc:LayoutGroup Orientation="Vertical" Width="250">
                    <dxlc:LayoutItem Label="Số hóa đơn:">
                        <dxe:TextEdit Text="{Binding InventoryVoucher.Vatbillno, Mode=TwoWay}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Số Seria:">
                        <dxe:TextEdit Text="{Binding InventoryVoucher.Serialno, Mode=TwoWay}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Ngày hóa đơn:">
                        <dxe:DateEdit EditValue="{Binding InventoryVoucher.Vatbilldate, Mode=TwoWay}"/>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <!-- Cột 2: Thông tin Đối tượng mua bán & MST -->
                <dxlc:LayoutGroup Orientation="Vertical" Margin="15,0,0,0">
                    <dxlc:LayoutItem Label="MS người mua bán:">
                        <dxg:LookUpEdit x:Name="lueVatObject" DisplayMember="Id" ValueMember="Id" EditValue="{Binding InventoryVoucher.Vatobjectid, Mode=TwoWay}" AutoPopulateColumns="False" EditValueChanged="lueVatObject_EditValueChanged">
                            <dxmvvm:Interaction.Behaviors>
                                <dxs:SearchLookUpBehavior/>
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:LookUpEdit.Buttons>
                                <dxe:ButtonInfo GlyphKind="Plus" ToolTip="Tạo mới đối tượng thuế" Click="BtnAddVatPartner_Click"/>
                            </dxg:LookUpEdit.Buttons>
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <dxg:GridControl Name="PART_GridControl">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="Id" Header="Mã số"/>
                                            <dxg:GridColumn FieldName="CustomerName" Header="Tên đối tượng"/>
                                        </dxg:GridControl.Columns>
                                    </dxg:GridControl>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Người mua bán:">
                        <dxe:TextEdit Text="{Binding InventoryVoucher.Vatobjectname, Mode=TwoWay}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxlc:LayoutItem Label="Địa chỉ:">
                            <dxe:TextEdit Text="{Binding InventoryVoucher.Vataddress, Mode=TwoWay}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Mã số thuế:" Width="180" Margin="10,0,0,0">
                            <dxe:TextEdit Text="{Binding InventoryVoucher.Taxno, Mode=TwoWay}"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

        <!-- DETAILS GRID -->
        <dxg:GridControl x:Name="GridMaterialDetails" Grid.Row="2" Margin="10,0" ItemsSource="{Binding InventoryVoucher.InventoryVoucherLines}" CustomUnboundColumnData="GridMaterialDetails_CustomUnboundColumnData" AutoGenerateColumns="None">
            <dxg:GridControl.View>
                <base:AppDetailTableView x:Name="viewDetails" ShowGroupPanel="False" NewItemRowPosition="Bottom" 
                               EditorButtonShowMode="ShowForFocusedRow"
                               InitNewRow="viewDetails_InitNewRow" CellValueChanged="viewDetails_CellValueChanged" FocusedRowChanged="viewDetails_FocusedRowChanged" RowDeleted="viewDetails_RowDeleted"/>
            </dxg:GridControl.View>
            <dxg:GridControl.Bands>
                <dxg:GridControlBand Header="Thông tin chung" HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn FieldName="MaterialId" Header="Vật tư" Width="*" MinWidth="180">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxg:LookUpEdit Name="PART_Editor"
                                                ItemsSource="{Binding Path=Materials, RelativeSource={RelativeSource AncestorType=Window}}"
                                                DisplayMember="MaterialName" ValueMember="MaterialId"
                                                AutoPopulateColumns="False" PopupWidth="480"
                                                AutoComplete="True" ImmediatePopup="True" IsTextEditable="True">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxs:SearchLookUpBehavior/>
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:LookUpEdit.Buttons>
                                        <dxe:ButtonInfo GlyphKind="Plus" ToolTip="Tạo mới vật tư hàng hóa" Click="BtnAddMaterial_Click"/>
                                    </dxg:LookUpEdit.Buttons>
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="MaterialName" Header="Tên vật tư" Width="260"/>
                                                    <dxg:GridColumn FieldName="MaterialId" Header="Mã VT" Width="100"/>
                                                    <dxg:GridColumn FieldName="Unit" Header="ĐVT" Width="60"/>
                                                </dxg:GridControl.Columns>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Unit" Header="ĐVT" UnboundType="String" Width="65" ReadOnly="True" AllowEditing="False" HorizontalHeaderContentAlignment="Center"/>
                    <dxg:GridColumn FieldName="Quantity" Header="Số lượng" Width="85" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControlBand>
                <dxg:GridControlBand Header="Giá vốn" HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn FieldName="Price" Header="Đơn giá" Width="95" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Amount" Header="Thành tiền" UnboundType="Decimal" Width="110" ReadOnly="True" AllowEditing="False" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControlBand>
                <dxg:GridControlBand x:Name="bandSalesAndTax" Header="Giá bán &amp; Thuế" HorizontalHeaderContentAlignment="Center" Visible="False">
                    <dxg:GridColumn FieldName="SellPrice" Header="Đơn giá bán" Width="95" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="SellAmount" Header="Tiền bán" UnboundType="Decimal" Width="110" ReadOnly="True" AllowEditing="False" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Taxrateid" Header="% Thuế" Width="75" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings x:Name="lueTaxRate" 
                                                      DisplayMember="Display" 
                                                      ValueMember="Taxrateid" 
                                                      IsTextEditable="False" 
                                                      AutoComplete="True" 
                                                      ImmediatePopup="True"
                                                      HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="TaxAmount" Header="Tiền thuế" UnboundType="Decimal" Width="110" ReadOnly="True" AllowEditing="False" HorizontalHeaderContentAlignment="Right">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControlBand>
            </dxg:GridControl.Bands>
        </dxg:GridControl>

        <!-- FOOTER ĐỊNH KHOẢN & TỔNG TIỀN (3 DÒNG: TIÊU ĐỀ -> TÀI KHOẢN -> SỐ TIỀN) -->
        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15,8,15,8">
            <StackPanel Orientation="Vertical">
                <!-- Footer khi Nhập/Xuất nội bộ (Không mua bán): Chỉ hiện tổng tiền hàng -->
                <StackPanel Orientation="Vertical" Visibility="{Binding NonTradeFooterVisibility}" HorizontalAlignment="Left" Width="220">
                    <TextBlock Text="Tổng tiền vật tư" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                    <dxe:TextEdit EditValue="{Binding TotalCostAmount, Mode=OneWay}" 
                                  IsReadOnly="True" ShowBorder="False" Focusable="False"
                                  MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                                  FontWeight="Bold" FontSize="15" Foreground="#1565C0" HorizontalContentAlignment="Left"/>
                </StackPanel>

                <!-- Footer khi Mua bán (NM / XB): Hiện 4 cột khi XB, 3 cột khi NM (Tiêu đề -> Tài khoản -> Số tiền) -->
                <Grid Visibility="{Binding TradeFooterVisibility}">
                    <Grid.ColumnDefinitions>
                        <!-- Cột 1: Giá vốn (XB) hoặc Tiền hàng (NM) -->
                        <ColumnDefinition Width="*" MinWidth="130"/>
                        <ColumnDefinition Width="15"/>
                        <!-- Cột 2: Bán hàng / Doanh thu (Chỉ hiện khi XB, co về 0 khi NM) -->
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="*"/>
                                    <Setter Property="MinWidth" Value="130"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VoucherType}" Value="NM">
                                            <Setter Property="Width" Value="0"/>
                                            <Setter Property="MinWidth" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="15"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VoucherType}" Value="NM">
                                            <Setter Property="Width" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <!-- Cột 3: Thuế GTGT -->
                        <ColumnDefinition Width="*" MinWidth="130"/>
                        <ColumnDefinition Width="15"/>
                        <!-- Cột 4: Tổng thanh toán -->
                        <ColumnDefinition Width="*" MinWidth="130"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT 1: GIÁ VỐN (XB) / TIỀN HÀNG (NM) -->
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock Text="Giá vốn" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4" Visibility="{Binding SalesVisibility}"/>
                        <TextBlock Text="Tiền hàng" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4" Visibility="{Binding PurchaseVisibility}"/>
                        <local:AccountLookUpEdit x:Name="lueCostAccount" Visibility="{Binding SalesVisibility}" 
                                                 JournalEntry="{Binding CostMasterEntry}" ExcludeMaterialAccounts="True"/>
                        <!-- Placeholder chiều cao khi NM để số tiền thẳng hàng với các cột bên cạnh -->
                        <Border Height="24" Visibility="{Binding PurchaseVisibility}"/>
                        <dxe:TextEdit x:Name="txtTotalCost" EditValue="{Binding TotalCostAmount, Mode=OneWay}" 
                                      IsReadOnly="True" ShowBorder="False" Focusable="False"
                                      MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                                      FontWeight="Bold" FontSize="14" Foreground="#2E7D32" HorizontalContentAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- CỘT 2: DOANH THU / TIỀN BÁN (Chỉ hiện khi XB) -->
                    <StackPanel Grid.Column="2" Orientation="Vertical" Visibility="{Binding SalesVisibility}">
                        <TextBlock Text="Doanh thu" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                        <local:AccountLookUpEdit x:Name="lueRevenueAccount" 
                                                 JournalEntry="{Binding RevEntry}" ExcludeMaterialAccounts="True"/>
                        <dxe:TextEdit x:Name="txtTotalSell" EditValue="{Binding TotalSellAmount, Mode=OneWay}" 
                                      IsReadOnly="True" ShowBorder="False" Focusable="False"
                                      MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                                      FontWeight="Bold" FontSize="14" Foreground="#1565C0" HorizontalContentAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- CỘT 3: THUẾ GTGT -->
                    <StackPanel Grid.Column="4" Orientation="Vertical">
                        <TextBlock Text="Thuế GTGT" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                        <local:AccountLookUpEdit x:Name="lueTaxAccount" 
                                                 JournalEntry="{Binding TaxEntry}" ExcludeMaterialAccounts="True"/>
                        <dxe:TextEdit x:Name="txtTotalTax" EditValue="{Binding TotalTaxAmount, Mode=OneWay}" 
                                      IsReadOnly="True" ShowBorder="False" Focusable="False"
                                      MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                                      FontWeight="Bold" FontSize="14" Foreground="#E65100" HorizontalContentAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- CỘT 4: TỔNG THANH TOÁN -->
                    <StackPanel Grid.Column="6" Orientation="Vertical">
                        <TextBlock Text="Tổng thanh toán" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                        <local:AccountLookUpEdit x:Name="lueTotalAccount" 
                                                 JournalEntry="{Binding TotalEntry}" ExcludeMaterialAccounts="True"/>
                        <dxe:TextEdit x:Name="txtTotalAll" EditValue="{Binding TotalAllAmount, Mode=OneWay}" 
                                      IsReadOnly="True" ShowBorder="False" Focusable="False"
                                      MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                                      FontWeight="Bold" FontSize="15" Foreground="#C2185B" HorizontalContentAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="BtnAccept" Content="Chấp nhận" Width="100" Height="30" Margin="0,0,10,0" Click="BtnAccept_Click"/>
            <Button x:Name="BtnCancel" Content="Bỏ qua" Width="100" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</dx:ThemedWindow>


