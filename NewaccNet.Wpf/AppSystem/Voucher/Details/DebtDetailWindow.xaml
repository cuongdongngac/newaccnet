<base:BaseDetailWindow x:Class="NewaccNet.Wpf.AppSystem.Voucher.Details.DebtDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
        Title="Chi tiết công nợ" Height="450" Width="900">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <dxlc:LayoutControl Grid.Row="0" Padding="10">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="Tài khoản:" Width="150">
                    <TextBlock Text="{Binding AccountId}" FontWeight="Bold" Foreground="#1976D2"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Tổng tiền cần phân bổ:" Width="300">
                    <TextBlock Text="{Binding Amount, StringFormat='N0'}" FontWeight="Bold" Foreground="#D32F2F"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

        <dxg:GridControl x:Name="GridDebtDetails" Grid.Row="1" Margin="10,0" ItemsSource="{Binding DebtDetails}">
            <dxg:GridControl.View>
                <base:AppDetailTableView x:Name="TableViewDebt" ShowGroupPanel="False" NewItemRowPosition="Bottom" 
                               ShowTotalSummary="True" AlternateRowBackground="#FFF5F5F5" 
                               CellValueChanged="TableViewDebt_CellValueChanged"
                               InitNewRow="TableViewDebt_InitNewRow"/>
            </dxg:GridControl.View>
            <dxg:GridControl.Columns>
                
                <dxg:GridColumn FieldName="PartnerId" Header="Đối tượng" Width="150">
                    <dxg:GridColumn.EditSettings>
                        <dxg:LookUpEditSettings x:Name="lookupPartner" DisplayMember="CustomerName" ValueMember="Id" AutoPopulateColumns="False" PopupWidth="400">
                            <dxg:LookUpEditSettings.PopupContentTemplate>
                                <ControlTemplate>
                                    <dxg:GridControl Name="PART_GridControl">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="Id" Header="Mã ĐT" Width="100"/>
                                            <dxg:GridColumn FieldName="CustomerName" Header="Tên ĐT" Width="200"/>
                                        </dxg:GridControl.Columns>
                                    </dxg:GridControl>
                                </ControlTemplate>
                            </dxg:LookUpEditSettings.PopupContentTemplate>
                        </dxg:LookUpEditSettings>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="DebtTypeId" Header="Nội dung" Width="150">
                    <dxg:GridColumn.EditSettings>
                        <dxg:LookUpEditSettings x:Name="lookupDebtType" DisplayMember="TypeName" ValueMember="Id" AutoPopulateColumns="False" PopupWidth="300">
                            <dxg:LookUpEditSettings.PopupContentTemplate>
                                <ControlTemplate>
                                    <dxg:GridControl Name="PART_GridControl">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="Id" Header="Mã ND" Width="100"/>
                                            <dxg:GridColumn FieldName="TypeName" Header="Tên ND" Width="200"/>
                                        </dxg:GridControl.Columns>
                                    </dxg:GridControl>
                                </ControlTemplate>
                            </dxg:LookUpEditSettings.PopupContentTemplate>
                        </dxg:LookUpEditSettings>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="Amount" Header="Số tiền" Width="120">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="N0" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="DebtReasonId" Header="Lý do" Width="120">
                    <dxg:GridColumn.EditSettings>
                        <dxg:LookUpEditSettings x:Name="lookupDebtReason" DisplayMember="ReasonName" ValueMember="Id"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="Liabilitydate" Header="Ngày ghi nợ" Width="100">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings DisplayFormat="dd/MM/yyyy" Mask="dd/MM/yyyy"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                
                <!-- Cột Thao tác (Cam kết và Ngoại tệ) - Icon only, no text -->
                <dxg:GridColumn Header="" Width="56">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Nút Lãi suất / Cam kết: icon biểu đồ tài chính -->
                                <dx:SimpleButton ToolTip="Cam kết / Lãi suất" 
                                                 Margin="1,0" Width="24" Height="24" Padding="0"
                                                 Click="BtnTrackLiability_Click" 
                                                 Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_pivotchart.svg'}"/>
                                <!-- Nút Ngoại tệ: icon tiền tệ/giá -->
                                <dx:SimpleButton ToolTip="Khai báo Ngoại tệ (1-1)" 
                                                 Margin="1,0" Width="24" Height="24" Padding="0"
                                                 Click="BtnCurrency_Click" 
                                                 Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_price.svg'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>

            </dxg:GridControl.Columns>
            
            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem FieldName="Amount" SummaryType="Sum" DisplayFormat="Tổng: {0:N0}"/>
            </dxg:GridControl.TotalSummary>
        </dxg:GridControl>

        <Border Grid.Row="2" Background="#F0F0F0" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <dx:SimpleButton Content="Chấp nhận" Padding="15,5" Margin="0,0,10,0" Click="BtnAccept_Click" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_check.svg'}"/>
                <dx:SimpleButton Content="Hủy bỏ" Padding="15,5" Click="BtnCancel_Click" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_delete.svg'}"/>
            </StackPanel>
        </Border>
    </Grid>
</base:BaseDetailWindow>