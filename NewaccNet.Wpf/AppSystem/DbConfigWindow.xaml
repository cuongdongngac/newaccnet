<base:BaseWindow xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base" x:Class="NewaccNet.Wpf.AppSystem.DbConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Cấu hình Kết nối CSDL" Height="770" Width="540" WindowStartupLocation="CenterOwner">
    <Grid>
        <dxlc:LayoutControl Orientation="Vertical" Padding="15">

            <!-- Chọn loại DB -->
            <dxlc:LayoutItem Label="Hệ quản trị CSDL:">
                <dxe:ComboBoxEdit x:Name="cboDbType" IsTextEditable="False"
                                  SelectedIndexChanged="CboDbType_SelectedIndexChanged">
                    <dxe:ComboBoxEditItem Content="Microsoft Access (.accdb)"/>
                    <dxe:ComboBoxEditItem Content="Microsoft SQL Server"/>
                    <dxe:ComboBoxEditItem Content="PostgreSQL (Npgsql)"/>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>

            <!-- Khung Access -->
            <dxlc:LayoutGroup x:Name="grpAccess" Header="Cấu hình Access"
                              View="GroupBox" Orientation="Vertical" Margin="0,8,0,0">
                <dxlc:LayoutItem Label="Đường dẫn file (.accdb):">
                    <dxe:ButtonEdit x:Name="txtAccessPath" AllowDefaultButton="False"
                                    EditValueChanged="AnyField_Changed">
                        <dxe:ButtonInfo GlyphKind="Custom" Content="..." Click="BtnBrowseAccess_Click"/>
                    </dxe:ButtonEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <!-- Khung SQL Server -->
            <dxlc:LayoutGroup x:Name="grpSqlServer" Header="Cấu hình SQL Server"
                              View="GroupBox" Orientation="Vertical" Margin="0,8,0,0"
                              Visibility="Collapsed">
                <dxlc:LayoutItem Label="Tên Server (IP):">
                    <dxe:TextEdit x:Name="txtServer" EditValueChanged="AnyField_Changed"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Tên Database:">
                    <dxe:TextEdit x:Name="txtDatabase" EditValueChanged="AnyField_Changed"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem>
                    <dxe:CheckEdit x:Name="chkIntegrated"
                                   Content="Dùng tài khoản Windows (Integrated Security)"
                                   Checked="ChkIntegrated_CheckedChanged"
                                   Unchecked="ChkIntegrated_CheckedChanged"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Tên đăng nhập (User):">
                    <dxe:TextEdit x:Name="txtUser" EditValueChanged="AnyField_Changed"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Mật khẩu (Password):">
                    <dxe:PasswordBoxEdit x:Name="txtPassword" EditValueChanged="AnyField_Changed"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <!-- Khung PostgreSQL -->
            <dxlc:LayoutGroup x:Name="grpPostgreSql" Header="Cấu hình PostgreSQL (Npgsql)"
                              View="GroupBox" Orientation="Vertical" Margin="0,8,0,0"
                              Visibility="Collapsed">
                <dxlc:LayoutItem Label="Host (IP / tên máy):">
                    <dxe:TextEdit x:Name="txtPgHost" EditValueChanged="AnyField_Changed"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Port:">
                    <dxe:TextEdit x:Name="txtPgPort" EditValueChanged="AnyField_Changed"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Tên Database:">
                    <dxe:TextEdit x:Name="txtPgDatabase" EditValueChanged="AnyField_Changed"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Username:">
                    <dxe:TextEdit x:Name="txtPgUsername" EditValueChanged="AnyField_Changed"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Password:">
                    <dxe:PasswordBoxEdit x:Name="txtPgPassword" EditValueChanged="AnyField_Changed"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <!-- Khung Thông tin công ty (Lưu trực tiếp vào CSDL) -->
            <dxlc:LayoutGroup Header="Thông tin đơn vị / công ty (Lưu trực tiếp vào CSDL)"
                              View="GroupBox" Orientation="Vertical" Margin="0,8,0,0">
                <dxlc:LayoutItem Label="Tên cơ quan / đơn vị:">
                    <dxe:TextEdit x:Name="txtCompanyName" NullText="Nhập tên công ty / đơn vị của bạn"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Năm kế toán:">
                    <dxe:SpinEdit x:Name="spnAccountingYear" IsFloatValue="False" Mask="d" MinValue="1900" MaxValue="2100"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <!-- Khung Cấu hình Kho lưu nháp Staging (VoucherDraft) -->
            <dxlc:LayoutGroup Header="Kho lưu trữ chứng từ nháp (Staging Store)"
                              View="GroupBox" Orientation="Vertical" Margin="0,8,0,0">
                <dxlc:LayoutItem Label="Cơ chế lưu nháp:">
                    <dxe:ComboBoxEdit x:Name="cboStagingStorageMode" IsTextEditable="False">
                        <dxe:ComboBoxEditItem Content="Tệp JSON cục bộ (AppData/NewaccNet/Staging)"/>
                        <dxe:ComboBoxEditItem Content="Bảng CSDL tập trung (StagingDraft table)"/>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <TextBlock Text="* Chế độ tệp JSON phù hợp máy đơn / Access. Bảng CSDL phù hợp SQL Server / PostgreSQL đa máy trạm."
                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <dx:SimpleButton x:Name="btnMigrateJsonToDb" Content="📥 Nạp JSON ➔ CSDL" Height="26" Margin="0,0,8,0"
                                     ToolTip="Đọc toàn bộ các tệp nháp JSON trong AppData và lưu vào bảng StagingDraft trong CSDL"
                                     Click="BtnMigrateJsonToDb_Click"/>
                    <dx:SimpleButton x:Name="btnMigrateDbToJson" Content="📤 Xuất CSDL ➔ JSON" Height="26"
                                     ToolTip="Đọc toàn bộ chứng từ nháp từ bảng StagingDraft và xuất thành các tệp JSON theo tháng"
                                     Click="BtnMigrateDbToJson_Click"/>
                </StackPanel>
            </dxlc:LayoutGroup>

            <!-- Preview Connection String -->
            <dxlc:LayoutGroup Header="Connection String (xem trước)" View="GroupBox"
                              Margin="0,10,0,0">
                <TextBox x:Name="txtConnPreview"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinHeight="48"
                         Background="#FFF8F8F8"
                         Foreground="#FF1565C0"
                         FontFamily="Consolas"
                         FontSize="11"
                         Padding="6"
                         BorderThickness="0"/>
            </dxlc:LayoutGroup>

            <!-- Nút Lưu -->
            <dx:SimpleButton Content="Lưu Cấu Hình" Height="35" Margin="0,12,0,0"
                             Click="BtnSave_Click" FontWeight="Bold"
                             Background="#FF4CAF50" Foreground="White"/>
        </dxlc:LayoutControl>
    </Grid>
</base:BaseWindow>
