<base:BaseWindow
    x:Class="NewaccNet.Wpf.AppSystem.Plugins.PluginManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Quản lý Tiện ích Mở rộng &amp; Plugin (Ecosystem Manager)"
    Width="950" Height="580"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#FFF0FDF4" BorderBrush="#FFBBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🧩" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Trung Tâm Quản Lý Tiện Ích Mở Rộng &amp; Plugin (NewaccNet Ecosystem)" FontWeight="Bold" FontSize="14" Foreground="#FF166534"/>
                    <TextBlock Text="Cắm rút linh hoạt các module đặc thù theo từng doanh nghiệp (AI Copilot, Quản lý công trình, Giá thành sản xuất, v.v.). Plugin độc lập giúp Core luôn ổn định và tinh gọn." 
                               Foreground="#FF15803D" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Action Bar -->
        <Border Grid.Row="1" Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnInstallPlugin" Grid.Column="0" Content="➕ Cài đặt Plugin mới (.dll)..." Height="28" Width="190" Margin="0,0,8,0"
                        FontWeight="Bold" Background="#FF16A34A" Foreground="White" Click="BtnInstallPlugin_Click"/>

                <Button x:Name="btnRefresh" Grid.Column="1" Content="🔄 Làm mới danh sách" Height="28" Width="145" Margin="0,0,8,0"
                        FontWeight="SemiBold" Background="#FF4B5563" Foreground="White" Click="BtnRefresh_Click"/>

                <Button x:Name="btnOpenFolder" Grid.Column="2" Content="📂 Mở thư mục Plugins" Height="28" Width="150" Margin="0,0,8,0"
                        FontWeight="SemiBold" Click="BtnOpenFolder_Click"/>

                <TextBlock x:Name="lblPluginStats" Grid.Column="3" Text="Đang tải danh sách..." VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF1E40AF" Margin="10,0,0,0"/>

                <TextBlock Grid.Column="4" Text="Thư mục: %APPDATA%\NewaccNet\Plugins" VerticalAlignment="Center" FontSize="10.5" Foreground="#FF9CA3AF"/>
            </Grid>
        </Border>

        <!-- 3. Grid of Plugins -->
        <dxg:GridControl x:Name="gridPlugins" Grid.Row="2" AutoGenerateColumns="None" SelectionMode="Row">
            <dxg:GridControl.View>
                <dxg:TableView x:Name="viewPlugins" ShowGroupPanel="False" ShowSearchPanelMode="Always" 
                               ShowAutoFilterRow="False" AllowEditing="False" ShowTotalSummary="False"/>
            </dxg:GridControl.View>
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="StatusDisplay" Header="Trạng thái" Width="120" FixedWidth="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="Name" Header="Tên Tiện Ích / Plugin" Width="200" FixedWidth="True"/>

                <dxg:GridColumn FieldName="Id" Header="Mã định danh" Width="130" FixedWidth="True"/>
                <dxg:GridColumn FieldName="Version" Header="Phiên bản" Width="85" FixedWidth="True"/>
                <dxg:GridColumn FieldName="Description" Header="Mô tả chức năng" Width="*"/>
                <dxg:GridColumn FieldName="Author" Header="Tác giả" Width="120" FixedWidth="True"/>
                <dxg:GridColumn FieldName="DllFileName" Header="Tệp DLL" Width="150" FixedWidth="True"/>
            </dxg:GridControl.Columns>
        </dxg:GridControl>

        <!-- 4. Bottom Controls -->
        <Border Grid.Row="3" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnToggleState" Grid.Column="0" Content="⚡ Bật / Tắt Plugin đang chọn" Height="30" Width="190" Margin="0,0,8,0"
                        FontWeight="Bold" Background="#FF2563EB" Foreground="White" Click="BtnToggleState_Click"/>

                <Button x:Name="btnUninstallPlugin" Grid.Column="1" Content="🗑️ Gỡ bỏ Plugin" Height="30" Width="130" Margin="0,0,8,0"
                        FontWeight="SemiBold" Background="#FFDC2626" Foreground="White" Click="BtnUninstallPlugin_Click"/>

                <Button x:Name="btnClose" Grid.Column="3" Content="Đóng" Height="30" Width="90" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</base:BaseWindow>
