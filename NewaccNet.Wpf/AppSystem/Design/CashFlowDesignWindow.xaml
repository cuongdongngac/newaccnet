<base:BaseWindow
    x:Class="NewaccNet.Wpf.AppSystem.Design.CashFlowDesignWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Thiết kế Báo cáo Lưu Chuyển Tiền tệ (B03-DN)"
    Height="950" Width="1500" WindowStartupLocation="CenterScreen"
    xmlns:auth="clr-namespace:NewaccNet.Wpf.AppSystem">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <dxb:ToolBarControl Grid.Row="0" AllowCustomizationMenu="False" AllowHide="False" AllowQuickCustomization="False" Margin="0,0,0,8">
            <dxb:BarButtonItem x:Name="btnLoad" Content="Tải cấu hình" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_refresh.svg'}" ItemClick="BtnLoad_ItemClick"/>
            <dxb:BarButtonItem x:Name="btnSave" Content="Lưu (Ctrl+S)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save.svg'}" ItemClick="BtnSave_ItemClick"/>
            <dxb:BarItemLinkSeparator/>
            <dxb:BarButtonItem x:Name="btnNewCat" Content="Thêm Nhóm LCTT" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_new.svg'}" ItemClick="BtnNewCategory_ItemClick"/>
            <dxb:BarButtonItem x:Name="btnNewItem" Content="Thêm Chỉ tiêu LCTT" ItemClick="BtnNewItem_ItemClick"/>
            <dxb:BarButtonItem x:Name="btnDelete" Content="Xóa dòng đang chọn" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_delete.svg'}" ItemClick="BtnDelete_ItemClick"/>
            <dxb:BarItemLinkSeparator/>
            <dxb:BarButtonItem Content="Bù cột tự động" ItemClick="BtnBestFit_ItemClick"/>
        </dxb:ToolBarControl>

        <!-- Top: CashFlowCategory (danh sách các nhóm LCTT) -->
        <GroupBox Grid.Row="1" Header="📘 Bậc 1: Nhóm LCTT (CashFlowCategory) — Chọn một nhóm để xem các Chỉ tiêu bên dưới" Padding="6">
            <dxg:GridControl x:Name="gridCategories" AutoGenerateColumns="None" SelectionMode="Row">
                <dxg:GridControl.View>
                    <dxg:TableView ShowGroupPanel="False" AllowEditing="True" NewItemRowPosition="Bottom"
                                   ShowAutoFilterRow="False" ShowSearchPanelMode="Always"
                                   NavigationStyle="Cell" AutoWidth="True"/>
                </dxg:GridControl.View>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Id" Header="ID" Width="60" AllowEditing="False" Fixed="Left" HorizontalHeaderContentAlignment="Center"/>
                    <dxg:GridColumn FieldName="CashFlowName" Header="Tên Nhóm LCTT (*)" Width="3*"/>
                    <dxg:GridColumn FieldName="CashFlowNameRepeate" Header="Tên lặp lại (in báo cáo)" Width="3*"/>
                    <dxg:GridColumn FieldName="OrderNo" Header="Thứ tự in" Width="100" HorizontalHeaderContentAlignment="Center"/>
                </dxg:GridControl.Columns>
            </dxg:GridControl>
        </GroupBox>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#FFC0C0C0" ResizeDirection="Rows" ShowsPreview="False"/>

        <!-- Bottom: CashFlowItem → AccountCashFlowItem (Master-Detail theo Category đã chọn) -->
        <GroupBox Grid.Row="3" Header="📗 Bậc 2-3: Chỉ tiêu LCTT (CashFlowItem) → Danh sách TK tham chiếu (AccountCashFlowItem) [Theo Nhóm đã chọn ở trên]" Padding="6">
            <dxg:GridControl x:Name="gridItems" AutoGenerateColumns="None" SelectionMode="Row">
                <dxg:GridControl.DetailDescriptor>
                    <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding AccountCashFlowItems}">
                        <dxg:GridControl AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView ShowGroupPanel="False" AllowEditing="True" NewItemRowPosition="Bottom"
                                               ShowAutoFilterRow="False" ShowSearchPanelMode="Always" RowMinHeight="26"
                                               NavigationStyle="Cell">
                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition FieldName="Dbcr" Expression="[Dbcr] = 'D'" ApplyToRow="True">
                                            <dxg:FormatCondition.Format><dx:Format Background="#FFE3F2FD"/></dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>
                                        <dxg:FormatCondition FieldName="Dbcr" Expression="[Dbcr] = 'C'" ApplyToRow="True">
                                            <dxg:FormatCondition.Format><dx:Format Background="#FFE8F5E9"/></dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>
                                    </dxg:TableView.FormatConditions>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Id" Header="ID" Width="60" AllowEditing="False" HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn FieldName="CashFlowItemId" Header="ItemId" Width="80" AllowEditing="False" HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn FieldName="AccountId" Header="Tài khoản (*)" Width="140">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings x:Name="cboAccDetail" DisplayMember="AccountId" ValueMember="AccountId" AutoComplete="True" ImmediatePopup="True"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="CounterAccountId" Header="TK Đối ứng" Width="140">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings x:Name="cboCounterDetail" DisplayMember="AccountId" ValueMember="AccountId" AutoComplete="True" ImmediatePopup="True"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Dbcr" Header="Nợ / Có (*)" Width="100">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings IsTextEditable="False">
                                            <dxe:ComboBoxEditSettings.Items>
                                                <dxe:ComboBoxEditItem Content="D — Nợ (Vào)"/>
                                                <dxe:ComboBoxEditItem Content="C — Có (Ra)"/>
                                            </dxe:ComboBoxEditSettings.Items>
                                        </dxe:ComboBoxEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                        </dxg:GridControl>
                    </dxg:DataControlDetailDescriptor>
                </dxg:GridControl.DetailDescriptor>

                <dxg:GridControl.View>
                    <dxg:TableView ShowGroupPanel="False" AllowEditing="True" NewItemRowPosition="Bottom"
                                   ShowAutoFilterRow="False" ShowSearchPanelMode="Always" RowMinHeight="28"
                                   NavigationStyle="Cell"/>
                </dxg:GridControl.View>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Id" Header="ID" Width="60" AllowEditing="False" Fixed="Left" HorizontalHeaderContentAlignment="Center"/>
                    <dxg:GridColumn FieldName="CashFlowCategoryId" Header="CatId" Width="70" AllowEditing="False" HorizontalHeaderContentAlignment="Center"/>
                    <dxg:GridColumn FieldName="Code" Header="Mã chỉ tiêu" Width="110"/>
                    <dxg:GridColumn FieldName="ItemName" Header="Tên chỉ tiêu LCTT (*)" Width="3*"/>
                    <dxg:GridColumn FieldName="Illustration" Header="Minh họa/Mô tả" Width="2*"/>
                    <dxg:GridColumn FieldName="Dbcr" Header="Nợ/Có (*)" Width="100">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings IsTextEditable="False">
                                <dxe:ComboBoxEditSettings.Items>
                                    <dxe:ComboBoxEditItem Content="D — Nợ (Vào)"/>
                                    <dxe:ComboBoxEditItem Content="C — Có (Ra)"/>
                                </dxe:ComboBoxEditSettings.Items>
                            </dxe:ComboBoxEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="IsBold" Header="In đậm" Width="80" HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.EditSettings>
                            <dxe:CheckEditSettings IsThreeState="False"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="IsItalic" Header="In nghiêng" Width="90" HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.EditSettings>
                            <dxe:CheckEditSettings IsThreeState="False"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="OrderNo" Header="Thứ tự in" Width="90" HorizontalHeaderContentAlignment="Center"/>
                </dxg:GridControl.Columns>
            </dxg:GridControl>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <dx:SimpleButton x:Name="btnClose" Content="Đóng cửa sổ" Width="140" Height="30" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_close.svg'}" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>
