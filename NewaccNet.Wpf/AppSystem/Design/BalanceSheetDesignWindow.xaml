<base:BaseWindow
    x:Class="NewaccNet.Wpf.AppSystem.Design.BalanceSheetDesignWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Thiết kế Bảng Cân Đối Kế Toán (B01-DN)"
    Height="950" Width="1500" WindowStartupLocation="CenterScreen"
    xmlns:auth="clr-namespace:NewaccNet.Wpf.AppSystem">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <dxb:ToolBarControl Grid.Row="0" AllowCustomizationMenu="False" AllowHide="False" AllowQuickCustomization="False" Margin="0,0,0,8">
            <dxb:BarButtonItem x:Name="btnLoad" Content="Tải cấu hình" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_refresh.svg'}" ItemClick="BtnLoad_ItemClick"/>
            <dxb:BarButtonItem x:Name="btnSave" Content="Lưu (Ctrl+S)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save.svg'}" ItemClick="BtnSave_ItemClick"/>
            <dxb:BarItemLinkSeparator/>
            <dxb:BarButtonItem x:Name="btnNewSection" Content="Thêm Mục lớn" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_new.svg'}" ItemClick="BtnNewSection_ItemClick"/>
            <dxb:BarButtonItem x:Name="btnNewCategory" Content="Thêm Nhóm chỉ tiêu" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_new.svg'}" ItemClick="BtnNewCategory_ItemClick"/>
            <dxb:BarButtonItem x:Name="btnNewItem" Content="Thêm Chỉ tiêu" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_new.svg'}" ItemClick="BtnNewItem_ItemClick"/>
            <dxb:BarButtonItem x:Name="btnDelete" Content="Xóa dòng đang chọn" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_delete.svg'}" ItemClick="BtnDelete_ItemClick"/>
            <dxb:BarItemLinkSeparator/>
            <dxb:BarButtonItem Content="Bù cột tự động" ItemClick="BtnBestFit_ItemClick"/>
        </dxb:ToolBarControl>

        <!-- Grid 1: Tầng 1 (Section) + Tầng 2 (Category) — master-detail -->
        <GroupBox Grid.Row="1" Header="📘 Bậc 1-2: Mục lớn (Section) → Nhóm chỉ tiêu (Category) — Chọn một Nhóm để xem Chỉ tiêu bên dưới" Padding="6">
            <dxg:GridControl x:Name="gridSections" CustomUnboundColumnData="GridSections_CustomUnboundColumnData" AutoGenerateColumns="None" SelectionMode="Row"
                             MasterRowExpanded="GridSections_MasterRowExpanded">
                <!-- Detail: Tầng 2 - ReportCategory -->
                <dxg:GridControl.DetailDescriptor>
                    <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding ReportCategories}">
                        <dxg:GridControl AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView ShowGroupPanel="False" AllowEditing="True" NewItemRowPosition="Bottom"
                                               NavigationStyle="Cell" DetailHeaderContent="Nhóm chỉ tiêu"
                                               ShowAutoFilterRow="False" ShowSearchPanelMode="Always" RowMinHeight="30"
                                               FocusedRowChanged="CategoryView_FocusedRowChanged">
                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition FieldName="Id" Expression="[Id] % 2 = 0" ApplyToRow="True">
                                            <dxg:FormatCondition.Format><dx:Format Background="#FFF3E5F5"/></dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>
                                    </dxg:TableView.FormatConditions>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                            <dxg:GridControl.Columns>
                                <!-- ReportCategoryEntity fields: Id, Code, CategoryName, ReportSectionId -->
                                <dxg:GridColumn FieldName="Id" Header="ID" Width="55" AllowEditing="False" Visible="False" HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn FieldName="Code" Header="Mã nhóm" Width="110"/>
                                <dxg:GridColumn FieldName="CategoryName" Header="Tên nhóm chỉ tiêu (*)" Width="300"/>
                                <dxg:GridColumn FieldName="ReportSectionId" Header="SectionId" Width="80" AllowEditing="False" Visible="False"/>
                            </dxg:GridControl.Columns>
                        </dxg:GridControl>
                    </dxg:DataControlDetailDescriptor>
                </dxg:GridControl.DetailDescriptor>

                <!-- Master View: Tầng 1 - ReportSection -->
                <dxg:GridControl.View>
                    <dxg:TableView ShowGroupPanel="False" AllowEditing="True" NewItemRowPosition="Bottom"
                                   NavigationStyle="Cell" ShowAutoFilterRow="False" ShowSearchPanelMode="Always"
                                   RowMinHeight="32">
                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition FieldName="Indebit" Expression="[Indebit] == True" ApplyToRow="True">
                                <dxg:FormatCondition.Format><dx:Format Background="#FFE3F2FD"/></dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                            <dxg:FormatCondition FieldName="Indebit" Expression="[Indebit] == False" ApplyToRow="True">
                                <dxg:FormatCondition.Format><dx:Format Background="#FFE8F5E9"/></dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                        </dxg:TableView.FormatConditions>
                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridControl.Columns>
                    <!-- ReportSectionEntity fields: Id, SectionName, Indebit -->
                    <dxg:GridColumn FieldName="Id" Header="ID" Width="60" AllowEditing="False" Visible="False" HorizontalHeaderContentAlignment="Center"/>
                    <dxg:GridColumn FieldName="TestBalance" Header="Số dư (Test)" Width="120" UnboundType="Decimal" ReadOnly="True"/>
                    <dxg:GridColumn FieldName="SectionName" Header="Mục lớn (I, II, III) (*)" Width="350"/>
                    <dxg:GridColumn FieldName="Indebit" Header="Bên Nợ" Width="80" HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.EditSettings>
                            <dxe:CheckEditSettings IsThreeState="False"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
            </dxg:GridControl>
        </GroupBox>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#FFD0D0D0" ResizeDirection="Rows"/>

        <!-- Grid 2: Tầng 3 (Item) + Tầng 4 (Formula) + Tầng 5 (FormulaAccount) -->
        <GroupBox Grid.Row="3" Header="📗 Bậc 3-5: Chỉ tiêu (Item) → Công thức (Formula) → Tài khoản tham chiếu (Account) [Theo Nhóm đã chọn ở trên]" Padding="6">
            <dxg:GridControl x:Name="gridItems" CustomUnboundColumnData="GridItems_CustomUnboundColumnData" AutoGenerateColumns="None" SelectionMode="Row">
                <!-- Detail Tầng 4: ReportFormula -->
                <dxg:GridControl.DetailDescriptor>
                    <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding ReportFormulas}">
                        <dxg:GridControl AutoGenerateColumns="None">
                            <!-- Sub-detail Tầng 5: ReportFormulaAccount -->
                            <dxg:GridControl.DetailDescriptor>
                                <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding ReportFormulaAccounts}">
                                    <dxg:GridControl AutoGenerateColumns="None">
                                        <dxg:GridControl.View>
                                            <dxg:TableView ShowGroupPanel="False" AllowEditing="True" NewItemRowPosition="Bottom"
                                                           NavigationStyle="Cell" DetailHeaderContent="Tài khoản tham chiếu"
                                                           ShowAutoFilterRow="False" ShowSearchPanelMode="Always" RowMinHeight="26">
                                            </dxg:TableView>
                                        </dxg:GridControl.View>
                                        <dxg:GridControl.Columns>
                                            <!-- ReportFormulaAccountEntity fields: Id, AccountId, ItemsId -->
                                            <dxg:GridColumn FieldName="Id" Header="ID" Width="60" AllowEditing="False" Visible="False" HorizontalHeaderContentAlignment="Center"/>
                                            <dxg:GridColumn FieldName="AccountId" Header="Mã TK (*)" Width="140">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:ComboBoxEditSettings x:Name="cboAccount" DisplayMember="AccountId" ValueMember="AccountId" AutoComplete="True" ImmediatePopup="True"/>
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn FieldName="ItemsId" Header="FormulaId" Width="80" AllowEditing="False" Visible="False"/>
                                        </dxg:GridControl.Columns>
                                    </dxg:GridControl>
                                </dxg:DataControlDetailDescriptor>
                            </dxg:GridControl.DetailDescriptor>

                            <dxg:GridControl.View>
                                <dxg:TableView ShowGroupPanel="False" AllowEditing="True" NewItemRowPosition="Bottom"
                                               NavigationStyle="Cell" DetailHeaderContent="Công thức tính"
                                               ShowAutoFilterRow="False" ShowSearchPanelMode="Always" RowMinHeight="28">
                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition FieldName="Print" Expression="[Print] == True" ApplyToRow="True">
                                            <dxg:FormatCondition.Format><dx:Format Background="#FFE8F5E9"/></dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>
                                        <dxg:FormatCondition FieldName="Print" Expression="[Print] == False" ApplyToRow="True">
                                            <dxg:FormatCondition.Format><dx:Format Background="#FFFBE9E7"/></dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>
                                    </dxg:TableView.FormatConditions>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                            <dxg:GridControl.Columns>
                                <!-- ReportFormulaEntity fields: Id, Code, ItemsName, Formula, Calculate, Illu, Longorshortterm, Order, Print, ReportItemId -->
                                <dxg:GridColumn FieldName="Id" Header="ID" Width="55" AllowEditing="False" Visible="False" HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn FieldName="Code" Header="Mã" Width="80"/>
                                <dxg:GridColumn FieldName="ItemsName" Header="Tên chỉ tiêu con" Width="200"/>
                                <dxg:GridColumn FieldName="Formula" Header="Công thức" Width="150"/>
                                <dxg:GridColumn FieldName="Calculate" Header="Tính toán" Width="80" HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings IsThreeState="False"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Illu" Header="Minh họa" Width="80"/>
                                <dxg:GridColumn FieldName="Longorshortterm" Header="Dài/Ngắn hạn" Width="100" HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn FieldName="Order" Header="Thứ tự" Width="70" HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn FieldName="Print" Header="In" Width="60" HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings IsThreeState="False"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ReportItemId" Header="ItemId" Width="80" AllowEditing="False" Visible="False"/>
                            </dxg:GridControl.Columns>
                        </dxg:GridControl>
                    </dxg:DataControlDetailDescriptor>
                </dxg:GridControl.DetailDescriptor>

                <!-- Master View: Tầng 3 - ReportItem -->
                <dxg:GridControl.View>
                    <dxg:TableView ShowGroupPanel="False" AllowEditing="True" NewItemRowPosition="Bottom"
                                   NavigationStyle="Cell" DetailHeaderContent="Chỉ tiêu BCTC"
                                   ShowAutoFilterRow="False" ShowSearchPanelMode="Always" RowMinHeight="30">
                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition FieldName="Id" Expression="[Id] % 2 = 0" ApplyToRow="True">
                                <dxg:FormatCondition.Format><dx:Format Background="#FFFFFDE7"/></dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                        </dxg:TableView.FormatConditions>
                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridControl.Columns>
                    <!-- ReportItemEntity fields: Id, Code, EntryName, ReportCategoryId -->
                    <dxg:GridColumn FieldName="Id" Header="ID" Width="55" AllowEditing="False" Visible="False" HorizontalHeaderContentAlignment="Center"/>
                    <dxg:GridColumn FieldName="Code" Header="Mã chỉ tiêu" Width="110"/>
                    <dxg:GridColumn FieldName="TestBalance" Header="Số dư (Test)" Width="120" UnboundType="Decimal" ReadOnly="True"/>
                    <dxg:GridColumn FieldName="EntryName" Header="Tên chỉ tiêu (*)" Width="280"/>
                    <dxg:GridColumn FieldName="ReportCategoryId" Header="CategoryId" Width="80" AllowEditing="False" Visible="False"/>
                </dxg:GridControl.Columns>
            </dxg:GridControl>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <dx:SimpleButton x:Name="btnClose" Content="Đóng cửa sổ" Width="140" Height="30" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_close.svg'}" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>



