<base:BaseWindow xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base" 
                 x:Class="NewaccNet.Wpf.AppSystem.License.LicenseWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 Title="Đăng ký Bản quyền Phần mềm NEWACCNET" 
                 Height="460" Width="580" 
                 WindowStartupLocation="CenterOwner" 
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#FF1976D2" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="White" Margin="0,0,15,0" Padding="8">
                    <Image Source="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/security_key.svg'}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ĐĂNG KÝ BẢN QUYỀN PHẦN MỀM" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Kích hoạt bản quyền chính thức từ tác giả Phạm Việt Cường" FontSize="12" Foreground="#E3F2FD" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body Form -->
        <StackPanel Grid.Row="1" Margin="24,18">
            
            <!-- Trạng thái hiện tại -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📌 Trạng thái:" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="txtCurrentStatus" Text="Bản dùng thử (Giới hạn 100 chứng từ)" 
                               FontWeight="Bold" Foreground="#D97706" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 1. Mã máy tính của bạn -->
            <TextBlock Text="1. Mã máy của bạn (Machine Code):" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <dxe:TextEdit x:Name="txtMachineCode" IsReadOnly="True" FontWeight="Bold" FontSize="14" 
                              Background="#F1F5F9" Foreground="#0F172A" Height="34" Padding="6,2"/>
                <dx:SimpleButton Grid.Column="1" Content="Sao chép mã máy" Height="34" Margin="10,0,0,0" Padding="12,0"
                                 Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/edit/copy.svg'}"
                                 Click="BtnCopyMachineCode_Click"/>
            </Grid>

            <!-- Hướng dẫn liên hệ -->
            <TextBlock Text="👉 Hãy sao chép mã máy trên và gửi qua Zalo 0903210335 để nhận mã kích hoạt." 
                       FontSize="11.5" Foreground="#64748B" FontStyle="Italic" Margin="0,0,0,16"/>

            <!-- 2. Ô nhập Mã kích hoạt -->
            <TextBlock Text="2. Nhập Mã kích hoạt bản quyền (License Key):" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <dxe:TextEdit x:Name="txtLicenseKey" NullText="Ví dụ: KEY-20991231-XXXX-XXXX-XXXX" 
                              FontSize="13" Height="34" Padding="6,2"/>
                <dx:SimpleButton Grid.Column="1" Content="Dán mã" Height="34" Margin="10,0,0,0" Padding="14,0"
                                 Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/edit/paste.svg'}"
                                 Click="BtnPasteKey_Click"/>
            </Grid>
        </StackPanel>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hotline: 0903210335" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <dx:SimpleButton Content="Đóng" Width="85" Height="32" Margin="0,0,10,0" Click="BtnClose_Click"/>
                    <dx:SimpleButton Content="Kích hoạt Bản quyền" Width="160" Height="32" 
                                     Background="#FF1976D2" Foreground="White" FontWeight="Bold"
                                     Click="BtnActivate_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</base:BaseWindow>
