<base:BaseWindow 
    x:Class="NewaccNet.Wpf.AppSystem.TaxInvoice.TaxInvoiceReviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Quản Lý &amp; Nhập Hóa Đơn Điện Tử"
    Width="1260" Height="780"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Level Tab Control -->
        <TabControl x:Name="mainTabControl" Grid.Row="0" SelectionChanged="MainTabControl_SelectionChanged">
            
            <!-- ============================================================== -->
            <!-- TAB 1: NHẬP TỪ TỆP JSON (CHỜ NẠP)                              -->
            <!-- ============================================================== -->
            <TabItem Header="📂 1. Nhập từ tệp JSON (Chờ nạp)">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Source Folder Bar -->
                    <Border Grid.Row="0" Background="#FFF5F5F5" Padding="10" CornerRadius="4" Margin="0,0,0,8" BorderBrush="#FFE0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Thư mục JSON nguồn:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <dxe:TextEdit x:Name="txtSourceFolder" Grid.Column="1" Height="30" Margin="0,0,8,0" NullText="Bấm Duyệt thư mục để chọn nơi chứa file JSON..."/>
                            <Button x:Name="btnBrowse" Grid.Column="2" Content="📁 Duyệt thư mục..." Height="30" Width="130" Margin="0,0,8,0" Click="BtnBrowse_Click"/>
                            <Button x:Name="btnReload" Grid.Column="3" Content="🔄 Đọc dữ liệu" Height="30" Width="110" Margin="0,0,8,0" Click="BtnReload_Click"/>
                            <Button x:Name="btnOpenDownloader" Grid.Column="4" Content="📥 Tải từ Cổng Thuế" Height="30" Width="150" 
                                    Background="#FF1976D2" Foreground="White" FontWeight="SemiBold" Click="BtnOpenDownloader_Click"/>
                        </Grid>
                    </Border>

                    <!-- 2. Action Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnSelectAll" Grid.Column="0" Content="✔ Chọn tất cả" Height="28" Width="100" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
                        <Button x:Name="btnUnselectAll" Grid.Column="1" Content="✖ Bỏ chọn" Height="28" Width="85" Margin="0,0,12,0" Click="BtnUnselectAll_Click"/>

                        <TextBlock Grid.Column="2" Text="Lọc chiều:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <dxe:ComboBoxEdit x:Name="cboJsonDirection" Grid.Column="3" Height="28" Width="110" Margin="0,0,8,0" IsTextEditable="False"
                                          SelectedIndexChanged="CboJsonDirection_SelectedIndexChanged">
                            <dxe:ComboBoxEditItem Content="Tất cả chiều" Tag="" IsSelected="True"/>
                            <dxe:ComboBoxEditItem Content="Mua vào" Tag="purchase"/>
                            <dxe:ComboBoxEditItem Content="Bán ra" Tag="sold"/>
                        </dxe:ComboBoxEdit>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="lblSelectedStats" Text="Đã chọn: 0/0 hóa đơn" FontWeight="SemiBold" Foreground="#FF0D47A1" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Button x:Name="btnPrepareDrafts" Grid.Column="5" Content="⚡ Chuẩn bị dữ liệu (Staging)" Height="30" Width="190" Margin="0,0,6,0" 
                                FontWeight="Bold" Background="#FFD97706" Foreground="White" Click="BtnPrepareDrafts_Click"/>

                        <Button x:Name="btnExtractPartners" Grid.Column="6" Content="👥 Trích xuất Đối tác" Height="30" Width="140" Margin="0,0,6,0" 
                                FontWeight="SemiBold" Background="#FF37474F" Foreground="White" Click="BtnExtractPartners_Click"/>

                        <Button x:Name="btnExtractItems" Grid.Column="7" Content="📦 Trích xuất Vật tư" Height="30" Width="135" Margin="0,0,6,0" 
                                FontWeight="SemiBold" Background="#FF00695C" Foreground="White" Click="BtnExtractItems_Click"/>

                        <Button x:Name="btnExportExcelJson" Grid.Column="8" Content="📊 Xuất Excel" Height="30" Width="100" Margin="0,0,6,0" 
                                FontWeight="SemiBold" Background="#FF0284C7" Foreground="White" Click="BtnExportExcelJson_Click"/>

                        <Button x:Name="btnOpenInOffice" Grid.Column="9" Content="📝 Sửa trong Office" Height="30" Width="140" Margin="0,0,6,0" 
                                FontWeight="Bold" Background="#FF6D28D9" Foreground="White" Click="BtnOpenInOffice_Click"/>

                        <Button x:Name="btnImportToDb" Grid.Column="10" Content="💾 Nhập thô CSDL" Height="30" Width="130" 
                                FontWeight="Bold" Background="#FF2E7D32" Foreground="White" Click="BtnImportToDb_Click"/>
                    </Grid>

                    <!-- 3. Master Grid (JSON) -->
                    <dxg:GridControl x:Name="gridMaster" Grid.Row="2" AutoGenerateColumns="None" SelectionMode="Row"
                                     SelectedItemChanged="GridMaster_SelectedItemChanged">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="viewMaster" ShowGroupPanel="True" ShowSearchPanelMode="Always" 
                                           ShowAutoFilterRow="True" AllowEditing="True"/>
                        </dxg:GridControl.View>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="IsSelected" Header="Chọn" Width="55" FixedWidth="True" AllowEditing="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:CheckEditSettings/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Direction" Header="Chiều" Width="70" FixedWidth="True" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="InvoiceSeries" Header="Ký hiệu" Width="95" FixedWidth="True" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="InvoiceNo" Header="Số HĐ" Width="90" FixedWidth="True" AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="d" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="InvoiceDate" Header="Ngày lập" Width="95" FixedWidth="True" AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings DisplayFormat="dd/MM/yyyy"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="SellerTaxCode" Header="MST Người bán" Width="110" FixedWidth="True" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="SellerName" Header="Tên Người bán" Width="220" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="BuyerTaxCode" Header="MST Người mua" Width="110" FixedWidth="True" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="BuyerName" Header="Tên Người mua" Width="180" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="TotalAmountWithoutTax" Header="Tiền chưa thuế" Width="120" FixedWidth="True" AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TotalTaxAmount" Header="Tiền thuế" Width="110" FixedWidth="True" AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TotalAmount" Header="Tổng thanh toán" Width="130" FixedWidth="True" AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="StatusDescription" Header="Trạng thái HĐ" Width="130" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="DbStatus" Header="CSDL" Width="90" FixedWidth="True" AllowEditing="False"/>
                        </dxg:GridControl.Columns>
                    </dxg:GridControl>

                    <!-- Splitter -->
                    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#FFE0E0E0" Cursor="SizeNS"/>

                    <!-- 4. Detail Grid (JSON) -->
                    <TabControl Grid.Row="4" Margin="0,4,0,0">
                        <TabItem Header="📦 Chi tiết Hàng hóa / Dịch vụ (hdhhdvu)">
                            <dxg:GridControl x:Name="gridDetails" AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView ShowGroupPanel="False" ShowSearchPanelMode="Never" AllowEditing="False"/>
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="LineNo" Header="STT" Width="50" FixedWidth="True"/>
                                    <dxg:GridColumn FieldName="ItemCode" Header="Mã hàng" Width="100" FixedWidth="True"/>
                                    <dxg:GridColumn FieldName="ItemName" Header="Tên hàng hóa, dịch vụ" Width="*"/>
                                    <dxg:GridColumn FieldName="UnitName" Header="ĐVT" Width="70" FixedWidth="True"/>
                                    <dxg:GridColumn FieldName="Quantity" Header="Số lượng" Width="90" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="UnitPrice" Header="Đơn giá" Width="110" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Amount" Header="Thành tiền" Width="120" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="TaxRate" Header="Thuế suất" Width="85" FixedWidth="True"/>
                                    <dxg:GridColumn FieldName="TaxAmount" Header="Tiền thuế" Width="110" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                        </TabItem>
                        <TabItem Header="📊 Phân loại theo Thuế suất (thttltsuat)">
                            <dxg:GridControl x:Name="gridTaxRates" AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView ShowGroupPanel="False" ShowSearchPanelMode="Never" AllowEditing="False"/>
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="TaxRate" Header="Thuế suất" Width="120"/>
                                    <dxg:GridColumn FieldName="AmountWithoutTax" Header="Tiền chưa thuế" Width="180">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="TaxAmount" Header="Tiền thuế GTGT" Width="180">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                        </TabItem>
                    </TabControl>

                    <!-- 5. Tab 1 Footer -->
                    <Grid Grid.Row="5" Margin="0,6,0,0">
                        <TextBlock x:Name="lblSummary" Text="Tổng số hóa đơn: 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================== -->
            <!-- TAB 2: DỮ LIỆU ĐÃ CHUẨN BỊ (PREPARED / STAGING)                  -->
            <!-- ============================================================== -->
            <TabItem Header="⚡ 2. Dữ liệu đã chuẩn bị (Prepared)">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Prepared Folder Bar -->
                    <Border Grid.Row="0" Background="#FFF5F5F5" Padding="8,6" CornerRadius="4" Margin="0,0,0,6" BorderBrush="#FFE0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Thư mục Đệm (Prepared):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <dxe:TextEdit x:Name="txtPreparedFolder" Grid.Column="1" Height="28" Margin="0,0,8,0" IsReadOnly="True"/>
                            <Button x:Name="btnBrowsePrepared" Grid.Column="2" Content="📁 Chọn thư mục..." Height="28" Width="130" Margin="0,0,8,0" Click="BtnBrowsePrepared_Click"/>
                            <Button x:Name="btnReloadPrepared" Grid.Column="3" Content="🔄 Nạp lại" Height="28" Width="100" Click="BtnReloadPrepared_Click"/>
                        </Grid>
                    </Border>

                    <!-- 2. Action Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnPreparedSelectAll" Grid.Column="0" Content="✔ Chọn tất cả" Height="28" Width="100" Margin="0,0,6,0" Click="BtnPreparedSelectAll_Click"/>
                        <Button x:Name="btnPreparedUnselectAll" Grid.Column="1" Content="✖ Bỏ chọn" Height="28" Width="85" Margin="0,0,12,0" Click="BtnPreparedUnselectAll_Click"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="lblPreparedStats" Text="Đã chọn: 0/0 bản nháp" FontWeight="SemiBold" Foreground="#FFD97706" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Button x:Name="btnOpenPreparedInOffice" Grid.Column="3" Content="📊 Xem/Sửa Office Studio" Height="30" Width="175" Margin="0,0,8,0" 
                                FontWeight="Bold" Background="#FF6D28D9" Foreground="White" Click="BtnOpenPreparedInOffice_Click"/>

                        <Button x:Name="btnApproveMasterData" Grid.Column="4" Content="📑 Duyệt tạo danh mục" Height="30" Width="160" Margin="0,0,8,0" 
                                FontWeight="Bold" Background="#FF0284C7" Foreground="White" Click="BtnApproveMasterData_Click"/>

                        <Button x:Name="btnDeletePrepared" Grid.Column="5" Content="🗑 Xóa nháp" Height="30" Width="95" Margin="0,0,8,0" 
                                FontWeight="SemiBold" Background="#FFC62828" Foreground="White" Click="BtnDeletePrepared_Click"/>

                        <Button x:Name="btnPostPreparedToDb" Grid.Column="6" Content="🚀 Nhập vào CSDL (Core)" Height="30" Width="175" 
                                FontWeight="Bold" Background="#FF2E7D32" Foreground="White" Click="BtnPostPreparedToDb_Click"/>
                    </Grid>

                    <!-- 3. Master Grid (Prepared) -->
                    <dxg:GridControl x:Name="gridPreparedMaster" Grid.Row="2" AutoGenerateColumns="None" SelectionMode="Row"
                                     SelectedItemChanged="GridPreparedMaster_SelectedItemChanged">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="viewPreparedMaster" ShowGroupPanel="True" ShowSearchPanelMode="Always" 
                                           ShowAutoFilterRow="True" AllowEditing="True"
                                           RowDoubleClick="ViewPreparedMaster_RowDoubleClick"/>
                        </dxg:GridControl.View>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="IsSelected" Header="Chọn" Width="55" FixedWidth="True" AllowEditing="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:CheckEditSettings/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Direction" Header="Chiều" Width="70" FixedWidth="True" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="InvoiceSeries" Header="Ký hiệu" Width="95" FixedWidth="True" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="InvoiceNo" Header="Số HĐ" Width="90" FixedWidth="True" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="InvoiceDate" Header="Ngày lập" Width="95" FixedWidth="True" AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings DisplayFormat="dd/MM/yyyy"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PartnerId" Header="Mã Đối tác" Width="110" FixedWidth="True" AllowEditing="True"/>
                            <dxg:GridColumn FieldName="PartnerName" Header="Tên Đối tác" Width="200" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="PartnerTaxCode" Header="MST Đối tác" Width="110" FixedWidth="True" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="TotalAmountWithoutTax" Header="Tiền chưa thuế" Width="120" FixedWidth="True" AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TotalTaxAmount" Header="Tiền thuế" Width="100" FixedWidth="True" AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TotalAmount" Header="Tổng cộng" Width="120" FixedWidth="True" AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PartnerMatchReason" Header="Căn cứ khớp Đối tác" Width="180" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="StatusText" Header="Trạng thái" Width="110" FixedWidth="True" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="DbStatus" Header="CSDL" Width="95" FixedWidth="True" AllowEditing="False"/>
                        </dxg:GridControl.Columns>
                    </dxg:GridControl>

                    <!-- Splitter -->
                    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#FFE0E0E0" Cursor="SizeNS"/>

                    <!-- 4. Detail Grid (Prepared) -->
                    <TabControl Grid.Row="4" Margin="0,4,0,0">
                        <TabItem Header="📦 Chi tiết Hàng hóa / Dịch vụ đã chuẩn bị">
                            <dxg:GridControl x:Name="gridPreparedDetails" AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView ShowGroupPanel="False" ShowSearchPanelMode="Never" AllowEditing="True"/>
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="LineNo" Header="STT" Width="45" FixedWidth="True" AllowEditing="False"/>
                                    <dxg:GridColumn FieldName="RawItemName" Header="Tên hàng gốc trên hóa đơn" Width="220" AllowEditing="False"/>
                                    <dxg:GridColumn FieldName="MaterialId" Header="Mã VT nội bộ" Width="110" FixedWidth="True" AllowEditing="True"/>
                                    <dxg:GridColumn FieldName="WarehouseId" Header="Mã Kho" Width="85" FixedWidth="True" AllowEditing="True"/>
                                    <dxg:GridColumn FieldName="DebitAccountId" Header="TK Nợ" Width="80" FixedWidth="True" AllowEditing="True"/>
                                    <dxg:GridColumn FieldName="Unit" Header="ĐVT" Width="65" FixedWidth="True" AllowEditing="False"/>
                                    <dxg:GridColumn FieldName="Quantity" Header="Số lượng" Width="80" FixedWidth="True" AllowEditing="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="UnitPrice" Header="Đơn giá" Width="100" FixedWidth="True" AllowEditing="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Amount" Header="Thành tiền" Width="110" FixedWidth="True" AllowEditing="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="VatRate" Header="Thuế %" Width="70" FixedWidth="True" AllowEditing="False"/>
                                    <dxg:GridColumn FieldName="VatAmount" Header="Tiền thuế" Width="100" FixedWidth="True" AllowEditing="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="MatchReason" Header="Căn cứ so khớp vật tư" Width="*" AllowEditing="False"/>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                        </TabItem>
                    </TabControl>

                    <!-- 5. Tab 2 Footer -->
                    <Grid Grid.Row="5" Margin="0,6,0,0">
                        <TextBlock x:Name="lblPreparedSummary" Text="Tổng số bản nháp: 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================== -->
            <!-- TAB 3: DỮ LIỆU TRONG CSDL (ĐÃ NẠP)                             -->
            <!-- ============================================================== -->
            <TabItem Header="🗄️ 3. Dữ liệu trong CSDL (Đã nạp)">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Background="#FFF5F5F5" Padding="8,6" CornerRadius="4" Margin="0,0,0,6" BorderBrush="#FFE0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Chiều:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <dxe:ComboBoxEdit x:Name="cboDbDirection" Grid.Column="1" Height="28" Margin="0,0,10,0" IsTextEditable="False"
                                              SelectedIndexChanged="FilterDbInvoices_Changed">
                                <dxe:ComboBoxEditItem Content="Tất cả" Tag="" IsSelected="True"/>
                                <dxe:ComboBoxEditItem Content="Mua vào" Tag="purchase"/>
                                <dxe:ComboBoxEditItem Content="Bán ra" Tag="sold"/>
                            </dxe:ComboBoxEdit>

                            <TextBlock Grid.Column="2" Text="Từ ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <dxe:DateEdit x:Name="dtDbFrom" Grid.Column="3" Height="28" Margin="0,0,10,0" 
                                          Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" MaskType="DateTime" AllowNullInput="False"
                                          EditValueChanged="FilterDbInvoices_Changed"/>

                            <TextBlock Grid.Column="4" Text="Đến ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <dxe:DateEdit x:Name="dtDbTo" Grid.Column="5" Height="28" Margin="0,0,10,0" 
                                          Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" MaskType="DateTime" AllowNullInput="False"
                                          EditValueChanged="FilterDbInvoices_Changed"/>

                            <TextBlock Grid.Column="6" Text="Tìm kiếm:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtDbKeyword" Grid.Column="7" Height="28" Margin="0,0,8,0" NullText="MST, Tên đối tác, Ký hiệu, Số HĐ..."
                                          KeyDown="TxtDbKeyword_KeyDown"/>

                            <Button x:Name="btnDbSearch" Grid.Column="8" Content="🔍 Tìm kiếm" Height="28" Width="95" Margin="0,0,6,0" Click="BtnDbSearch_Click"/>
                            <Button x:Name="btnDbRefresh" Grid.Column="9" Content="🔄 Làm mới" Height="28" Width="85" Margin="0,0,6,0" Click="BtnDbRefresh_Click"/>
                            <Button x:Name="btnDbExtractPartners" Grid.Column="10" Content="👥 Trích xuất Đối tác" Height="28" Width="140" 
                                    FontWeight="SemiBold" Background="#FF37474F" Foreground="White" Click="BtnDbExtractPartners_Click"/>
                            <Button x:Name="btnDbExtractItems" Grid.Column="11" Content="📦 Trích xuất Vật tư" Height="28" Width="140" 
                                    FontWeight="SemiBold" Background="#FF00695C" Foreground="White" Margin="6,0,0,0" Click="BtnDbExtractItems_Click"/>
                            <Button x:Name="btnDbExportExcel" Grid.Column="12" Content="📊 Xuất Excel" Height="28" Width="105" 
                                    FontWeight="SemiBold" Background="#FF0284C7" Foreground="White" Margin="6,0,0,0" Click="BtnDbExportExcel_Click"/>
                            <Button x:Name="btnDbOpenInOffice" Grid.Column="13" Content="📝 Sửa trong Office" Height="28" Width="145" 
                                    FontWeight="Bold" Background="#FF6D28D9" Foreground="White" Margin="6,0,0,0" Click="BtnDbOpenInOffice_Click"/>
                        </Grid>
                    </Border>

                    <!-- Master Grid DB -->
                    <dxg:GridControl x:Name="gridDbMaster" Grid.Row="1" AutoGenerateColumns="None" SelectionMode="Row"
                                     SelectedItemChanged="GridDbMaster_SelectedItemChanged">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="viewDbMaster" ShowGroupPanel="True" ShowSearchPanelMode="Always" 
                                           ShowAutoFilterRow="True" AllowEditing="False" ShowTotalSummary="True"/>
                        </dxg:GridControl.View>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem FieldName="InvoiceNo" SummaryType="Count" DisplayFormat="Số lượng: {0:N0}"/>
                            <dxg:GridSummaryItem FieldName="TotalAmountWithoutTax" SummaryType="Sum" DisplayFormat="Tiền hàng: {0:N0}"/>
                            <dxg:GridSummaryItem FieldName="TotalTaxAmount" SummaryType="Sum" DisplayFormat="Thuế: {0:N0}"/>
                            <dxg:GridSummaryItem FieldName="TotalAmount" SummaryType="Sum" DisplayFormat="Tổng cộng: {0:N0}"/>
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="DirectionDisplay" Header="Chiều" Width="75" FixedWidth="True"/>
                            <dxg:GridColumn FieldName="InvoiceSeries" Header="Ký hiệu" Width="95" FixedWidth="True"/>
                            <dxg:GridColumn FieldName="InvoiceNo" Header="Số HĐ" Width="90" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="d" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="InvoiceDate" Header="Ngày lập" Width="95" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings DisplayFormat="dd/MM/yyyy"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="SellerTaxCode" Header="MST Người bán" Width="110" FixedWidth="True"/>
                            <dxg:GridColumn FieldName="SellerName" Header="Tên Người bán" Width="220"/>
                            <dxg:GridColumn FieldName="BuyerTaxCode" Header="MST Người mua" Width="110" FixedWidth="True"/>
                            <dxg:GridColumn FieldName="BuyerName" Header="Tên Người mua" Width="180"/>
                            <dxg:GridColumn FieldName="TotalAmountWithoutTax" Header="Tiền chưa thuế" Width="120" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TotalTaxAmount" Header="Tiền thuế" Width="110" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TotalAmount" Header="Tổng thanh toán" Width="130" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="StatusDescription" Header="Trạng thái HĐ" Width="120"/>
                            <dxg:GridColumn FieldName="VoucherStatus" Header="Chứng từ KT" Width="110" FixedWidth="True"/>
                            <dxg:GridColumn FieldName="TaxAuthorityCode" Header="Mã CQT" Width="130"/>
                            <dxg:GridColumn FieldName="DownloadedAt" Header="Ngày nạp" Width="125" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings DisplayFormat="dd/MM/yyyy HH:mm"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                    </dxg:GridControl>

                    <!-- Splitter -->
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#FFE0E0E0" Cursor="SizeNS"/>

                    <!-- Detail Grid DB -->
                    <TabControl Grid.Row="3" Margin="0,4,0,0">
                        <TabItem Header="📦 Chi tiết Hàng hóa / Dịch vụ (hdhhdvu)">
                            <dxg:GridControl x:Name="gridDbDetails" AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView ShowGroupPanel="False" ShowSearchPanelMode="Never" AllowEditing="False"/>
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="LineNo" Header="STT" Width="50" FixedWidth="True"/>
                                    <dxg:GridColumn FieldName="ItemCode" Header="Mã hàng" Width="100" FixedWidth="True"/>
                                    <dxg:GridColumn FieldName="ItemName" Header="Tên hàng hóa, dịch vụ" Width="*"/>
                                    <dxg:GridColumn FieldName="UnitName" Header="ĐVT" Width="70" FixedWidth="True"/>
                                    <dxg:GridColumn FieldName="Quantity" Header="Số lượng" Width="90" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="UnitPrice" Header="Đơn giá" Width="110" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Amount" Header="Thành tiền" Width="120" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="TaxRate" Header="Thuế suất" Width="85" FixedWidth="True"/>
                                    <dxg:GridColumn FieldName="TaxAmount" Header="Tiền thuế" Width="110" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                        </TabItem>
                        <TabItem Header="📊 Phân loại theo Thuế suất (thttltsuat)">
                            <dxg:GridControl x:Name="gridDbTaxRates" AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView ShowGroupPanel="False" ShowSearchPanelMode="Never" AllowEditing="False"/>
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="TaxRate" Header="Thuế suất" Width="120"/>
                                    <dxg:GridColumn FieldName="AmountWithoutTax" Header="Tiền chưa thuế" Width="180">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="TaxAmount" Header="Tiền thuế GTGT" Width="180">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                        </TabItem>
                    </TabControl>

                    <!-- Row 4: Summary bar -->
                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <TextBlock x:Name="lblDbStats" Text="Tổng số: 0 hóa đơn trong CSDL" FontWeight="SemiBold" Foreground="#FF1565C0"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Window Bottom Bar -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lblWindowFooter" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF555555"/>
            <Button x:Name="btnClose" Grid.Column="1" Content="Đóng" Width="90" Height="28" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</base:BaseWindow>