<base:BaseDetailWindow 
    x:Class="NewaccNet.Wpf.AppSystem.TaxInvoice.TaxInvoiceDownloadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Tải Hóa Đơn Điện Tử từ Cổng Thuế"
    Width="620" Height="700"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📥 Tải Dữ Liệu Hóa Đơn Điện Tử" FontSize="20" FontWeight="Bold" Foreground="#FF0D47A1"/>
            <TextBlock Text="Kết nối cổng Tổng cục Thuế và lưu trữ tệp JSON/XML thô trên máy tính để xem trước" Foreground="#FF616161" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 1. Account Settings -->
        <GroupBox Grid.Row="1" Header="1. Tài khoản Cổng Thuế" Margin="0,0,0,10" FontWeight="SemiBold">
            <Grid Margin="8,8,8,8" TextElement.FontWeight="Normal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã số thuế:" VerticalAlignment="Center"/>
                <dxe:TextEdit x:Name="txtTaxCode" Grid.Row="0" Grid.Column="1" Height="28" Margin="0,0,8,6"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Mật khẩu:" VerticalAlignment="Center"/>
                <dxe:PasswordBoxEdit x:Name="txtPassword" Grid.Row="0" Grid.Column="3" Height="28" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Trạng thái:" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblTokenStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="Chưa kiểm tra Token" 
                           VerticalAlignment="Center" Foreground="#FFD32F2F" TextWrapping="Wrap" Margin="0,0,8,0"/>
                <Button x:Name="btnLogin" Grid.Row="1" Grid.Column="3" Content="Đăng nhập" Height="28" Click="BtnLogin_Click"/>
            </Grid>
        </GroupBox>

        <!-- 2. Scope & Options -->
        <GroupBox Grid.Row="2" Header="2. Phạm vi &amp; Tùy chọn tải" Margin="0,0,0,10" FontWeight="SemiBold">
            <Grid Margin="8,8,8,8" TextElement.FontWeight="Normal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Loại hóa đơn:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="rbPurchase" Content="Mua vào" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbSold" Content="Bán ra" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbBoth" Content="Cả mua vào &amp; bán ra" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Từ ngày:" VerticalAlignment="Center"/>
                <dxe:DateEdit x:Name="dtFrom" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,8,6" 
                              Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" MaskType="DateTime" AllowNullInput="False"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Đến ngày:" VerticalAlignment="Center"/>
                <dxe:DateEdit x:Name="dtTo" Grid.Row="1" Grid.Column="3" Height="28" Margin="0,0,0,6" 
                              Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" MaskType="DateTime" AllowNullInput="False"/>

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                    <dxe:CheckEdit x:Name="chkDetail" Content="Tải chi tiết hàng hóa (hdhhdvu)" IsChecked="True" Margin="0,0,16,0"/>
                    <dxe:CheckEdit x:Name="chkXml" Content="Tải tệp XML/ZIP gốc" IsChecked="False"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 3. Target Folder -->
        <GroupBox Grid.Row="3" Header="3. Thư mục lưu tệp JSON trên máy" Margin="0,0,0,10" FontWeight="SemiBold">
            <Grid Margin="8,8,8,8" TextElement.FontWeight="Normal">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <dxe:TextEdit x:Name="txtFolder" Grid.Column="0" Height="28" Margin="0,0,8,0"/>
                <Button x:Name="btnBrowseFolder" Grid.Column="1" Content="Duyệt..." Height="28" Click="BtnBrowseFolder_Click"/>
            </Grid>
        </GroupBox>

        <!-- 4. Progress & Log -->
        <GroupBox Grid.Row="4" Header="4. Tiến trình &amp; Nhật ký" FontWeight="SemiBold">
            <Grid Margin="8,8,8,8" TextElement.FontWeight="Normal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <dxe:ProgressBarEdit x:Name="progressBar" Grid.Row="0" Height="20" Minimum="0" Maximum="100" Margin="0,0,0,6"/>
                <TextBlock x:Name="lblProgressStatus" Grid.Row="1" Text="Sẵn sàng." Margin="0,0,0,6" Foreground="#FF1565C0"/>
                <TextBox x:Name="txtLog" Grid.Row="2" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                         FontFamily="Consolas" FontSize="11" Background="#FFF9F9F9"/>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnDownload" Content="▶ Bắt đầu tải" Width="120" Height="32" Margin="0,0,8,0" FontWeight="Bold" 
                    Background="#FF1976D2" Foreground="White" Click="BtnDownload_Click"/>
            <Button x:Name="btnOpenFolder" Content="📂 Mở thư mục" Width="110" Height="32" Margin="0,0,8,0" Click="BtnOpenFolder_Click"/>
            <Button x:Name="btnReview" Content="👁 Xem trước hóa đơn" Width="140" Height="32" Margin="0,0,8,0" Click="BtnReview_Click"/>
            <Button x:Name="btnClose" Content="Đóng" Width="80" Height="32" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</base:BaseDetailWindow>
