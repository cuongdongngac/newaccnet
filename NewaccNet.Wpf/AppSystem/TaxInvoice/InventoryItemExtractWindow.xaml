<base:BaseWindow
    x:Class="NewaccNet.Wpf.AppSystem.TaxInvoice.InventoryItemExtractWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Trích Xuất &amp; Sinh Mã Danh Mục Vật Tư Từ Hóa Đơn Điện Tử"
    Width="1180" Height="700"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#FFE8EAF6" BorderBrush="#FFC5CAE9" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="📦 Tự động trích xuất Danh mục Vật tư / Hàng hóa từ Hóa đơn điện tử" FontWeight="Bold" FontSize="14" Foreground="#FF1A237E"/>
                <TextBlock Text="Hệ thống tự động lọc các dòng chi tiết hàng hóa, gom nhóm theo Tên &amp; ĐVT, gợi ý sinh Mã vật tư theo quy tắc, đối chiếu với CSDL hiện hành và xuất tệp Excel để nhập vào Danh mục vật tư." 
                           Foreground="#FF3949AB" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 2. Rule Configuration Bar -->
        <Border Grid.Row="1" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Quy tắc sinh mã:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <dxe:ComboBoxEdit x:Name="cboNamingRule" Grid.Column="1" Height="28" Margin="0,0,12,0" IsTextEditable="False"
                                  SelectedIndexChanged="CboNamingRule_SelectedIndexChanged">
                    <dxe:ComboBoxEditItem Content="1. Viết tắt chữ cái đầu (VD: Xi măng PCB40 -> XMHTPCB40)" IsSelected="True"/>
                    <dxe:ComboBoxEditItem Content="2. Tiền tố + Số tự tăng (VD: VT0001, VT0002...)"/>
                    <dxe:ComboBoxEditItem Content="3. Ưu tiên mã trên hóa đơn (ItemCode)"/>
                    <dxe:ComboBoxEditItem Content="4. Tên viết liền không dấu (VD: XIMANGPCB40)"/>
                </dxe:ComboBoxEdit>

                <TextBlock Grid.Column="2" Text="Tiền tố:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <dxe:TextEdit x:Name="txtPrefix" Grid.Column="3" Height="28" Text="VT" MaxLength="10" Margin="0,0,12,0"/>

                <dxe:CheckEdit x:Name="chkKeepExistingDbCodes" Grid.Column="4" Content="Giữ nguyên mã vật tư đã có trong CSDL" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button x:Name="btnApplyRule" Grid.Column="6" Content="⚡ Áp dụng quy tắc sinh mã" Height="28" Width="180" 
                        FontWeight="SemiBold" Background="#FF455A64" Foreground="White" Click="BtnApplyRule_Click"/>
            </Grid>
        </Border>

        <!-- 3. Action Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnSelectNew" Grid.Column="0" Content="✔ Chọn vật tư MỚI" Height="28" Width="140" Margin="0,0,6,0" Click="BtnSelectNew_Click"/>
            <Button x:Name="btnSelectAll" Grid.Column="1" Content="✔ Chọn tất cả" Height="28" Width="95" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
            <Button x:Name="btnUnselectAll" Grid.Column="2" Content="✖ Bỏ chọn" Height="28" Width="85" Margin="0,0,10,0" Click="BtnUnselectAll_Click"/>

            <TextBlock Grid.Column="3" Text="Lọc:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <dxe:ComboBoxEdit x:Name="cboFilterStatus" Grid.Column="4" Height="28" Margin="0,0,10,0" IsTextEditable="False"
                              SelectedIndexChanged="CboFilterStatus_SelectedIndexChanged">
                <dxe:ComboBoxEditItem Content="Tất cả vật tư" IsSelected="True"/>
                <dxe:ComboBoxEditItem Content="Chỉ vật tư MỚI"/>
                <dxe:ComboBoxEditItem Content="Chỉ vật tư ĐÃ CÓ / ĐÃ MAP"/>
            </dxe:ComboBoxEdit>

            <!-- 🤖 AI Smart Mapping Button -->
            <Button x:Name="btnAiSuggest" Grid.Column="5" Content="🤖 AI Gợi ý Mapping" Height="28" Width="165" 
                    FontWeight="Bold" Background="#FF6D28D9" Foreground="White" Margin="0,0,10,0" Click="BtnAiSuggest_Click"/>

            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="lblStats" Text="Đang xử lý dữ liệu..." FontWeight="SemiBold" Foreground="#FF0D47A1" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Open in Office Studio Button (Primary Action) -->
            <Button x:Name="btnOpenInOffice" Grid.Column="7" Content="🏢 Mở trong Office" Height="30" Width="140" Margin="0,0,8,0"
                    FontWeight="Bold" Background="#FF0D9488" Foreground="White" Click="BtnOpenInOffice_Click"/>

            <!-- Export to Excel Button -->
            <Button x:Name="btnExportExcel" Grid.Column="8" Content="📥 Xuất tệp Excel" Height="30" Width="130" Margin="0,0,8,0"
                    FontWeight="Bold" Background="#FF1976D2" Foreground="White" Click="BtnExportExcel_Click"/>

            <!-- Direct DB Insert Button -->
            <Button x:Name="btnSaveToDb" Grid.Column="9" Content="💾 Lưu trực tiếp CSDL" Height="30" Width="150" 
                    FontWeight="Bold" Background="#FF2E7D32" Foreground="White" Click="BtnSaveToDb_Click"/>
        </Grid>

        <!-- 4. Master Grid -->
        <dxg:GridControl x:Name="gridItems" Grid.Row="3" AutoGenerateColumns="None" SelectionMode="Row">
            <dxg:GridControl.View>
                <dxg:TableView x:Name="viewItems" ShowGroupPanel="True" ShowSearchPanelMode="Always" 
                               ShowAutoFilterRow="True" AllowEditing="True" ShowTotalSummary="True"/>
            </dxg:GridControl.View>
            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem FieldName="MaterialId" SummaryType="Count" DisplayFormat="Số mặt hàng: {0:N0}"/>
                <dxg:GridSummaryItem FieldName="OccurrenceCount" SummaryType="Sum" DisplayFormat="Tổng lần xuất hiện: {0:N0}"/>
            </dxg:GridControl.TotalSummary>
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="IsSelected" Header="Chọn" Width="55" FixedWidth="True" AllowEditing="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="MaterialId" Header="Mã Nội Bộ (Đề xuất)" Width="150" FixedWidth="True" AllowEditing="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaxLength="20"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="DbStatus" Header="Trạng thái / Gợi ý" Width="170" FixedWidth="True" AllowEditing="False"/>
                <dxg:GridColumn FieldName="SuggestedInternalName" Header="Vật tư nội bộ tương ứng" Width="200" AllowEditing="False"/>
                <dxg:GridColumn FieldName="MaterialName" Header="Tên Mặt Hàng Trên HĐ" Width="*" AllowEditing="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaxLength="255"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Unit" Header="Đơn Vị Tính" Width="85" FixedWidth="True" AllowEditing="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaxLength="10"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="CategoryId" Header="Nhóm Vật Tư" Width="135" AllowEditing="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:ComboBoxEditSettings x:Name="cboCategories" ValueMember="Categoryid" DisplayMember="Categoryname" AutoComplete="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="MatchReason" Header="Lý do AI / Ghi chú" Width="220" AllowEditing="False"/>
                <dxg:GridColumn FieldName="OriginalItemCode" Header="Mã trên HĐ" Width="95" FixedWidth="True" AllowEditing="False"/>
                <dxg:GridColumn FieldName="OccurrenceCount" Header="Số lần XH" Width="75" FixedWidth="True" AllowEditing="False">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="d" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="SampleUnitPrice" Header="Đơn giá mẫu" Width="105" FixedWidth="True" AllowEditing="False">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="SampleInvoice" Header="Hóa đơn mẫu" Width="180" AllowEditing="False"/>
            </dxg:GridControl.Columns>
        </dxg:GridControl>

        <!-- 5. Footer -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lblFooter" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF616161"/>
            <Button x:Name="btnClose" Grid.Column="1" Content="Đóng" Width="90" Height="28" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</base:BaseWindow>
