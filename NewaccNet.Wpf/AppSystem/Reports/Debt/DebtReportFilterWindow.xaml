<base:BaseReportFilterWindow
    x:Class="NewaccNet.Wpf.AppSystem.Reports.Debt.DebtReportFilterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxs="clr-namespace:NewaccNet.Wpf.Controls.Search"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Báo Cáo Công Nợ"
    SizeToContent="Height" Width="560"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    WindowStyle="ToolWindow">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📊 Báo Cáo Công Nợ" FontSize="22" FontWeight="Bold" Foreground="#FF0D47A1"/>
            <TextBlock Text="Vui lòng chọn tài khoản, đối tượng, nội dung công nợ và loại báo cáo cần kết xuất"
                       Foreground="#FF616161" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 1. Tài khoản công nợ & Kỳ báo cáo -->
        <GroupBox Grid.Row="1" Header="1. Tài khoản &amp; Kỳ báo cáo" Margin="0,0,0,10" FontWeight="SemiBold">
            <StackPanel Margin="8,8,8,6" TextElement.FontWeight="Normal">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tài khoản công nợ:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <dxg:LookUpEdit x:Name="lkAccount" Grid.Column="1" Height="28"
                                    ValueMember="AccountId"
                                    IsTextEditable="True"
                                    ProcessNewValue="LkAccount_ProcessNewValue"
                                    EditValueChanged="LkAccount_EditValueChanged">
                        <dxmvvm:Interaction.Behaviors>
                            <dxs:SearchLookUpBehavior CodeField="AccountId"
                                                      NameField="AccountName"
                                                      CodeHeader="Số TK"
                                                      NameHeader="Tên tài khoản"
                                                      Display="Code"
                                                      SearchMode="All"/>
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:LookUpEdit>
                </Grid>

                <TextBlock x:Name="lblAccountName" Text="Toàn bộ tài khoản công nợ"
                           Foreground="#FF1565C0" FontStyle="Italic" FontWeight="SemiBold"
                           Margin="115,0,0,8" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Width="115" FontWeight="SemiBold"/>
                    <base:AppDateEdit x:Name="dtFromDate" Width="155" Height="28"/>
                    <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Width="75" Margin="18,0,0,0" FontWeight="SemiBold"/>
                    <base:AppDateEdit x:Name="dtToDate" Width="155" Height="28"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 2. Bộ lọc Đối tượng & Loại hình công nợ (CheckedComboBox gọn gàng) -->
        <GroupBox Grid.Row="2" Header="2. Đối tượng &amp; Nội dung công nợ" Margin="0,0,0,10" FontWeight="SemiBold">
            <StackPanel Margin="8,8,8,6" TextElement.FontWeight="Normal">

                <!-- Đối tượng công nợ -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Chọn đối tượng công nợ (Để trống = In tất cả):" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblPartnerSelected" Grid.Column="1" Text="Tất cả" Foreground="#FF1565C0" FontSize="11.5" FontWeight="SemiBold"/>
                </Grid>
                <dxe:ComboBoxEdit x:Name="cboSelectedPartners"
                                  DisplayMember="DisplayText"
                                  ValueMember="Code"
                                  Height="28"
                                  Margin="0,0,0,10"
                                  NullText="Tất cả đối tượng công nợ..."
                                  IncrementalFiltering="True"
                                  FilterCondition="Contains"
                                  ImmediatePopup="True"
                                  ValidateOnTextInput="False"
                                  EditValueChanged="CboSelectedPartners_EditValueChanged">
                    <dxe:ComboBoxEdit.StyleSettings>
                        <dxe:CheckedComboBoxStyleSettings/>
                    </dxe:ComboBoxEdit.StyleSettings>
                </dxe:ComboBoxEdit>

                <!-- Nội dung / Loại hình công nợ -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Chọn nội dung / loại hình công nợ (Để trống = In tất cả):" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblDebtTypeSelected" Grid.Column="1" Text="Tất cả" Foreground="#FF1565C0" FontSize="11.5" FontWeight="SemiBold"/>
                </Grid>
                <dxe:ComboBoxEdit x:Name="cboSelectedDebtTypes"
                                  DisplayMember="DisplayText"
                                  ValueMember="Code"
                                  Height="28"
                                  Margin="0,0,0,8"
                                  NullText="Tất cả nội dung công nợ..."
                                  IncrementalFiltering="True"
                                  FilterCondition="Contains"
                                  ImmediatePopup="True"
                                  ValidateOnTextInput="False"
                                  EditValueChanged="CboSelectedDebtTypes_EditValueChanged">
                    <dxe:ComboBoxEdit.StyleSettings>
                        <dxe:CheckedComboBoxStyleSettings/>
                    </dxe:ComboBoxEdit.StyleSettings>
                </dxe:ComboBoxEdit>

                <!-- Tùy chọn Tự động lọc chéo -->
                <dxe:CheckEdit x:Name="chkAutoFilter"
                               Content="Tự động lọc Đối tượng &amp; Nội dung theo phát sinh giao dịch"
                               IsChecked="False"
                               ToolTip="Khi bật: chỉ hiển thị các Đối tượng và Nội dung công nợ thực sự có giao dịch phát sinh với Tài khoản / Đối tượng đang chọn"
                               EditValueChanged="ChkAutoFilter_EditValueChanged"/>
            </StackPanel>
        </GroupBox>

        <!-- 3. Loại báo cáo & Sắp xếp -->
        <GroupBox Grid.Row="3" Header="3. Loại báo cáo &amp; Cơ chế sắp xếp" Margin="0,0,0,10" FontWeight="SemiBold">
            <StackPanel Margin="8,8,8,6" TextElement.FontWeight="Normal">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Loại báo cáo:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <dxe:ComboBoxEdit x:Name="cboReportType" Grid.Row="0" Grid.Column="1" Height="28"
                                      IsTextEditable="False"
                                      DisplayMember="Name" ValueMember="Code"
                                      SelectedIndexChanged="CboReportType_SelectedIndexChanged"/>

                    <TextBlock x:Name="lblCurrency" Grid.Row="2" Grid.Column="0" Text="Loại ngoại tệ:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF757575"/>
                    <dxg:LookUpEdit x:Name="lkCurrency" Grid.Row="2" Grid.Column="1" Height="28"
                                    ValueMember="CurrencyId"
                                    NullText="Chọn mã ngoại tệ (USD, EUR...)"
                                    IsTextEditable="True"
                                    IsEnabled="False">
                        <dxmvvm:Interaction.Behaviors>
                            <dxs:SearchLookUpBehavior CodeField="CurrencyId"
                                                      NameField="CurrencyName"
                                                      CodeHeader="Mã NT"
                                                      NameHeader="Tên ngoại tệ"
                                                      Display="Code"
                                                      SearchMode="All"/>
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:LookUpEdit>
                </Grid>

                <TextBlock Text="Cơ chế sắp xếp / Gom nhóm:" FontWeight="SemiBold" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,2">
                    <RadioButton x:Name="radSortByPartner" Content="Đối tượng &#x2192; Nội dung công nợ"
                                 IsChecked="True" Margin="0,0,24,0"
                                 Checked="SortRadio_Changed"/>
                    <RadioButton x:Name="radSortByDebtType" Content="Nội dung &#x2192; Đối tượng công nợ"
                                 Checked="SortRadio_Changed"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Lời nhắc -->
        <Border Grid.Row="4" Background="#FFE8F5E9" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
            <TextBlock Foreground="#FF2E7D32" TextWrapping="Wrap"
                       Text="💡 Mẹo: Trên Báo cáo Tổng hợp, nhấp chuột vào Nhóm hoặc Dòng để mở ngay Báo cáo Chi tiết tương ứng (không cần tính lại). Trên Báo cáo Chi tiết, nhấp vào dòng để mở Chứng từ gốc."/>
        </Border>

        <!-- Thanh nút chức năng dưới cùng -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <dx:SimpleButton x:Name="btnCheck" Content="Kiểm tra" Width="100" Height="32" Margin="0,0,8,0"
                             Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_validation.svg'}"
                             Click="BtnCheck_Click"/>

            <dx:SimpleButton x:Name="btnInterest" Content="Tính lãi" Width="100" Height="32" Margin="0,0,8,0"
                             Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_transition.svg'}"
                             Click="BtnInterest_Click"/>

            <Button x:Name="btnClose" Content="Kết thúc (Esc)" Width="110" Height="32" Margin="0,0,8,0"
                    IsCancel="True" Click="BtnClose_Click"/>

            <Button x:Name="btnReport" Content="OK — Xem báo cáo (Enter)" Width="180" Height="32"
                    Background="#FF1565C0" Foreground="White" FontWeight="Bold"
                    IsDefault="True" Click="BtnReport_Click"/>
        </StackPanel>
    </Grid>
</base:BaseReportFilterWindow>
