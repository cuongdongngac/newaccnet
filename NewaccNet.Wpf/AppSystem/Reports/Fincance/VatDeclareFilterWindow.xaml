<base:BaseWindow
    x:Class="NewaccNet.Wpf.AppSystem.Reports.Fincance.VatDeclareFilterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Tờ Khai Thuế VAT (Mẫu số 01/GTGT)"
    SizeToContent="Height" Width="560"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    WindowStyle="ToolWindow"
    Loaded="Window_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="📄 Tờ Khai Thuế VAT (Mẫu 01/GTGT)" FontSize="20" FontWeight="Bold" Foreground="#FF0D47A1"/>
            <TextBlock Text="Vui lòng chọn khoảng thời gian và tiêu đề kỳ báo cáo" Foreground="#FF616161" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Kỳ báo cáo -->
        <GroupBox Grid.Row="1" Header="Kỳ báo cáo" Margin="0,0,0,14" FontWeight="SemiBold">
            <StackPanel Orientation="Vertical" Margin="8,8,8,4" TextElement.FontWeight="Normal">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Width="80"/>
                    <dxe:DateEdit x:Name="dtFromDate" Width="140" Height="28" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True"/>
                    <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Width="80" Margin="20,0,0,0"/>
                    <dxe:DateEdit x:Name="dtToDate" Width="140" Height="28" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tiêu đề:" VerticalAlignment="Center" Width="80"/>
                    <dxe:TextEdit x:Name="txtReportTitle" Width="380" Height="28" NullText="TỜ KHAI THUẾ VAT (MẪU SỐ 01/GTGT)"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Nút bấm -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnExportJson" Content="Xuất JSON" Width="110" Height="32" Margin="0,0,8,0"
                    Background="#FFF57F17" Foreground="White" FontWeight="Bold"
                    Click="BtnExportJson_Click"/>
            <Button x:Name="btnCancel" Content="Đóng" Width="90" Height="32" Margin="0,0,8,0"
                    IsCancel="True" Click="BtnCancel_Click"/>
            <Button x:Name="btnOK" Content="Xem báo cáo" Width="130" Height="32"
                    Background="#FF1565C0" Foreground="White" FontWeight="Bold"
                    IsDefault="True" Click="BtnOK_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>
