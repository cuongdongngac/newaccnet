<UserControl x:Class="NewaccNet.Wpf.AppSystem.Reports.DetailTrialBalance.StockFilterContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NewaccNet.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="360" d:DesignHeight="45">
    <StackPanel Orientation="Vertical">
        <Grid Margin="0,3,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cổ phiếu:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
            <ctrl:MultiSelectComboBox Grid.Column="1" x:Name="cboStock" Height="26"
                                      KeyMemberPath="Stockid" DisplayMemberPath="DisplayText"
                                      Placeholder="* (Tất cả cổ phiếu)"/>
        </Grid>
    </StackPanel>
</UserControl>
