<base:BaseWindow
    x:Class="NewaccNet.Wpf.AppSystem.Reports.DetailTrialBalance.DetailTrialBalanceFilterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxs="clr-namespace:NewaccNet.Wpf.Controls.Search"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Sổ cái / Sổ chi tiết tài khoản"
    SizeToContent="Height" Width="660"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    WindowStyle="ToolWindow"
    Loaded="Window_Loaded">

    <Grid>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <!-- 0: Tiêu đề đỏ -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Hàng tài khoản & ngày tháng -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Vùng Container linh hoạt theo loại TK -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Các tùy chọn Checkbox -->
                <RowDefinition Height="Auto"/>
                <!-- 4: Thanh nút bấm Bottom -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0: Tiêu đề động dạng chữ đỏ theo ảnh mẫu -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
                <TextBlock x:Name="txtTitle" Text="Sổ cái cho tài khoản" 
                           FontSize="16" FontWeight="Bold" Foreground="#D32F2F"/>
            </StackPanel>

            <!-- 1: Tài khoản & Thời gian (Từ ngày - Đến ngày) -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Loại TK (Phân hệ) & Tài khoản -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Loại TK:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
                        <dxe:ComboBoxEdit Grid.Column="1" x:Name="cboCategory" Height="26"
                                          ValueMember="Code" DisplayMember="DisplayName"
                                          IsTextEditable="False"
                                          EditValueChanged="CboCategory_EditValueChanged"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tài khoản:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
                        <dxg:LookUpEdit Grid.Column="1" x:Name="lkAccount" Height="26" 
                                        ValueMember="AccountId"
                                        IsTextEditable="True"
                                        EditValueChanged="LkAccount_EditValueChanged">
                            <dxmvvm:Interaction.Behaviors>
                                <dxs:SearchLookUpBehavior CodeField="AccountId"
                                                          NameField="AccountName"
                                                          CodeHeader="Số TK"
                                                          NameHeader="Tên tài khoản"
                                                          Display="Code" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:LookUpEdit>
                    </Grid>
                </StackPanel>

                <!-- Cột phải: Từ ngày / Đến ngày -->
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Từ ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
                        <dxe:DateEdit Grid.Column="1" x:Name="dtFrom" Height="26" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Đến ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
                        <dxe:DateEdit Grid.Column="1" x:Name="dtTo" Height="26" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 2: Vùng Container linh hoạt theo đối tượng (Dynamic Container Presenter) -->
            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,6,0,10">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="lblCategoryIndicator" Text="Đối tượng theo dõi chi tiết:" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,6"/>
                    <ContentControl x:Name="filterContainerPresenter"/>
                </StackPanel>
            </Border>

            <!-- 3: Các tùy chọn Checkbox -->
            <StackPanel Grid.Row="3" Orientation="Vertical" Margin="8,4,0,14">
                <dxe:CheckEdit x:Name="chkAutoFilter" Content="Tự động lọc" FontSize="13"/>
            </StackPanel>

            <!-- 4: Thanh nút bấm Bottom (Nút In/Xem & Nút Đóng) -->
            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Nút Đóng -->
                    <Button x:Name="btnCancel" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True" Click="BtnCancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_close.svg'}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Đóng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Nút In / Xem báo cáo -->
                    <Button x:Name="btnOK" Width="140" Height="30" Background="#1976D2" Foreground="White" FontWeight="Bold" IsDefault="True" Click="BtnOK_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/print/print.svg'}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Xem / In sổ" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Lớp phủ thông báo tiến trình WaitIndicator chuẩn DevExpress -->
        <dx:WaitIndicator x:Name="waitIndicator" DeferedVisibility="False" Content="Đang tổng hợp số liệu báo cáo, vui lòng chờ...">
            <dx:WaitIndicator.ContentTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="10,6">
                        <TextBlock Text="Đang xử lý dữ liệu..." FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock Text="{Binding}" Margin="0,4,0,0" FontSize="12" Foreground="#555"/>
                    </StackPanel>
                </DataTemplate>
            </dx:WaitIndicator.ContentTemplate>
        </dx:WaitIndicator>
    </Grid>
</base:BaseWindow>
