<UserControl x:Class="NewaccNet.Wpf.AppSystem.Reports.DetailTrialBalance.CostFilterContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NewaccNet.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="360" d:DesignHeight="80">
    <StackPanel Orientation="Vertical">
        <!-- Đối tượng chi phí -->
        <Grid Margin="0,3,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Đối tượng CP:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
            <ctrl:MultiSelectComboBox Grid.Column="1" x:Name="cboCostObject" Height="26"
                                      KeyMemberPath="Id" DisplayMemberPath="DisplayText"
                                      Placeholder="* (Tất cả đối tượng CP)"/>
        </Grid>

        <!-- Yếu tố chi phí -->
        <Grid Margin="0,3,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Yếu tố CP:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
            <ctrl:MultiSelectComboBox Grid.Column="1" x:Name="cboCostElement" Height="26"
                                      KeyMemberPath="Id" DisplayMemberPath="DisplayText"
                                      Placeholder="* (Tất cả yếu tố CP)"/>
        </Grid>
    </StackPanel>
</UserControl>
