<base:BaseWindow x:Class="NewaccNet.Wpf.AppSystem.AssetDepreciation.AssetDepreciationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
        xmlns:dxs="clr-namespace:NewaccNet.Wpf.Controls.Search"
        xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
        Title="Bảng phân bổ khấu hao"
        Height="640" Width="1000" MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- KHỐI 1: THAM SỐ (dùng AppDateEdit đồng nhất độ rộng và LookUpEdit + SearchLookUpBehavior 2 cột Mã | Tên chuẩn) -->
        <dxlc:LayoutControl Grid.Row="0" Orientation="Vertical" Padding="12,10,12,6" ItemLabelsAlignment="Local">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="Từ ngày:" HorizontalAlignment="Left">
                    <base:AppDateEdit x:Name="dtBeginDate" Width="125" EditValueChanged="Param_Changed"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Đến ngày:" HorizontalAlignment="Left" Margin="15,0,0,0">
                    <base:AppDateEdit x:Name="dtEndDate" Width="125" EditValueChanged="Param_Changed"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Tài khoản khấu hao:" Width="260" Margin="15,0,0,0">
                    <dxg:LookUpEdit x:Name="lueDepAccount"
                                    ValueMember="AccountId"
                                    IsTextEditable="True"
                                    EditValueChanged="DepAccount_Changed">
                        <dxmvvm:Interaction.Behaviors>
                            <dxs:SearchLookUpBehavior Display="Code" SearchMode="All"/>
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Nguồn:" HorizontalAlignment="Stretch" Margin="15,0,0,0">
                    <dxg:LookUpEdit x:Name="lueSource"
                                    ValueMember="Srcode"
                                    IsTextEditable="True"
                                    AllowNullInput="True"
                                    EditValueChanged="Param_Changed">
                        <dxmvvm:Interaction.Behaviors>
                            <dxs:SearchLookUpBehavior Display="Name" SearchMode="All"/>
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,6,0,0">
                <dxlc:LayoutItem Label="Yếu tố chi phí:" HorizontalAlignment="Stretch">
                    <dxg:LookUpEdit x:Name="lueCostElement"
                                    ValueMember="Id"
                                    IsTextEditable="True"
                                    EditValueChanged="Param_Changed">
                        <dxmvvm:Interaction.Behaviors>
                            <dxs:SearchLookUpBehavior Display="Name" SearchMode="All"/>
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Lý do:" HorizontalAlignment="Stretch" Margin="15,0,0,0">
                    <dxg:LookUpEdit x:Name="lueReason"
                                    ValueMember="Reasonid"
                                    IsTextEditable="True"
                                    EditValueChanged="Param_Changed">
                        <dxmvvm:Interaction.Behaviors>
                            <dxs:SearchLookUpBehavior Display="Name" SearchMode="All"/>
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,6,0,0">
                <dxlc:LayoutItem Label="Nội dung chứng từ:" HorizontalAlignment="Stretch">
                    <dxe:TextEdit x:Name="txtContents" EditValueChanged="Param_Changed"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

        <!-- KHỐI 2: LƯỚI TÀI SẢN. Dùng AppDetailTableView chuẩn (tắt nút xóa dòng) -->
        <GroupBox Grid.Row="1" Header="Danh sách tài sản trích khấu hao" Margin="10,2,10,2">
            <dxg:GridControl x:Name="gridRows">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="AssetName" Header="Tên tài sản" Width="*" MinWidth="220" ReadOnly="True"/>
                    <dxg:GridColumn FieldName="SourceCode" Header="Nguồn" Width="90" FixedWidth="True" ReadOnly="True"/>
                    <dxg:GridColumn FieldName="Quantity" Header="SL" Width="70" FixedWidth="True" ReadOnly="True"/>
                    <dxg:GridColumn FieldName="Selected" Header="KH" Width="45" FixedWidth="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:CheckEditSettings/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="RestValue" Header="Trị giá còn lại" Width="140" FixedWidth="True" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings DisplayFormat="#,##0" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="DepAmount" Header="Số tiền khấu hao" Width="150" FixedWidth="True" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings DisplayFormat="#,##0" HorizontalContentAlignment="Right"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <base:AppDetailTableView x:Name="viewRows" ShowRowDeleteButton="False" ShowGroupPanel="False"
                                             AllowEditing="True" AutoWidth="False" ShowTotalSummary="True"
                                             NavigationStyle="Cell" EditorShowMode="MouseDown"/>
                </dxg:GridControl.View>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem FieldName="RestValue" SummaryType="Sum" DisplayFormat="Tổng: {0:#,##0}"/>
                    <dxg:GridSummaryItem FieldName="DepAmount" SummaryType="Sum" DisplayFormat="Tổng: {0:#,##0}"/>
                </dxg:GridControl.TotalSummary>
            </dxg:GridControl>
        </GroupBox>

        <!-- KHỐI 3: NÚT HÀNH ĐỘNG & TRẠNG THÁI -->
        <Border Grid.Row="2" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblStatus" Grid.Column="0"
                           Text="Chọn kỳ khấu hao rồi bấm 'Tính toán'."
                           FontSize="13" FontWeight="SemiBold" Foreground="#FF616161"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <dx:SimpleButton x:Name="btnCalculate" Content="Tính toán" Width="100" Height="32"
                                     Click="BtnCalculate_Click"/>
                    <dx:SimpleButton x:Name="btnPost" Content="Khấu hao" Width="100" Height="32" Margin="8,0,0,0"
                                     FontWeight="Bold" IsEnabled="False" Click="BtnPost_Click"/>
                    <dx:SimpleButton x:Name="btnRestore" Content="Khôi phục" Width="100" Height="32" Margin="8,0,0,0"
                                     IsEnabled="False" Click="BtnRestore_Click"/>
                    <dx:SimpleButton x:Name="btnViewVoucher" Content="Xem lại" Width="100" Height="32" Margin="8,0,0,0"
                                     IsEnabled="False" Click="BtnViewVoucher_Click"/>
                    <dx:SimpleButton x:Name="btnPrint" Content="In" Width="80" Height="32" Margin="8,0,0,0"
                                     Click="BtnPrint_Click"/>
                    <dx:SimpleButton x:Name="btnClose" Content="Kết thúc" Width="100" Height="32" Margin="8,0,0,0"
                                     Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:BaseWindow>
