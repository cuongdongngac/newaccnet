<base:BaseWindow
    x:Class="NewaccNet.Wpf.AppSystem.Directory.CategoryExcelImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Nhập Danh Mục Từ Tệp Excel (Ghép Cột Động)"
    Width="1100" Height="700"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Selection & File Bar -->
        <Border Grid.Row="0" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Chọn Danh mục:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <dxe:ComboBoxEdit x:Name="cboCategoryType" Grid.Row="0" Grid.Column="1" Height="28" Margin="0,0,16,0" IsTextEditable="False"
                                  SelectedIndexChanged="CboCategoryType_SelectedIndexChanged">
                    <dxe:ComboBoxEditItem Content="1. Đối tượng công nợ (Partner)" Tag="Partner" IsSelected="True"/>
                    <dxe:ComboBoxEditItem Content="2. Loại công nợ (DebtType)" Tag="DebtType"/>
                    <dxe:ComboBoxEditItem Content="3. Vật tư, Hàng hóa (Stock)" Tag="Stock"/>
                    <dxe:ComboBoxEditItem Content="4. Đối tượng chi phí (CostObject)" Tag="CostObject"/>
                    <dxe:ComboBoxEditItem Content="5. Yếu tố chi phí (CostElement)" Tag="CostElement"/>
                </dxe:ComboBoxEdit>

                <Button x:Name="btnDownloadTemplate" Grid.Row="0" Grid.Column="4" Content="📥 Xuất tệp mẫu Excel" Height="28" Width="150" Margin="0,0,8,0"
                        Click="BtnDownloadTemplate_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tệp Excel nguồn:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,8,8,0"/>
                <dxe:TextEdit x:Name="txtExcelPath" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="28" Margin="0,8,8,0" NullText="Chọn tệp Excel bất kỳ (.xlsx)..."/>
                <Button x:Name="btnBrowseExcel" Grid.Row="1" Grid.Column="4" Content="📁 Chọn tệp Excel..." Height="28" Width="150" Margin="0,8,8,0"
                        Click="BtnBrowseExcel_Click"/>
                <Button x:Name="btnReadExcel" Grid.Row="1" Grid.Column="5" Content="🔄 Đọc lại" Height="28" Width="90" Margin="0,8,0,0"
                        Click="BtnReadExcel_Click"/>
            </Grid>
        </Border>

        <!-- 2. Dynamic Column Mapping Panel -->
        <GroupBox x:Name="grpMapping" Grid.Row="1" Header="2. Ghép nối cột thông minh (Dynamic Column Mapping) - Tự động nhận diện hoặc chọn cột tùy ý" 
                  Margin="0,0,0,8" FontWeight="SemiBold">
            <Grid Margin="6,6,6,6" TextElement.FontWeight="Normal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Target 1, Target 2, Target 3 -->
                <TextBlock x:Name="lblTarget1" Grid.Row="0" Grid.Column="0" Text="* Mã khóa (Id):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,6"/>
                <dxe:ComboBoxEdit x:Name="cboMap1" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,16,6" IsTextEditable="False"
                                  SelectedIndexChanged="CboMapping_SelectedIndexChanged"/>

                <TextBlock x:Name="lblTarget2" Grid.Row="0" Grid.Column="2" Text="* Tên danh mục:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,6"/>
                <dxe:ComboBoxEdit x:Name="cboMap2" Grid.Row="0" Grid.Column="3" Height="26" Margin="0,0,16,6" IsTextEditable="False"
                                  SelectedIndexChanged="CboMapping_SelectedIndexChanged"/>

                <TextBlock x:Name="lblTarget3" Grid.Row="0" Grid.Column="4" Text="Trường phụ 1:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,6"/>
                <dxe:ComboBoxEdit x:Name="cboMap3" Grid.Row="0" Grid.Column="5" Height="26" Margin="0,0,0,6" IsTextEditable="False"
                                  SelectedIndexChanged="CboMapping_SelectedIndexChanged"/>

                <!-- Row 1: Target 4, Target 5, Target 6 -->
                <TextBlock x:Name="lblTarget4" Grid.Row="1" Grid.Column="0" Text="Trường phụ 2:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <dxe:ComboBoxEdit x:Name="cboMap4" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,0,16,0" IsTextEditable="False"
                                  SelectedIndexChanged="CboMapping_SelectedIndexChanged"/>

                <TextBlock x:Name="lblTarget5" Grid.Row="1" Grid.Column="2" Text="Trường phụ 3:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <dxe:ComboBoxEdit x:Name="cboMap5" Grid.Row="1" Grid.Column="3" Height="26" Margin="0,0,16,0" IsTextEditable="False"
                                  SelectedIndexChanged="CboMapping_SelectedIndexChanged"/>

                <TextBlock x:Name="lblTarget6" Grid.Row="1" Grid.Column="4" Text="Ghi chú:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <dxe:ComboBoxEdit x:Name="cboMap6" Grid.Row="1" Grid.Column="5" Height="26" Margin="0,0,0,0" IsTextEditable="False"
                                  SelectedIndexChanged="CboMapping_SelectedIndexChanged"/>
            </Grid>
        </GroupBox>

        <!-- 3. Action Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <dxe:CheckEdit x:Name="chkUpdateExisting" Content="Cập nhật đè nếu trùng Mã (Update on duplicate)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="btnSelectAll" Grid.Column="1" Content="✔ Chọn tất cả" Height="26" Width="95" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
            <Button x:Name="btnUnselectAll" Grid.Column="2" Content="✖ Bỏ chọn" Height="26" Width="85" Margin="0,0,12,0" Click="BtnUnselectAll_Click"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="lblImportStats" Text="Chưa chọn tệp dữ liệu." FontWeight="SemiBold" Foreground="#FF1565C0"/>
            </StackPanel>

            <Button x:Name="btnExecuteImport" Grid.Column="4" Content="💾 Nạp vào CSDL" Height="30" Width="170"
                    FontWeight="Bold" Background="#FF2E7D32" Foreground="White" Click="BtnExecuteImport_Click"/>
        </Grid>

        <!-- 4. Preview Grid -->
        <dxg:GridControl x:Name="gridPreview" Grid.Row="3" AutoGenerateColumns="None" SelectionMode="Row">
            <dxg:GridControl.View>
                <dxg:TableView x:Name="viewPreview" ShowGroupPanel="True" ShowSearchPanelMode="Always" 
                               ShowAutoFilterRow="True" AllowEditing="True"/>
            </dxg:GridControl.View>
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="IsSelected" Header="Chọn" Width="55" FixedWidth="True" AllowEditing="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="RowIndex" Header="Dòng" Width="50" FixedWidth="True" AllowEditing="False"/>
                <dxg:GridColumn x:Name="colCode" FieldName="Code" Header="Mã khóa (Id)" Width="130" FixedWidth="True" AllowEditing="True"/>
                <dxg:GridColumn x:Name="colName" FieldName="Name" Header="Tên danh mục" Width="260" AllowEditing="True"/>
                <dxg:GridColumn x:Name="colField1" FieldName="Field1" Header="Trường phụ 1" Width="150" AllowEditing="True"/>
                <dxg:GridColumn x:Name="colField2" FieldName="Field2" Header="Trường phụ 2" Width="180" AllowEditing="True"/>
                <dxg:GridColumn x:Name="colField3" FieldName="Field3" Header="Trường phụ 3" Width="140" AllowEditing="True"/>
                <dxg:GridColumn FieldName="Status" Header="Kiểm tra" Width="140" FixedWidth="True" AllowEditing="False"/>
            </dxg:GridControl.Columns>
        </dxg:GridControl>

        <!-- 5. Footer -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lblFooter" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF616161"/>
            <Button x:Name="btnClose" Grid.Column="1" Content="Đóng" Width="90" Height="28" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</base:BaseWindow>