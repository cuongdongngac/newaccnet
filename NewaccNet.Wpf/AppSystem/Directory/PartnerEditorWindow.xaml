<base:BaseWindow 
    x:Class="NewaccNet.Wpf.AppSystem.Directory.PartnerEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Cập nhật Đối tượng Công nợ" SizeToContent="Height" Width="550" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Mã Đối Tượng -->
        <TextBlock Text="Mã đối tượng: (*)" Grid.Row="0" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Center"/>
        <dxe:TextEdit x:Name="txtId" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Height="25" MaxLength="50"/>

        <!-- Tên Đối Tượng -->
        <TextBlock Text="Tên đối tượng: (*)" Grid.Row="1" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Center"/>
        <dxe:TextEdit x:Name="txtCustomerName" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Height="25" MaxLength="255"/>

        <!-- Địa Chỉ -->
        <TextBlock Text="Địa chỉ:" Grid.Row="2" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Center"/>
        <dxe:TextEdit x:Name="txtAddress" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="25" MaxLength="255"/>

        <!-- Nhóm Mã số thuế & Điện thoại -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Mã số thuế:" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Center"/>
            <dxe:TextEdit x:Name="txtTaxno" Grid.Column="1" Margin="0,0,10,0" Height="25" MaxLength="50"/>
            
            <TextBlock Text="Điện thoại:" Grid.Column="2" Margin="0,5,5,5" VerticalAlignment="Center"/>
            <dxe:TextEdit x:Name="txtPhonenumber" Grid.Column="3" Height="25" MaxLength="50"/>
        </Grid>

        <!-- Nhóm Fax & CheckBox Nhân Viên -->
        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Fax:" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Center"/>
            <dxe:TextEdit x:Name="txtFaxnumber" Grid.Column="1" Margin="0,0,10,0" Height="25" MaxLength="50"/>
            
            <CheckBox x:Name="chkIsEmployee" Content="Là nhân viên nội bộ" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"/>
        </Grid>

        <!-- Ghi chú -->
        <TextBlock Text="Ghi chú:" Grid.Row="5" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Top"/>
        <dxe:TextEdit x:Name="txtNote" Grid.Row="5" Grid.Column="1" Margin="0,0,0,15" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

        <!-- Nút bấm -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <dx:SimpleButton x:Name="btnSave" Content="Lưu (Ctrl+S)" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSave_Click" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save.svg'}"/>
            <dx:SimpleButton x:Name="btnCancel" Content="Hủy" Width="100" Height="30" Click="BtnCancel_Click" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_delete.svg'}"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>
