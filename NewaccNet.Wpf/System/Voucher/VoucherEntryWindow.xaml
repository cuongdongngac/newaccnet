<dx:ThemedWindow 
    x:Class="NewaccNet.Wpf.AppSystem.Voucher.VoucherEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:local="clr-namespace:NewaccNet.Wpf.AppSystem.Voucher"
    Title="Chứng từ kế toán (Voucher Entry)" Height="768" Width="1024"
    WindowStartupLocation="CenterScreen"
    Closing="ThemedWindow_Closing">

    <Window.Resources>
        <DataTemplate x:Key="AccountColumnTemplate">
            <local:AccountLookUpEdit Name="PART_Editor" ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}">
                <local:AccountLookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <dxg:GridControl Name="PART_GridControl">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="AccountId" Header="Mã TK" Width="100"/>
                                <dxg:GridColumn FieldName="AccountName" Header="Tên tài khoản" Width="*"/>
                                <dxg:GridColumn FieldName="CategoryId" Header="Loại" Width="50"/>
                            </dxg:GridControl.Columns>
                        </dxg:GridControl>
                    </ControlTemplate>
                </local:AccountLookUpEdit.PopupContentTemplate>
            </local:AccountLookUpEdit>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <dxb:BarContainerControl Grid.Row="0">
            <dxb:ToolBarControl ShowDragWidget="False" AllowCustomizationMenu="False" AllowHide="False" AllowQuickCustomization="False">
                <dxb:BarButtonItem Content="Thêm mới" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_new.svg'}" ItemClick="BtnNew_Click"/>
                <dxb:BarButtonItem Content="Lưu (Save)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save.svg'}" ItemClick="BtnSave_Click"/>
                <dxb:BarButtonItem Content="Xóa" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_delete.svg'}"/>
                <dxb:BarButtonItem Content="Đóng" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_close.svg'}" ItemClick="BtnClose_Click"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Content="Đầu tiên" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/doublefirst.svg'}" ItemClick="BtnFirst_Click"/>
                <dxb:BarButtonItem Content="Trước" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/prev.svg'}" ItemClick="BtnPrev_Click"/>
                <dxb:BarButtonItem Content="Tiếp" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/next.svg'}" ItemClick="BtnNext_Click"/>
                <dxb:BarButtonItem Content="Cuối cùng" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/doublelast.svg'}" ItemClick="BtnLast_Click"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <!-- HEADER -->
        <dxlc:LayoutControl Grid.Row="1" Orientation="Vertical" Padding="10">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="ID (Khóa chính):" Width="150">
                    <dxe:TextEdit Name="txtVoucherId" IsReadOnly="True" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Số chứng từ:" Width="200">
                    <dxe:TextEdit Name="txtVoucherNo" FontWeight="Bold"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Ngày chứng từ:" Width="200">
                    <dxe:DateEdit Name="txtVoucherDate"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem>
                    <dxe:CheckEdit Name="chkBookflag" Content="Đã ghi sổ (Confirmed)" FontWeight="Bold" Foreground="DarkRed"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutItem Label="Nội dung:">
                <dxe:TextEdit Name="txtContents"/>
            </dxlc:LayoutItem>
        </dxlc:LayoutControl>

        <!-- BODY: TWO GRIDS -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT GRID: CHÍNH (Master) -->
            <dxlc:LayoutControl Grid.Column="0" Orientation="Vertical" Padding="0">
                <TextBlock Text="ĐỊNH KHOẢN CHÍNH (Master - Trái)" FontWeight="Bold" Margin="0,0,0,5" Foreground="DarkGreen"/>
                <dxg:GridControl Name="gridLeft" VerticalAlignment="Stretch" SelectedItemChanged="gridLeft_SelectedItemChanged" >
                    <dxg:GridControl.View>
                        <dxg:TableView ShowGroupPanel="False" NewItemRowPosition="Bottom" EnterMoveNextColumn="True" CellValueChanged="GridView_CellValueChanged" PreviewKeyDown="TableViewLeft_PreviewKeyDown"/>
                    </dxg:GridControl.View>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Id" Header="ID" Width="40" ReadOnly="True" AllowEditing="False" />
                        <dxg:GridColumn Binding="{Binding ParentId}" FieldName="ParentId" Header="ParentId" Width="60" ReadOnly="True" AllowEditing="False" />
                        <dxg:GridColumn FieldName="Dbcr" Header="Nợ/Có" Width="60">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.DbcrList, RelativeSource={RelativeSource AncestorType=Window}}" ValueMember="Id" DisplayMember="Name"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AccountId" Header="Tài khoản" Width="150" CellTemplate="{StaticResource AccountColumnTemplate}"/>
                        <dxg:GridColumn FieldName="Amount" Header="Số tiền" Width="*">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="N0" Mask="N0" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                </dxg:GridControl>
            </dxlc:LayoutControl>

            <!-- RIGHT GRID: CHI TIẾT (Detail) -->
            <dxlc:LayoutControl Grid.Column="2" Orientation="Vertical" Padding="0">
                <TextBlock Text="ĐỊNH KHOẢN CHI TIẾT (Detail - Phải)" FontWeight="Bold" Margin="0,0,0,5" Foreground="Blue"/>
                <dxg:GridControl Name="gridRight" VerticalAlignment="Stretch" >
                    <dxg:GridControl.View>
                        <dxg:TableView ShowGroupPanel="False" NewItemRowPosition="Bottom" EnterMoveNextColumn="True" CellValueChanged="GridView_CellValueChanged" PreviewKeyDown="TableViewLeft_PreviewKeyDown"/>
                    </dxg:GridControl.View>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Id" Header="ID" Width="40" ReadOnly="True" AllowEditing="False" />
                        <dxg:GridColumn Binding="{Binding ParentId}" FieldName="ParentId" Header="ParentId" Width="60" ReadOnly="True" AllowEditing="False" />
                        <dxg:GridColumn FieldName="Dbcr" Header="Nợ/Có" Width="60">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.DbcrList, RelativeSource={RelativeSource AncestorType=Window}}" ValueMember="Id" DisplayMember="Name"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AccountId" Header="Tài khoản" Width="150" CellTemplate="{StaticResource AccountColumnTemplate}"/>
                        <dxg:GridColumn FieldName="Amount" Header="Số tiền" Width="*">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="N0" Mask="N0" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                </dxg:GridControl>
            </dxlc:LayoutControl>
        </Grid>
        
        <!-- FOOTER: CÂN ĐỐI -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="10,5" BorderBrush="LightGray" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Độ lệch (Tổng Nợ - Tổng Có): " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Name="txtBalance" Text="0" FontWeight="Bold" Foreground="Green" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>
