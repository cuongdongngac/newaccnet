<Window x:Class="NewaccNet.Wpf.AppSystem.Voucher.Details.MaterialAccountSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:local="clr-namespace:NewaccNet.Wpf.AppSystem.Voucher"
        Title="Chọn tài khoản" Height="300" Width="550" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <dxlc:LayoutControl Grid.Row="0" Orientation="Vertical" Padding="20">
            <!-- COGS / Cost -->
            <dxlc:LayoutItem Label="Tiền gốc" LabelHorizontalAlignment="Right" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <dxe:TextEdit x:Name="txtTotalCost" IsReadOnly="True" MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" Width="150" Margin="0,0,20,0" HorizontalContentAlignment="Right" FontWeight="Bold"/>
                    <local:AccountLookUpEdit x:Name="lueCostAccount" Width="150" />
                </StackPanel>
            </dxlc:LayoutItem>

            <!-- Revenue -->
            <dxlc:LayoutItem x:Name="itemRevenue" Label="Tiền bán" LabelHorizontalAlignment="Right" HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <dxe:TextEdit x:Name="txtTotalSell" IsReadOnly="True" MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" Width="150" Margin="0,0,20,0" HorizontalContentAlignment="Right"/>
                    <local:AccountLookUpEdit x:Name="lueRevenueAccount" Width="150" />
                </StackPanel>
            </dxlc:LayoutItem>

            <!-- Tax -->
            <dxlc:LayoutItem x:Name="itemTax" Label="Thuế" LabelHorizontalAlignment="Right" HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <dxe:TextEdit x:Name="txtTotalTax" IsReadOnly="True" MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" Width="150" Margin="0,0,20,0" HorizontalContentAlignment="Right"/>
                    <local:AccountLookUpEdit x:Name="lueTaxAccount" Width="150" />
                </StackPanel>
            </dxlc:LayoutItem>

            <!-- Receivable / Payable / Total -->
            <dxlc:LayoutItem x:Name="itemTotalAll" Label="Tổng" LabelHorizontalAlignment="Right" HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <dxe:TextEdit x:Name="txtTotalAll" IsReadOnly="True" MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" Width="150" Margin="0,0,20,0" HorizontalContentAlignment="Right"/>
                    <local:AccountLookUpEdit x:Name="lueTotalAccount" Width="150" />
                </StackPanel>
            </dxlc:LayoutItem>

        </dxlc:LayoutControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,10,20">
            <Button Content="Chọn" Width="100" Height="30" Margin="0,0,20,0" Click="BtnAccept_Click"/>
            <Button Content="Bỏ qua" Width="100" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
