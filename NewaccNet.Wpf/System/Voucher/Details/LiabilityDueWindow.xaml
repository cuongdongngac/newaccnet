<dx:ThemedWindow x:Class="NewaccNet.Wpf.AppSystem.Voucher.Details.LiabilityDueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        Title="Thời hạn công nợ (Cam kết)" Height="380" Width="450" WindowStartupLocation="CenterOwner" ShowIcon="False" ResizeMode="NoResize">
    
    <Grid Background="#F8F8F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề (Tên đối tượng, Tên công trình/nội dung) -->
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15,10">
            <StackPanel>
                <TextBlock x:Name="txtPartnerName" Text="Tên đối tượng..." Foreground="Blue" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtDebtTypeName" Text="Nội dung/Công trình..." Foreground="Blue" FontWeight="Bold" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Form nhập liệu -->
        <dxlc:LayoutControl Grid.Row="1" Orientation="Vertical" Padding="20">
            <dxlc:LayoutItem Label="Từ ngày:" >
                <dxe:DateEdit EditValue="{Binding BeginDate, UpdateSourceTrigger=PropertyChanged}"  Mask="dd/MM/yyyy"/>
            </dxlc:LayoutItem>
            
            <dxlc:LayoutItem Label="Đến ngày:"  Margin="0,10,0,0">
                <dxe:DateEdit EditValue="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"  Mask="dd/MM/yyyy"/>
            </dxlc:LayoutItem>
            
            <dxlc:LayoutItem Label="Lãi suất:"  Margin="0,10,0,0">
                <dxe:TextEdit EditValue="{Binding Interestrate, UpdateSourceTrigger=PropertyChanged}" MaskType="Numeric" Mask="N2" MaskUseAsDisplayFormat="True"/>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="% Khấu trừ:"  Margin="0,10,0,0">
                <dxe:TextEdit EditValue="{Binding Feedbackrate, UpdateSourceTrigger=PropertyChanged}" MaskType="Numeric" Mask="N2" MaskUseAsDisplayFormat="True"/>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Vat đầu ra:"  Margin="0,10,0,0">
                <dxe:TextEdit EditValue="{Binding Outvatrate, UpdateSourceTrigger=PropertyChanged}" MaskType="Numeric" Mask="N2" MaskUseAsDisplayFormat="True"/>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Kết thúc:"  Margin="0,10,0,0">
                <dxe:CheckEdit EditValue="{Binding Settledflag, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Ghi chú:"  Margin="0,10,0,0">
                <dxe:TextEdit EditValue="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
        </dxlc:LayoutControl>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="#EAEAEA" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- <dx:SimpleButton Content="Xóa" Width="80" Margin="0,0,10,0" Click="BtnDelete_Click" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_delete.svg'}"/> -->
                <dx:SimpleButton Content="Lưu" Width="90" Margin="0,0,10,0" Click="BtnSave_Click" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/save/save.svg'}"/>
                <dx:SimpleButton Content="Kết thúc" Width="90" Click="BtnClose_Click" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/icon%20builder/actions_delete.svg'}"/>
            </StackPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>