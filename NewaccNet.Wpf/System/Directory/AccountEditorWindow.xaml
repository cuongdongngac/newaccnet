<base:BaseWindow xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base" x:Class="NewaccNet.Wpf.AppSystem.Directory.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        Title="Cập nhật Tài Khoản" Height="350" Width="450" WindowStartupLocation="CenterOwner">
    <Grid>
        <dxlc:LayoutControl Orientation="Vertical">
            <dxlc:LayoutItem Label="Mã Tài Khoản (*):">
                <dxe:TextEdit x:Name="txtAccountId" />
            </dxlc:LayoutItem>
            
            <dxlc:LayoutItem Label="Tên Tài Khoản (*):">
                <dxe:TextEdit x:Name="txtAccountName" />
            </dxlc:LayoutItem>
            
            <dxlc:LayoutItem Label="Loại TK (CategoryId):">
                <dxe:ComboBoxEdit x:Name="cboCategoryId" ValueMember="Code" DisplayMember="Name" AutoComplete="True" ImmediatePopup="True" />
            </dxlc:LayoutItem>
            
            <dxlc:LayoutItem Label="Mã TK Cha (ParentId):">
                <dxe:TextEdit x:Name="txtParentId" />
            </dxlc:LayoutItem>
            
            <dxlc:LayoutItem Label="Có tính thuế? (Taxflag):">
                <dxe:CheckEdit x:Name="chkTaxFlag" />
            </dxlc:LayoutItem>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <dx:SimpleButton Content="Lưu" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSave_Click" Background="#FF2196F3" Foreground="White" FontWeight="Bold"/>
                <dx:SimpleButton Content="Hủy" Width="100" Height="30" Click="BtnCancel_Click"/>
            </StackPanel>
        </dxlc:LayoutControl>
    </Grid>
</base:BaseWindow>

