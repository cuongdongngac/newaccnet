<base:BaseWindow 
    x:Class="NewaccNet.Wpf.AppSystem.Directory.InventoryItemEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base"
    Title="Cập nhật Danh mục Vật tư" SizeToContent="Height" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Mã Vật Tư -->
        <TextBlock Text="Mã vật tư: (*)" Grid.Row="0" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Center"/>
        <dxe:TextEdit x:Name="txtId" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Height="25" MaxLength="50"/>

        <!-- Tên Vật Tư -->
        <TextBlock Text="Tên vật tư: (*)" Grid.Row="1" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Center"/>
        <dxe:TextEdit x:Name="txtName" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Height="25" MaxLength="255"/>

        <!-- Đơn vị tính -->
        <TextBlock Text="Đơn vị tính:" Grid.Row="2" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Center"/>
        <dxe:TextEdit x:Name="txtUnit" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="25" MaxLength="50"/>

        <!-- Nhóm Vật Tư -->
        <TextBlock Text="Nhóm vật tư:" Grid.Row="3" Grid.Column="0" Margin="0,5,5,5" VerticalAlignment="Center"/>
        <dxe:ComboBoxEdit x:Name="cboCategory" Grid.Row="3" Grid.Column="1" Margin="0,0,0,15" Height="25" 
                          ValueMember="Categoryid" DisplayMember="Categoryname" AutoComplete="True" ImmediatePopup="True"/>

        <!-- Nút bấm -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <dx:SimpleButton x:Name="btnSave" Content="Lưu (Ctrl+S)" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSave_Click" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save.svg'}"/>
            <dx:SimpleButton x:Name="btnCancel" Content="Hủy" Width="100" Height="30" Click="BtnCancel_Click" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_delete.svg'}"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>
