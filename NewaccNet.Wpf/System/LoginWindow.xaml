<base:BaseWindow xmlns:base="clr-namespace:NewaccNet.Wpf.Views.Base" x:Class="NewaccNet.Wpf.AppSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Đăng nhập Hệ thống" Height="250" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <dxlc:LayoutControl Orientation="Vertical" Padding="20">
            <dxlc:LayoutItem Label="Tên đăng nhập:">
                <dxe:TextEdit x:Name="txtUsername" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Mật khẩu:">
                <dxe:PasswordBoxEdit x:Name="txtPassword" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Margin="0,15,0,0" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <dx:SimpleButton Content="Đăng nhập" Width="100" Height="30" Margin="0,0,10,0" Click="BtnLogin_Click" Background="#FF1976D2" Foreground="White" FontWeight="Bold"/>
                    <dx:SimpleButton Content="Thoát" Width="80" Height="30" Click="BtnExit_Click"/>
                </StackPanel>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Margin="0,10,0,0" HorizontalAlignment="Center">
                <TextBlock>
                    <Hyperlink Click="LnkConfig_Click">Cấu hình Cơ sở dữ liệu</Hyperlink>
                </TextBlock>
            </dxlc:LayoutItem>
        </dxlc:LayoutControl>
    </Grid>
</base:BaseWindow>

