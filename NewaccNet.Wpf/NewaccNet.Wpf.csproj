<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\dataaccess\DatabaseGeneric\DataAccess.csproj" />
    <ProjectReference Include="..\dataaccess\MS Access (OleDb)\DatabaseSpecific\DataAccess.MsAccessDBSpecific.csproj" />
    <ProjectReference Include="..\dataaccess\SQL Server (SqlClient)\DatabaseSpecific\DataAccess.SqlServerDBSpecific.csproj" />
    <ProjectReference Include="..\dataaccess\PostgreSql (Npgsql)\DatabaseSpecific\DataAccess.PostgreSqlDBSpecific.csproj" />
    <ProjectReference Include="..\NewaccNet.Reports\NewaccNet.Reports.csproj" />
    <ProjectReference Include="..\NewaccNet.TaxInvoice\NewaccNet.TaxInvoice.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x86;x64</Platforms>
  </PropertyGroup>

  <!-- Bản 32-bit (x86) -> D:\NewaccNet\Publish\x86\ -->
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath>..\Publish\x86\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Bản 64-bit (x64) -> D:\NewaccNet\Publish\x64\ -->
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\Publish\x64\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="DevExpress.Images" Version="25.2.3" />
    <PackageReference Include="DevExpress.Reporting.Core" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.Core" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.Grid" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.LayoutControl" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.Printing" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.Reporting" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.Ribbon" Version="25.2.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="newacc.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Template\template.accdb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AppSystem\Reports\DetailTrialBalance\Reports\Material\MaterialSummaryReport.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="AppSystem\Reports\DetailTrialBalance\Reports\Material\MaterialSummaryReport.Designer.cs">
      <DependentUpon>MaterialSummaryReport.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AppSystem\Reports\DetailTrialBalance\Reports\Material\MaterialSummaryReport.resx">
      <DependentUpon>MaterialSummaryReport.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="AppSystem\Reports\DetailTrialBalance\Reports\Material\MaterialDetailReport.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="AppSystem\Reports\DetailTrialBalance\Reports\Material\MaterialDetailReport.Designer.cs">
      <DependentUpon>MaterialDetailReport.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AppSystem\Reports\DetailTrialBalance\Reports\Material\MaterialDetailReport.resx">
      <DependentUpon>MaterialDetailReport.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="AppSystem\Reports\DetailTrialBalance\Reports\Cost\CostSummaryReport.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="AppSystem\Reports\DetailTrialBalance\Reports\Cost\CostSummaryReport.Designer.cs">
      <DependentUpon>CostSummaryReport.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AppSystem\Reports\DetailTrialBalance\Reports\Cost\CostSummaryReport.resx">
      <DependentUpon>CostSummaryReport.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="AppSystem\Reports\DetailTrialBalance\Reports\Cost\CostDetailReport.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="AppSystem\Reports\DetailTrialBalance\Reports\Cost\CostDetailReport.Designer.cs">
      <DependentUpon>CostDetailReport.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AppSystem\Reports\DetailTrialBalance\Reports\Cost\CostDetailReport.resx">
      <DependentUpon>CostDetailReport.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>

