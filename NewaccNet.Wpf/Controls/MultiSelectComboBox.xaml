<UserControl x:Class="NewaccNet.Wpf.Controls.MultiSelectComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" MinWidth="150" Height="28">
    <Grid>
        <!-- Ô hiển thị (nút bấm mở dropdown) -->
        <ToggleButton x:Name="PART_Toggle"
                       HorizontalContentAlignment="Stretch"
                       Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                       IsChecked="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}">
            <Grid Margin="6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PART_Text" Margin="0,0,6,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="12"/>
                <Path Grid.Column="1" Margin="4,0,2,0" VerticalAlignment="Center"
                      Data="M0,0 L4,4 L8,0 Z" Fill="#555"/>
            </Grid>
        </ToggleButton>

        <!-- Dropdown Popup dạng react-select -->
        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding ElementName=PART_Toggle}" Placement="Bottom"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Opened="Popup_Opened" Closed="Popup_Closed">
            <Border Background="White" BorderBrush="#1976D2" BorderThickness="1" CornerRadius="2" Padding="6"
                    MinWidth="{Binding ActualWidth, ElementName=Root}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Ô tìm kiếm tức thì + placeholder mờ -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox x:Name="PART_Search" Padding="6,4" FontSize="12"
                                 BorderBrush="#BDBDBD" BorderThickness="1"
                                 TextChanged="Search_TextChanged"
                                 PreviewKeyDown="Search_PreviewKeyDown"/>
                        <TextBlock Text="Tìm theo mã hoặc tên..." Foreground="#9E9E9E"
                                   Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PART_Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Chọn tất cả (tác động lên danh sách đang hiển thị) -->
                    <Border DockPanel.Dock="Top" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="2,0,0,6" Margin="0,0,0,4">
                        <CheckBox x:Name="PART_SelectAll" Content="Chọn tất cả (*)"
                                  FontWeight="SemiBold" Foreground="#1565C0"
                                  Click="SelectAll_Click"/>
                    </Border>

                    <!-- Danh sách các mục có checkbox -->
                    <ListBox x:Name="PART_List" BorderThickness="0"
                             MaxHeight="{Binding MaxDropDownHeight, ElementName=Root}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="List_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="2,3"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Content="{Binding Display}"
                                          FontSize="12" Margin="2,1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
