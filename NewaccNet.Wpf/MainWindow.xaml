<dx:ThemedWindow x:Class="NewaccNet.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
        xmlns:local="clr-namespace:NewaccNet.Wpf"
        xmlns:auth="clr-namespace:NewaccNet.Wpf.AppSystem"
        mc:Ignorable="d"
        Title="Phần mềm Kế toán NewaccNet" Height="600" Width="1000" WindowState="Maximized"
        Icon="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_report_showdesigner.svg'}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu chính dạng Ribbon -->
        <dxr:RibbonControl Grid.Row="0" RibbonStyle="Office2019" ShowApplicationButton="False">
            <!-- Tab: Hệ thống -->
            <dxr:RibbonDefaultPageCategory>
                <!-- ==================== Tab: Hệ thống ==================== -->
                <dxr:RibbonPage Caption="Hệ thống">
                    <dxr:RibbonPageGroup Caption="Quản trị">
                        <dxb:BarButtonItem Content="Người dùng" ItemClick="BtnUserManagement_ItemClick" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/filtereditor_user.svg'}" auth:AuthHelper.RequiredMask="1">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Quản lý Người dùng &amp; Phân quyền"/>
                                    <dx:SuperTipItem Content="Thêm, sửa, xóa tài khoản người dùng hệ thống.&#x0a;Thiết lập quyền truy cập (RoleMask) cho từng phân hệ kế toán."/>
                                    <dx:SuperTipItemSeparator/>
                                    <dx:SuperTipItem Content="⚠ Chỉ dành cho người có quyền Quản trị (Bit 0)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Cấu hình DB" ItemClick="BtnConfig_ItemClick" LargeGlyph="{dx:DXImage SvgImages/Setup/Properties.svg}" auth:AuthHelper.RequiredMask="1">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Cấu hình Kết nối Cơ sở dữ liệu"/>
                                    <dx:SuperTipItem Content="Thiết lập kết nối đến CSDL: MS Access, SQL Server hoặc PostgreSQL.&#x0a;Cho phép chuyển đổi linh hoạt giữa các hệ quản trị."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Khai báo" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" auth:AuthHelper.RequiredMask="1">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Khai báo Thông tin Doanh nghiệp"/>
                                    <dx:SuperTipItem Content="Khai báo tên công ty, mã số thuế, địa chỉ, năm tài chính và các tham số hệ thống."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                    </dxr:RibbonPageGroup>
                </dxr:RibbonPage>
                
                <!-- ==================== Tab: Danh mục ==================== -->
                <dxr:RibbonPage Caption="Danh mục">
                    <!-- Nhóm: Kế toán -->
                    <dxr:RibbonPageGroup Caption="Kế toán">
                        <dxb:BarButtonItem Content="Tài khoản" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" ItemClick="BtnCategoryAccount_ItemClick" auth:AuthHelper.RequiredMask="8">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Hệ thống Tài khoản Kế toán"/>
                                    <dx:SuperTipItem Content="Quản lý hệ thống tài khoản kế toán theo Thông tư 200/2014.&#x0a;Cấu trúc cây cha – con, thiết lập thuộc tính thuế (VAT) và in danh mục."/>
                                    <dx:SuperTipItemSeparator/>
                                    <dx:SuperTipItem Content="📂 Yêu cầu quyền: Kế toán tổng hợp (Bit 3)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Nguồn CT" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_list.svg'}" auth:AuthHelper.RequiredMask="8">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Nguồn Chứng từ"/>
                                    <dx:SuperTipItem Content="Khai báo các loại nguồn chứng từ kế toán (Phiếu thu, Phiếu chi, Phiếu nhập, Phiếu xuất...).&#x0a;Mỗi nguồn gắn với một mẫu phiếu và quy tắc đánh số tự động."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        
                        <dxb:BarButtonItem Content="Phòng ban" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_department.svg'}" auth:AuthHelper.RequiredMask="8">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Phòng ban / Bộ phận"/>
                                    <dx:SuperTipItem Content="Khai báo cơ cấu tổ chức phòng ban của doanh nghiệp.&#x0a;Dùng để phân bổ chi phí và lập báo cáo quản trị theo bộ phận."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                    </dxr:RibbonPageGroup>

                    <!-- Nhóm: Công nợ -->
                    <dxr:RibbonPageGroup Caption="Công nợ">
                        <dxb:BarButtonItem Content="Đối tượng" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/filtereditor_user.svg'}" ItemClick="BtnCategoryPartner_ItemClick" auth:AuthHelper.RequiredMask="16">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Đối tượng Công nợ"/>
                                    <dx:SuperTipItem Content="Quản lý khách hàng, nhà cung cấp, nhân viên tạm ứng.&#x0a;Theo dõi thông vị liên hệ, mã số thuế, hạn mức tín dụng và lịch sử giao dịch."/>
                                    <dx:SuperTipItemSeparator/>
                                    <dx:SuperTipItem Content="📂 Yêu cầu quyền: Công nợ (Bit 4)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Nội dung công nợ" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_customer.svg'}" ItemClick="BtnCategoryDebtType_ItemClick" auth:AuthHelper.RequiredMask="16">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Nội dung Công nợ"/>
                                    <dx:SuperTipItem Content="Phân loại công nợ: Phải thu khách hàng, Phải trả nhà cung cấp, Tạm ứng, Vay nợ...&#x0a;Gắn với tài khoản kế toán tương ứng (TK 131, 331, 141...)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Lý do công nợ" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" ItemClick="BtnCategoryDebtReason_ItemClick" auth:AuthHelper.RequiredMask="16">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Lý do Công nợ"/>
                                    <dx:SuperTipItem Content="Quản lý các lý do phát sinh công nợ."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                    </dxr:RibbonPageGroup>

                    <!-- Nhóm: Kho & Vật tư -->
                                        <dxr:RibbonPageGroup Caption="Kho &amp; Vật tư">
                        <dxb:BarButtonItem Content="Kho hàng" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" ItemClick="BtnCategoryWarehouse_ItemClick" auth:AuthHelper.RequiredMask="4">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Kho hàng"/>
                                    <dx:SuperTipItem Content="Khai báo hệ thống kho: Kho nguyên vật liệu, Kho thành phẩm, Kho hàng hoá...
Mỗi kho gắn với địa điểm và thủ kho phụ trách."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Nhóm vật tư" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_category.svg'}" ItemClick="BtnCategoryCategory_ItemClick" auth:AuthHelper.RequiredMask="4">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Nhóm Vật tư"/>
                                    <dx:SuperTipItem Content="Quản lý nhóm vật tư, tự động liên kết với mã Thuế suất mặc định."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Danh mục vật tư" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" ItemClick="BtnCategoryInventoryItem_ItemClick" auth:AuthHelper.RequiredMask="4">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Vật tư / Hàng hoá"/>
                                    <dx:SuperTipItem Content="Quản lý mã vật tư, tên hàng hoá, đơn vị tính, nhóm hàng.
Thiết lập phương pháp tính giá xuất kho (Bình quân, FIFO, Đích danh)."/>
                                    <dx:SuperTipItemSeparator/>
                                    <dx:SuperTipItem Content="※ Yêu cầu quyền: Vật tư (Bit 2)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Thuế suất" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_sale.svg'}" ItemClick="BtnCategoryTaxRate_ItemClick" auth:AuthHelper.RequiredMask="4">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Thuế suất"/>
                                    <dx:SuperTipItem Content="Khai báo các mức thuế (5%, 8%, 10%...) dùng để gán cho nhóm vật tư."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Giá vật tư" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_list.svg'}" auth:AuthHelper.RequiredMask="4">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Bảng Giá Vật tư"/>
                                    <dx:SuperTipItem Content="Thiết lập đơn giá mua, giá bán cho từng mặt hàng.
Hỗ trợ quản lý giá theo nhà cung cấp và thời kỳ."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                    </dxr:RibbonPageGroup>

                    <!-- Nhóm: Ngoại tệ -->
                                        <dxr:RibbonPageGroup Caption="Ngoại tệ">
                        <dxb:BarButtonItem Content="Loại tiền" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" ItemClick="BtnCategoryCurrency_ItemClick" auth:AuthHelper.RequiredMask="2">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh sách Tiền tệ"/>
                                    <dx:SuperTipItem Content="Khai báo các loại tiền tệ sử dụng: VND, USD, EUR, JPY..."/>
                                    <dx:SuperTipItemSeparator/>
                                    <dx:SuperTipItem Content="※ Yêu cầu quyền: Ngoại tệ (Bit 1)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Tỷ giá" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_sale.svg'}" ItemClick="BtnCategoryExchangeRate_ItemClick" auth:AuthHelper.RequiredMask="2">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Tỷ giá Hối đoái"/>
                                    <dx:SuperTipItem Content="Danh sách gợi ý tỷ giá tham khảo cho các giao dịch theo từng tháng."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                    </dxr:RibbonPageGroup>

                    <!-- Nhóm: Chi phí -->
                                        <dxr:RibbonPageGroup Caption="Chi phí">
                        <dxb:BarButtonItem Content="Đối tượng CP" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" ItemClick="BtnCategoryCostObject_ItemClick" auth:AuthHelper.RequiredMask="64">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Đối tượng Tập hợp Chi phí"/>
                                    <dx:SuperTipItem Content="Khai báo đối tượng tập hợp chi phí: Công trình, Đơn hàng, Phân xưởng, Sản phẩm...
Dùng để phân bổ và tính giá thành theo từng đối tượng."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Yếu tố CP" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" ItemClick="BtnCategoryCostElement_ItemClick" auth:AuthHelper.RequiredMask="64">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Yếu tố Chi phí"/>
                                    <dx:SuperTipItem Content="Khai báo các yếu tố chi phí: Nguyên vật liệu, Nhân công, Khấu hao, Dịch vụ mua ngoài...
Phục vụ lập báo cáo chi phí sản xuất theo yếu tố."/>
                                    <dx:SuperTipItemSeparator/>
                                    <dx:SuperTipItem Content="※ Yêu cầu quyền: Chi phí (Bit 6)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                    </dxr:RibbonPageGroup>

                    <!-- Nhóm: Tài sản cố định -->
                    <dxr:RibbonPageGroup Caption="TSCĐ">
                        <dxb:BarButtonItem Content="Tài sản" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_list.svg'}" auth:AuthHelper.RequiredMask="128">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Tài sản Cố định"/>
                                    <dx:SuperTipItem Content="Quản lý danh sách TSCĐ: Tên tài sản, nguyên giá, ngày đưa vào sử dụng, bộ phận quản lý.&#x0a;Thiết lập phương pháp và thời gian khấu hao cho từng tài sản."/>
                                    <dx:SuperTipItemSeparator/>
                                    <dx:SuperTipItem Content="📂 Yêu cầu quyền: Tài sản cố định (Bit 7)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                                                <dxb:BarButtonItem Content="Nguồn tài sản" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_list.svg'}" ItemClick="BtnCategorySource_ItemClick" auth:AuthHelper.RequiredMask="128">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Nguồn Tài Sản"/>
                                    <dx:SuperTipItem Content="Khai báo nguồn hình thành tài sản cố định (Ngân sách, Vốn tự có, Vay, ...)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Lý do tăng giảm" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" ItemClick="BtnCategoryReason_ItemClick" auth:AuthHelper.RequiredMask="128">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Lý do Tăng/Giảm"/>
                                    <dx:SuperTipItem Content="Quản lý lý do tăng giảm tài sản cố định (Mua mới, Thanh lý, ...)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                    </dxr:RibbonPageGroup>

                    <!-- Nhóm: Chứng khoán -->
                                        <dxr:RibbonPageGroup Caption="Chứng khoán">
                        <dxb:BarButtonItem Content="Loại hình CP" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_category.svg'}" ItemClick="BtnCategoryStockType_ItemClick" auth:AuthHelper.RequiredMask="32">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Loại hình Cổ phiếu"/>
                                    <dx:SuperTipItem Content="Phân loại chứng khoán: Cổ phiếu phổ thông, Cổ phiếu ưu đãi, Trái phiếu, Chứng chỉ quỹ..."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Danh mục CP" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" ItemClick="BtnCategoryStock_ItemClick" auth:AuthHelper.RequiredMask="32">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Danh mục Cổ phiếu"/>
                                    <dx:SuperTipItem Content="Khai báo mã chứng khoán đang nắm giữ hoặc giao dịch.
Bao gồm liên kết tới loại hình tương ứng."/>
                                    <dx:SuperTipItemSeparator/>
                                    <dx:SuperTipItem Content="※ Yêu cầu quyền: Chứng khoán (Bit 5)."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                    </dxr:RibbonPageGroup>
                </dxr:RibbonPage>

                <!-- ==================== Tab: Nghiệp vụ ==================== -->
                <dxr:RibbonPage Caption="Nghiệp vụ">
                    <!-- Nhóm: Kế toán tổng hợp -->
                    <dxr:RibbonPageGroup Caption="Tổng hợp">
                        <dxb:BarButtonItem Content="Phiếu KT" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" auth:AuthHelper.RequiredMask="8">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Nhập Phiếu Kế toán Tổng hợp"/>
                                    <dx:SuperTipItem Content="Nhập bút toán hạch toán thủ công (Nợ / Có).&#x0a;Dùng cho các nghiệp vụ điều chỉnh, kết chuyển, bút toán cuối kỳ."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem Content="Sổ cái" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_list.svg'}" auth:AuthHelper.RequiredMask="8">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Xem Sổ Cái Tài khoản"/>
                                    <dx:SuperTipItem Content="Tra cứu chi tiết phát sinh Nợ / Có của từng tài khoản theo kỳ.&#x0a;Hỗ trợ lọc theo nguồn chứng từ, đối tượng và khoảng thời gian."/>
                                </dx:SuperTip>
                            </dxb:BarButtonItem.SuperTip>
                        </dxb:BarButtonItem>
                    </dxr:RibbonPageGroup>

                    <!-- Nhóm: Công nợ -->
                    <dxr:RibbonPageGroup Caption="Công nợ">
                        <dxb:BarButtonItem Content="Phiếu thu" LargeGlyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/business%20objects/bo_document.svg'}" auth:AuthHelper.RequiredMask="16">
                            <dxb:BarButtonItem.SuperTip>
                                <dx:SuperTip>
                                    <dx:SuperTipHeaderItem Content="Nhập Phiếu Thu"/>
                                    <dx:SuperTipItem Content="Lập phiếu thu tiền mặt / chuyển khoản từ khách hàng, thu nội bộ.&#x0a;Tự động hạch toán Nợ TK 111/112 – Có TK đối ứng."/>
                                </dx:SuperTip>
