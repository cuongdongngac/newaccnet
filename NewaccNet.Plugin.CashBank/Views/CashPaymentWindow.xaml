<dx:ThemedWindow x:Class="NewaccNet.Plugin.CashBank.Views.CashPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="Phiếu chi tiền mặt &amp; Giấy Báo nợ / Ủy nhiệm chi - NEWACCNET" 
        Height="680" Width="880" MinWidth="750" MinHeight="550" 
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Layout Form -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- TOOLBAR DEVEXPRESS CHUẨN -->
        <dxb:BarContainerControl Grid.Row="0">
            <dxb:ToolBarControl ShowDragWidget="False" AllowCustomizationMenu="False" AllowHide="False" AllowQuickCustomization="False" GlyphSize="Small">
                <!-- Điều hướng phiếu -->
                <dxb:BarButtonItem Name="btnFirst" ToolTip="Phiếu đầu tiên (Home)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/doublefirst.svg'}" ItemClick="BtnFirst_Click"/>
                <dxb:BarButtonItem Name="btnPrev" ToolTip="Phiếu trước (PageUp)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/prev.svg'}" ItemClick="BtnPrev_Click"/>
                <dxb:BarStaticItem Name="lblNavPosition" Content="Phiếu mới (chưa lưu)" ShowBorder="True"/>
                <dxb:BarButtonItem Name="btnNext" ToolTip="Phiếu tiếp theo (PageDown)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/next.svg'}" ItemClick="BtnNext_Click"/>
                <dxb:BarButtonItem Name="btnLast" ToolTip="Phiếu cuối cùng (End)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/arrows/doublelast.svg'}" ItemClick="BtnLast_Click"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Name="btnNew" Content="Thêm mới (Ctrl+N)" ToolTip="Tạo phiếu mới trống" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_new.svg'}" ItemClick="BtnNew_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarButtonItem Name="btnAccept" Content="Lưu (Ctrl+S)" ToolTip="Lưu phiếu hiện tại" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save.svg'}" ItemClick="BtnAccept_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarButtonItem Name="btnSaveAndNew" Content="Lưu &amp; Thêm mới (Ctrl+Shift+S)" ToolTip="Lưu phiếu và tạo mới ngay" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_save_new.svg'}" ItemClick="BtnSaveAndNew_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Name="btnPrint" Content="In phiếu (Ctrl+P)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/print/print.svg'}" ItemClick="BtnPrint_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarButtonItem Name="btnDelete" Content="Xóa phiếu" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_clear.svg'}" ItemClick="BtnDelete_Click" BarItemDisplayMode="ContentAndGlyph"/>
                <dxb:BarItemSeparator/>
                <dxb:BarButtonItem Name="btnCancel" Content="Đóng (Esc)" Glyph="{dx:SvgImageSource Uri='pack://application:,,,/DevExpress.Images.v25.2;component/svgimages/xaf/action_close.svg'}" ItemClick="BtnCancel_Click" BarItemDisplayMode="ContentAndGlyph"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <!-- LAYOUT NHẬP LIỆU PHIẾU CHI (DẠNG FORM TINH GỌN, KHÔNG CẦN GRID) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <dxlc:LayoutControl Orientation="Vertical" Padding="18,12">
                <!-- NHÓM 1: THÔNG TIN CHỨNG TỪ & ĐỊNH KHOẢN -->
                <dxlc:LayoutGroup Header="Thông tin chứng từ &amp; Nghiệp vụ chi tiền" View="GroupBox" Orientation="Vertical">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxlc:LayoutItem Label="Phương thức chi:" Width="260">
                            <dxe:ComboBoxEdit x:Name="cboMethod" SelectedIndex="0" EditValueChanged="CboMethod_EditValueChanged">
                                <dxe:ComboBoxEditItem Content="Tiền mặt (Phiếu chi - PC)" Tag="PC"/>
                                <dxe:ComboBoxEditItem Content="Ngân hàng (Báo nợ - BN)" Tag="BN"/>
                                <dxe:ComboBoxEditItem Content="Ủy nhiệm chi (UNC)" Tag="UNC"/>
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Số chứng từ:" Width="220" Margin="15,0,0,0">
                            <dxe:TextEdit x:Name="txtVoucherNo" FontWeight="Bold" Foreground="#1E3A8A"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Ngày chứng từ:" Margin="15,0,0,0">
                            <dxe:DateEdit x:Name="dpVoucherDate"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>

                    <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,8,0,0">
                        <dxlc:LayoutItem Label="Nghiệp vụ (Mapping):" Width="260">
                            <dxe:ComboBoxEdit x:Name="cboAlias" DisplayMember="Name" ValueMember="Code" 
                                              AutoComplete="True" ImmediatePopup="True"
                                              EditValueChanged="CboAlias_EditValueChanged"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Chi từ TK (Có):" Width="220" Margin="15,0,0,0">
                            <dxe:ComboBoxEdit x:Name="cboCashAccount" DisplayMember="FullDisplay" ValueMember="AccountId" 
                                              AutoComplete="True" ImmediatePopup="True"
                                              EditValueChanged="CboCashAccount_EditValueChanged"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Tài khoản đối ứng (Nợ):" Margin="15,0,0,0">
                            <dxg:LookUpEdit x:Name="lueOffsetAccount" DisplayMember="FullDisplay" ValueMember="AccountId"
                                            AutoComplete="True" ImmediatePopup="True" IsTextEditable="True"
                                            AutoPopulateColumns="False" PopupWidth="480"
                                            EditValueChanged="LueOffsetAccount_EditValueChanged">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl">
                                            <dxg:GridControl.View>
                                                <dxg:TableView AutoWidth="True" ShowSearchPanelMode="Always"/>
                                            </dxg:GridControl.View>
                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn FieldName="AccountId" Header="Số hiệu TK" Width="110"/>
                                                <dxg:GridColumn FieldName="AccountName" Header="Tên tài khoản" Width="260"/>
                                                <dxg:GridColumn FieldName="CategoryId" Header="Loại TK" Width="70"/>
                                            </dxg:GridControl.Columns>
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>

                    <!-- SỐ TIỀN CHI TO RÕ RÀNG -->
                    <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,10,0,0">
                        <dxlc:LayoutItem Label="Số tiền chi (VND):" Width="360">
                            <dxe:TextEdit x:Name="txtAmount" EditValue="0"
                                          MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                                          FontWeight="Bold" FontSize="18" Foreground="#DC2626"
                                          EditValueChanged="TxtAmount_EditValueChanged"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Bằng chữ:" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock x:Name="lblAmountWords" Text="Không đồng" FontStyle="Italic" FontWeight="SemiBold" Foreground="#334155" FontSize="12" TextWrapping="Wrap"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>

                <!-- NHÓM 2: THÔNG TIN ĐỐI TƯỢNG NHẬN TIỀN -->
                <dxlc:LayoutGroup Header="Thông tin đối tượng nhận &amp; Lý do" View="GroupBox" Orientation="Vertical" Margin="0,10,0,0">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxlc:LayoutItem Label="Đối tượng nhận:">
                            <dxg:LookUpEdit x:Name="luePartner" 
                                            DisplayMember="CustomerName" ValueMember="Id" 
                                            AutoPopulateColumns="False" AutoComplete="True" ImmediatePopup="True" IsTextEditable="True"
                                            PopupWidth="560" EditValueChanged="LuePartner_EditValueChanged">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl">
                                            <dxg:GridControl.View>
                                                <dxg:TableView AutoWidth="True" ShowSearchPanelMode="Always"/>
                                            </dxg:GridControl.View>
                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn FieldName="Id" Header="Mã ĐT" Width="90"/>
                                                <dxg:GridColumn FieldName="CustomerName" Header="Tên đối tượng" Width="240"/>
                                                <dxg:GridColumn FieldName="Address" Header="Địa chỉ" Width="140"/>
                                                <dxg:GridColumn FieldName="Taxno" Header="Mã số thuế" Width="80"/>
                                            </dxg:GridControl.Columns>
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Người nhận:" Width="340" Margin="15,0,0,0">
                            <dxe:TextEdit x:Name="txtPersonName"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>

                    <dxlc:LayoutItem Label="Địa chỉ:" Margin="0,8,0,0">
                        <dxe:TextEdit x:Name="txtPersonAddress"/>
                    </dxlc:LayoutItem>

                    <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,8,0,0">
                        <dxlc:LayoutItem Label="Lý do chi (Diễn giải):">
                            <dxe:TextEdit x:Name="txtDescription"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Kèm theo chứng từ gốc:" Width="280" Margin="15,0,0,0">
                            <dxe:TextEdit x:Name="txtInvoicesNumber" NullText="Ví dụ: 01 Hóa đơn, Giấy đề nghị chi..."/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>

                <!-- NHÓM 3: THÔNG TIN GIAO DỊCH NGÂN HÀNG / ỦY NHIỆM CHI (KHI LÀ BN HOẶC UNC) -->
                <dxlc:LayoutGroup x:Name="grpBankDetails" Header="Thông tin giao dịch ngân hàng / Ủy nhiệm chi (UNC)" View="GroupBox" Orientation="Vertical" Margin="0,10,0,0" Visibility="Collapsed">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxlc:LayoutItem Label="Số TK chi:" Width="260">
                            <dxe:TextEdit x:Name="txtPaymentAcc"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Ngân hàng chi:" Margin="15,0,0,0">
                            <dxe:TextEdit x:Name="txtPaymentBank"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>

                    <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,8,0,0">
                        <dxlc:LayoutItem Label="Đơn vị thụ hưởng:" Width="340">
                            <dxe:TextEdit x:Name="txtRecievedCorp"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Số TK nhận:" Width="200" Margin="15,0,0,0">
                            <dxe:TextEdit x:Name="txtRecievedAcc"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Ngân hàng nhận:" Margin="15,0,0,0">
                            <dxe:TextEdit x:Name="txtRecievedBank"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>

                <!-- NHÓM 4: TRẠNG THÁI LIÊN KẾT CÔNG NỢ & KIỂM SOÁT -->
                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thông báo công nợ tự động (xanh / đỏ) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblDebtStatus" Text="✓ Hạch toán trực tiếp, không yêu cầu chi tiết công nợ." 
                                       FontWeight="SemiBold" FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                            <TextBlock x:Name="lblPostingSummary" Text="Định khoản: Nợ TK 3311 - Có TK 1111 (Số tiền: 0 đ)" 
                                       FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Nút chi tiết hóa đơn (khi cần chỉ định đích danh hóa đơn đến hạn) -->
                        <Button Grid.Column="1" x:Name="btnOpenDetail" Content="Hóa đơn đến hạn..." Height="28" Padding="12,0" 
                                Margin="15,0,10,0" Click="BtnOpenDetail_Click" ToolTip="Chỉ định đích danh hóa đơn đến hạn (LiabilityDue) nếu cần"/>

                        <!-- Ghi sổ cái -->
                        <dxe:CheckEdit Grid.Column="2" x:Name="chkBookflag" Content="Đã ghi sổ cái" IsChecked="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </dxlc:LayoutControl>
        </ScrollViewer>

        <!-- ACTION BUTTONS -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Lưu &amp; Thêm mới (Ctrl+Shift+S)" Width="190" Height="32" Margin="0,0,10,0" FontWeight="SemiBold" Click="BtnSaveAndNew_Click"/>
                <Button Content="Lưu phiếu (Ctrl+S)" Width="130" Height="32" Margin="0,0,10,0" Background="#FF1976D2" Foreground="White" FontWeight="Bold" Click="BtnAccept_Click"/>
                <Button Content="In phiếu (Ctrl+P)" Width="110" Height="32" Margin="0,0,10,0" Click="BtnPrint_Click"/>
                <Button Content="Đóng (Esc)" Width="90" Height="32" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>
