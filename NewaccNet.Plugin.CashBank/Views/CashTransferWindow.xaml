<dx:ThemedWindow x:Class="NewaccNet.Plugin.CashBank.Views.CashTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Chuyển tiền nội bộ (Quỹ - Ngân hàng) - NEWACCNET" 
        Height="450" Width="680" MinWidth="600" MinHeight="400" 
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header banner -->
            <RowDefinition Height="*"/>    <!-- Layout Form -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" Background="#FF1E3A8A" Padding="18,12">
            <StackPanel>
                <TextBlock Text="CHUYỂN TIỀN NỘI BỘ (QUỸ TIỀN MẶT &lt;-&gt; NGÂN HÀNG)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Rút tiền gửi về quỹ, nộp tiền mặt vào ngân hàng hoặc luân chuyển giữa các tài khoản ngân hàng" FontSize="11" Foreground="#93C5FD" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form controls -->
        <dxlc:LayoutControl Grid.Row="1" Orientation="Vertical" Padding="20,15">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="Số chứng từ:" Width="280">
                    <dxe:TextEdit x:Name="txtVoucherNo" FontWeight="SemiBold"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Ngày chứng từ:" Margin="15,0,0,0">
                    <dxe:DateEdit x:Name="dpVoucherDate"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Orientation="Horizontal" Margin="0,8,0,0">
                <dxlc:LayoutItem Label="Tài khoản nguồn (Có):" Width="280">
                    <dxe:ComboBoxEdit x:Name="cboSourceAccount" DisplayMember="FullDisplay" ValueMember="AccountId" EditValueChanged="Account_EditValueChanged"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Tài khoản đích (Nợ):" Margin="15,0,0,0">
                    <dxe:ComboBoxEdit x:Name="cboDestinationAccount" DisplayMember="FullDisplay" ValueMember="AccountId" EditValueChanged="Account_EditValueChanged"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <dxlc:LayoutItem Label="Số tiền chuyển:" Margin="0,8,0,0">
                <dxe:TextEdit x:Name="txtAmount" EditValue="0" 
                              MaskType="Numeric" Mask="n0" MaskUseAsDisplayFormat="True" 
                              FontWeight="Bold" FontSize="16" Foreground="#1E3A8A" EditValueChanged="TxtAmount_EditValueChanged"/>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Số tiền bằng chữ:" Margin="0,4,0,0">
                <TextBlock x:Name="lblAmountWords" Text="Không đồng" FontStyle="Italic" Foreground="#475569" FontSize="12" Margin="0,5,0,0"/>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Người thực hiện:" Margin="0,8,0,0">
                <dxe:TextEdit x:Name="txtPersonName"/>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Lý do / Diễn giải:" Margin="0,8,0,0">
                <dxe:TextEdit x:Name="txtDescription"/>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Ghi sổ cái:" Margin="0,8,0,0">
                <dxe:CheckEdit x:Name="chkBookflag" Content="Đã ghi sổ cái (Mặc định bỏ trống theo quy tắc ERP)" IsChecked="False"/>
            </dxlc:LayoutItem>
        </dxlc:LayoutControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Lưu phiếu" Width="120" Height="30" Margin="0,0,10,0" Background="#FF1976D2" Foreground="White" FontWeight="Bold" Click="BtnAccept_Click"/>
                <Button Content="Đóng" Width="90" Height="30" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>
